# 自動生成: `pipeline-map render`。pipeline-map.toml から作る。手で直さない。
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 40
  }
}
direction: right

classes: {
  s_rust: {
    style: {
      fill: "#E69F00"
      font-color: "#111111"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_nix: {
    style: {
      fill: "#56B4E9"
      font-color: "#111111"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_yaml: {
    style: {
      fill: "#009E73"
      font-color: "#FFFFFF"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_cloud_llm: {
    style: {
      fill: "#CC79A7"
      font-color: "#111111"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_external: {
    style: {
      fill: "#BBBBBB"
      font-color: "#111111"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_skill: {
    style: {
      fill: "#F0E442"
      font-color: "#111111"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_git: {
    style: {
      fill: "#0072B2"
      font-color: "#FFFFFF"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_herdr: {
    style: {
      fill: "#D55E00"
      font-color: "#FFFFFF"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_store: {
    style: {
      fill: "#FFFFFF"
      font-color: "#111111"
      font-size: 13
      stroke: "#333333"
      stroke-dash: 3
    }
  }
  e_deny: {
    style: {
      stroke: "#D55E00"
      font-color: "#D55E00"
      font-size: 11
      stroke-dash: 4
    }
  }
  e_context: {
    style: {
      stroke: "#0072B2"
      font-color: "#0072B2"
      font-size: 11
      stroke-dash: 2
    }
  }
  e_file: {
    style: {
      stroke: "#444444"
      font-color: "#444444"
      font-size: 11
    }
  }
  e_issue: {
    style: {
      stroke: "#009E73"
      font-color: "#009E73"
      font-size: 11
    }
  }
  e_pr: {
    style: {
      stroke: "#009E73"
      font-color: "#009E73"
      font-size: 11
      stroke-width: 3
    }
  }
  e_notify: {
    style: {
      stroke: "#888888"
      font-color: "#888888"
      font-size: 11
    }
  }
  e_invoke: {
    style: {
      stroke: "#000000"
      font-color: "#000000"
      font-size: 11
      stroke-width: 1
    }
  }
  lane: {
    style: {
      fill: "#F4F6F8"
      stroke: "#9AA5B1"
      font-size: 15
      bold: true
    }
  }
  session: {
    style: {
      fill: "#FBF3F8"
      stroke: "#B05A8E"
      font-size: 17
      bold: true
    }
  }
  plain: {
    style: {
      fill: "#FFFFFF"
      stroke: "#555555"
      font-size: 12
    }
  }
  invisible: {
    style: {
      stroke-width: 0
      fill: transparent
    }
  }
}

n_agent_session: "Agent session (Claude / Codex / Copilot)" {
  class: session
  l_session_start: "SessionStart" {
    class: lane
    n_session_wrapup_start: "session-wrapup-start" {
      class: s_rust
    }
    n_issue_index: "issue-index" {
      class: s_rust
    }
    n_daily_desk_reminder: "daily-desk-reminder" {
      class: s_rust
    }
    n_worklog: "worklog" {
      class: s_rust
    }
    n_esa_mirror_context: "esa-mirror-context" {
      class: s_rust
    }
    n_pr_gate_session_start: "pr-gate (start)" {
      class: s_rust
    }
    n_gpg_prewarm: "gpg-prewarm" {
      class: s_rust
    }
    n_worktree_base_sync: "worktree-base-sync" {
      class: s_rust
    }
  }
  l_plan_approval: "Plan approval" {
    class: lane
    n_new_tool_guard_record: "new-tool-guard (record)" {
      class: s_rust
    }
  }
  l_session_start -> l_plan_approval: {
    style.opacity: 0
  }
  l_tool_call: "Tool call" {
    class: lane
    n_hook_router_pre: "hook-router (pre)" {
      class: s_rust
    }
    n_hook_router_post: "hook-router (post)" {
      class: s_rust
    }
    n_git_worktree_allow: "git-worktree-allow" {
      class: s_rust
    }
    n_git_stash_guard: "git-stash-guard" {
      class: s_rust
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
    n_main_checkout_guard_pre: "main-checkout-guard (pre)" {
      class: s_rust
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
    n_worktree_create_guard: "worktree-create-guard" {
      class: s_rust
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
    n_new_tool_guard: "new-tool-guard" {
      class: s_rust
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
    n_bleep: "bleep" {
      class: s_external
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
    n_external_send_guard: "external-send-guard" {
      class: s_rust
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
    n_attribution_guard: "attribution-guard" {
      class: s_rust
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
    n_pr_title_guard: "pr-title-guard" {
      class: s_rust
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
    n_pr_followup_guard: "pr-followup-guard" {
      class: s_rust
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
    n_decision_colocation_guard: "decision-colocation-guard" {
      class: s_rust
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
    n_stack_base_guard: "stack-base-guard" {
      class: s_rust
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
    n_gh_edit_allow_record: "gh-edit-allow (record)" {
      class: s_rust
    }
    n_gh_edit_allow_judge: "gh-edit-allow (judge)" {
      class: s_rust
    }
    n_adr_number: "adr-number" {
      class: s_rust
    }
  }
  l_plan_approval -> l_tool_call: {
    style.opacity: 0
  }
  l_stop: "Turn end / Stop" {
    class: lane
    n_pr_gate_stop: "pr-gate (stop)" {
      class: s_rust
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
    n_main_checkout_guard_stop: "main-checkout-guard (stop)" {
      class: s_rust
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
  }
  l_tool_call -> l_stop: {
    style.opacity: 0
  }
}

l_git_hook: "git hooks" {
  class: lane
  n_git_pre_commit: "pre-commit" {
    class: s_git
  }
  n_git_commit_msg: "commit-msg" {
    class: s_git
  }
  n_git_pre_push: "pre-push" {
    class: s_git
  }
  n_git_post_checkout: "post-checkout" {
    class: s_git
  }
}

l_ci: "CI (GitHub Actions)" {
  class: lane
  n_ci: "ci.yml" {
    class: s_yaml
  }
  n_darwin_build: "darwin-build.yml" {
    class: s_yaml
  }
  n_pr_title_check: "pr-title.yml" {
    class: s_yaml
  }
  n_close_linked_issues: "close-linked-issues.yml" {
    class: s_yaml
  }
}

l_manual: "Manual / skills" {
  class: lane
  n_codex_launcher: "codex launcher" {
    class: s_rust
    style.stroke-dash: 4
  }
  n_stacked_pr: "skill: stacked-pr" {
    class: s_skill
    shape: hexagon
    style.stroke-dash: 4
  }
  n_pr_description: "skill: pr-description" {
    class: s_skill
    shape: hexagon
    style.stroke-dash: 4
  }
  n_handoff: "skill: handoff" {
    class: s_skill
    shape: hexagon
    style.stroke-dash: 4
  }
}

l_external: "Sessions / services / state" {
  class: lane
  n_user: "You" {
    class: s_external
    style.stroke-dash: 4
  }
  n_github: "GitHub (Issues / PRs / rulesets / checks)" {
    class: s_external
    style.stroke-dash: 4
  }
}

n_agent_session.l_session_start.n_gpg_prewarm -> l_external.n_user: "pinentry once" {
  class: e_notify
}
n_agent_session.l_plan_approval.n_new_tool_guard_record -> n_agent_session.l_tool_call.n_new_tool_guard: "session ledger" {
  class: e_file
}
n_agent_session.l_tool_call.n_gh_edit_allow_record -> n_agent_session.l_tool_call.n_gh_edit_allow_judge: "session ledger" {
  class: e_file
}
n_agent_session -> l_external.n_github: "gh pr create" {
  class: e_pr
}
l_manual.n_stacked_pr -> n_agent_session.l_tool_call.n_stack_base_guard: "chain rule" {
  class: e_invoke
}
l_manual.n_pr_description -> n_agent_session.l_stop.n_pr_gate_stop: "link / visual" {
  class: e_invoke
}
l_manual.n_handoff -> n_agent_session.l_stop.n_pr_gate_stop: "Draft + Handoff" {
  class: e_invoke
}
l_manual.n_handoff -> n_agent_session.l_session_start.n_issue_index: "handoff:ai label" {
  class: e_context
}
l_git_hook.n_git_pre_commit -> n_agent_session: "commit on main" {
  class: e_deny
}
l_git_hook.n_git_pre_commit -> l_git_hook.n_git_commit_msg: "staged lines" {
  class: e_invoke
}
l_git_hook.n_git_commit_msg -> n_agent_session.l_tool_call.n_bleep: "scan-push on throwaway commit" {
  class: e_invoke
}
l_git_hook.n_git_commit_msg -> n_agent_session: "leak at commit" {
  class: e_deny
}
l_git_hook.n_git_pre_push -> n_agent_session.l_tool_call.n_bleep: "scan-push" {
  class: e_invoke
}
l_git_hook.n_git_pre_push -> n_agent_session: "leak / non-herdr" {
  class: e_deny
}
l_git_hook.n_git_post_checkout -> n_agent_session: "worktree setup" {
  class: e_file
}
l_external.n_github -> l_ci.n_ci: "PR event" {
  class: e_invoke
}
l_external.n_github -> l_ci.n_darwin_build: "PR event" {
  class: e_invoke
}
l_external.n_github -> l_ci.n_pr_title_check: "PR event" {
  class: e_invoke
}
l_external.n_github -> l_ci.n_close_linked_issues: "PR closed" {
  class: e_invoke
}
l_ci.n_ci -> l_external.n_github: "required checks" {
  class: e_notify
}
l_ci.n_darwin_build -> l_external.n_github: "advisory check" {
  class: e_notify
}
l_ci.n_pr_title_check -> l_external.n_github: "title check" {
  class: e_notify
}
l_ci.n_close_linked_issues -> l_external.n_github: "close Issues" {
  class: e_issue
}
l_external.n_github -> n_agent_session.l_stop.n_pr_gate_stop: "checks / rules" {
  class: e_context
}

legend: "Legend" {
  near: bottom-center
  class: lane
  grid-columns: 4
  grid-gap: 8
  lg_s_rust: "Rust crate" {
    class: s_rust
  }
  lg_s_yaml: "GitHub Actions workflow" {
    class: s_yaml
  }
  lg_s_cloud_llm: "LLM session / cloud" {
    class: s_cloud_llm
  }
  lg_s_external: "external tool / service" {
    class: s_external
  }
  lg_s_skill: "skill (LLM follows a procedure)" {
    class: s_skill
  }
  lg_s_git: "git hook" {
    class: s_git
  }
  lg_llm: "hexagon: an LLM takes part in the decision" {
    class: s_cloud_llm
    shape: hexagon
  }
  lg_deny_mark: "red thick border: can stop the agent's action" {
    class: s_rust
    style.stroke: "#D55E00"
    style.stroke-width: 4
  }
  lg_manual: "dashed border: not fired by itself (skill, CLI, service)" {
    class: s_external
    style.stroke-dash: 4
  }
  lg_e_deny: "edge deny: stops the action" {
    class: plain
    style.stroke: "#D55E00"
    style.font-color: "#D55E00"
    style.fill: "#FFFFFF"
    style.stroke-width: 3
    style.stroke-dash: 4
  }
  lg_e_context: "edge context: passes information" {
    class: plain
    style.stroke: "#0072B2"
    style.font-color: "#0072B2"
    style.fill: "#FFFFFF"
    style.stroke-width: 3
    style.stroke-dash: 2
  }
  lg_e_file: "edge file: writes a file or state" {
    class: plain
    style.stroke: "#444444"
    style.font-color: "#444444"
    style.fill: "#FFFFFF"
    style.stroke-width: 3
  }
  lg_e_issue: "edge issue: creates or closes an Issue" {
    class: plain
    style.stroke: "#009E73"
    style.font-color: "#009E73"
    style.fill: "#FFFFFF"
    style.stroke-width: 3
  }
  lg_e_pr: "edge pr: creates a PR" {
    class: plain
    style.stroke: "#009E73"
    style.font-color: "#009E73"
    style.fill: "#FFFFFF"
    style.stroke-width: 3
  }
  lg_e_notify: "edge notify: toast, display, check" {
    class: plain
    style.stroke: "#888888"
    style.font-color: "#888888"
    style.fill: "#FFFFFF"
    style.stroke-width: 3
  }
  lg_e_invoke: "edge invoke: calls or redirects to" {
    class: plain
    style.stroke: "#000000"
    style.font-color: "#000000"
    style.fill: "#FFFFFF"
    style.stroke-width: 3
  }
}

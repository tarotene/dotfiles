# 自動生成: `pipeline-map render`。pipeline-map.toml から作る。手で直さない。
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 40
  }
}
direction: right

classes: {
  s_rust: {
    style: {
      fill: "#E69F00"
      font-color: "#111111"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_nix: {
    style: {
      fill: "#56B4E9"
      font-color: "#111111"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_yaml: {
    style: {
      fill: "#009E73"
      font-color: "#FFFFFF"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_cloud_llm: {
    style: {
      fill: "#CC79A7"
      font-color: "#111111"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_external: {
    style: {
      fill: "#BBBBBB"
      font-color: "#111111"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_skill: {
    style: {
      fill: "#F0E442"
      font-color: "#111111"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_git: {
    style: {
      fill: "#0072B2"
      font-color: "#FFFFFF"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_herdr: {
    style: {
      fill: "#D55E00"
      font-color: "#FFFFFF"
      font-size: 13
      stroke: "#333333"
    }
  }
  s_store: {
    style: {
      fill: "#FFFFFF"
      font-color: "#111111"
      font-size: 13
      stroke: "#333333"
      stroke-dash: 3
    }
  }
  e_deny: {
    style: {
      stroke: "#D55E00"
      font-color: "#D55E00"
      font-size: 11
      stroke-dash: 4
    }
  }
  e_context: {
    style: {
      stroke: "#0072B2"
      font-color: "#0072B2"
      font-size: 11
      stroke-dash: 2
    }
  }
  e_file: {
    style: {
      stroke: "#444444"
      font-color: "#444444"
      font-size: 11
    }
  }
  e_issue: {
    style: {
      stroke: "#009E73"
      font-color: "#009E73"
      font-size: 11
    }
  }
  e_pr: {
    style: {
      stroke: "#009E73"
      font-color: "#009E73"
      font-size: 11
      stroke-width: 3
    }
  }
  e_notify: {
    style: {
      stroke: "#888888"
      font-color: "#888888"
      font-size: 11
    }
  }
  e_invoke: {
    style: {
      stroke: "#000000"
      font-color: "#000000"
      font-size: 11
      stroke-width: 1
    }
  }
  lane: {
    style: {
      fill: "#F4F6F8"
      stroke: "#9AA5B1"
      font-size: 15
      bold: true
    }
  }
  session: {
    style: {
      fill: "#FBF3F8"
      stroke: "#B05A8E"
      font-size: 17
      bold: true
    }
  }
  plain: {
    style: {
      fill: "#FFFFFF"
      stroke: "#555555"
      font-size: 12
    }
  }
  invisible: {
    style: {
      stroke-width: 0
      fill: transparent
    }
  }
}

n_agent_session: "Agent session (Claude / Codex / Copilot)" {
  class: session
  l_tool_call: "Tool call" {
    class: lane
    n_repo_create_guard: "repo-create-guard" {
      class: s_rust
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
    n_rulesets_write_guard: "rulesets-write-guard" {
      class: s_rust
      style.stroke: "#D55E00"
      style.stroke-width: 4
    }
  }
}

l_ci: "CI (GitHub Actions)" {
  class: lane
  n_ci: "ci.yml" {
    class: s_yaml
  }
  n_pr_title_check: "pr-title.yml" {
    class: s_yaml
  }
  n_kiriban: "kiriban.yml" {
    class: s_yaml
  }
  n_bleep_pin_freshness: "bleep-pin-freshness.yml" {
    class: s_yaml
  }
  n_renovate_runner: "renovate-runner.yml" {
    class: s_yaml
  }
}

l_manual: "Manual / skills" {
  class: lane
  n_repo_charter: "skill: repo-charter" {
    class: s_skill
    shape: hexagon
    style.stroke-dash: 4
  }
  n_github_audit_triage: "skill: github-audit-triage" {
    class: s_skill
    shape: hexagon
    style.stroke-dash: 4
  }
  n_github_audit: "github-audit" {
    class: s_rust
    style.stroke-dash: 4
  }
  n_apply_rulesets: "apply-rulesets" {
    class: s_rust
    style.stroke-dash: 4
  }
}

l_external: "Sessions / services / state" {
  class: lane
  n_github: "GitHub (Issues / PRs / rulesets / checks)" {
    class: s_external
    style.stroke-dash: 4
  }
}

l_external.n_github -> l_ci.n_pr_title_check: "PR event" {
  class: e_invoke
}
l_external.n_github -> l_ci.n_kiriban: "Issue / PR opened" {
  class: e_invoke
}
l_ci.n_ci -> l_external.n_github: "required checks" {
  class: e_notify
}
l_ci.n_pr_title_check -> l_external.n_github: "title check" {
  class: e_notify
}
l_ci.n_kiriban -> l_external.n_github: "comment / label / request" {
  class: e_issue
}
l_external.n_github -> l_manual.n_github_audit: "REST / GraphQL" {
  class: e_context
}
l_manual.n_github_audit -> l_manual.n_github_audit_triage: "findings" {
  class: e_context
}
l_manual.n_github_audit_triage -> l_external.n_github: "fix PRs" {
  class: e_pr
}
l_manual.n_github_audit_triage -> l_manual.n_apply_rulesets: "ruleset fixes" {
  class: e_invoke
}
l_manual.n_apply_rulesets -> l_external.n_github: "ruleset PUT" {
  class: e_file
}
n_agent_session.l_tool_call.n_rulesets_write_guard -> l_manual.n_apply_rulesets: "redirects to" {
  class: e_invoke
}
n_agent_session.l_tool_call.n_repo_create_guard -> l_manual.n_repo_charter: "redirects to" {
  class: e_invoke
}
l_ci.n_bleep_pin_freshness -> l_external.n_github: "annotation" {
  class: e_notify
}

legend: "Legend" {
  near: bottom-center
  class: lane
  grid-columns: 4
  grid-gap: 8
  lg_s_rust: "Rust crate" {
    class: s_rust
  }
  lg_s_yaml: "GitHub Actions workflow" {
    class: s_yaml
  }
  lg_s_cloud_llm: "LLM session / cloud" {
    class: s_cloud_llm
  }
  lg_s_external: "external tool / service" {
    class: s_external
  }
  lg_s_skill: "skill (LLM follows a procedure)" {
    class: s_skill
  }
  lg_llm: "hexagon: an LLM takes part in the decision" {
    class: s_cloud_llm
    shape: hexagon
  }
  lg_deny_mark: "red thick border: can stop the agent's action" {
    class: s_rust
    style.stroke: "#D55E00"
    style.stroke-width: 4
  }
  lg_manual: "dashed border: not fired by itself (skill, CLI, service)" {
    class: s_external
    style.stroke-dash: 4
  }
  lg_e_context: "edge context: passes information" {
    class: plain
    style.stroke: "#0072B2"
    style.font-color: "#0072B2"
    style.fill: "#FFFFFF"
    style.stroke-width: 3
    style.stroke-dash: 2
  }
  lg_e_file: "edge file: writes a file or state" {
    class: plain
    style.stroke: "#444444"
    style.font-color: "#444444"
    style.fill: "#FFFFFF"
    style.stroke-width: 3
  }
  lg_e_issue: "edge issue: creates or closes an Issue" {
    class: plain
    style.stroke: "#009E73"
    style.font-color: "#009E73"
    style.fill: "#FFFFFF"
    style.stroke-width: 3
  }
  lg_e_pr: "edge pr: creates a PR" {
    class: plain
    style.stroke: "#009E73"
    style.font-color: "#009E73"
    style.fill: "#FFFFFF"
    style.stroke-width: 3
  }
  lg_e_notify: "edge notify: toast, display, check" {
    class: plain
    style.stroke: "#888888"
    style.font-color: "#888888"
    style.fill: "#FFFFFF"
    style.stroke-width: 3
  }
  lg_e_invoke: "edge invoke: calls or redirects to" {
    class: plain
    style.stroke: "#000000"
    style.font-color: "#000000"
    style.fill: "#FFFFFF"
    style.stroke-width: 3
  }
}

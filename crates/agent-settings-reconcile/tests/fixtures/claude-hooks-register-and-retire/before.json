{
  "model": "opus",
  "env": {
    "A": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "herdr-agent-state.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "old-cmd"
          },
          {
            "type": "command",
            "command": "foreign"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "old-cmd"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ls)"
    ]
  }
}

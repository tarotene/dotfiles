[
 [
  "copilot-hooks-spec",
  {
   "retire": [
    {
     "event": "sessionEnd",
     "command": "clear-cmd"
    }
   ]
  }
 ],
 [
  "copilot-hooks-spec",
  {
   "retire": [
    {
     "event": "agentStop",
     "command": "report-cmd"
    }
   ],
   "register": [
    {
     "event": "sessionStart",
     "command": "new-report-cmd",
     "timeout": 10
    }
   ]
  }
 ]
]

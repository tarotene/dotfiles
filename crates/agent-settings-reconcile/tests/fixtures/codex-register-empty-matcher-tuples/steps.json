[
 [
  "codex-hooks-spec",
  {
   "register": [
    {
     "event": "SessionStart",
     "command": "report-cmd",
     "timeout": 10
    },
    {
     "event": "UserPromptSubmit",
     "command": "report-cmd",
     "timeout": 10
    },
    {
     "event": "Stop",
     "command": "report-cmd",
     "timeout": 10
    },
    {
     "event": "SessionEnd",
     "command": "clear-cmd",
     "timeout": 10
    }
   ]
  }
 ]
]

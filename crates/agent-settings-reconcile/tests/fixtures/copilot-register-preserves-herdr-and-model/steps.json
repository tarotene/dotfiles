[
 [
  "copilot-hooks-spec",
  {
   "register": [
    {
     "event": "sessionStart",
     "command": "report-cmd",
     "timeout": 10
    },
    {
     "event": "userPromptSubmitted",
     "command": "report-cmd",
     "timeout": 10
    },
    {
     "event": "agentStop",
     "command": "report-cmd",
     "timeout": 10
    },
    {
     "event": "sessionEnd",
     "command": "clear-cmd",
     "timeout": 10
    }
   ]
  }
 ]
]

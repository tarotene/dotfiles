#!/usr/bin/env bash
# github-rulesets-apply — apply the declared rulesets
# (.github/rulesets/{security,quality,workflow}[,review].json) of one or
# more repositories, by driving scripts/apply-rulesets.sh for each.
#
# ADR-0000-rulesets-declaration-in-repo(段3で改番)以前は、対象リポジトリの
# 「型」(rust/typst/astro/core/dotfiles)を引数に取り、型ごとに別の
# apply-rulesets.sh(*-repo-governance skill 側、プレースホルダ置換入り)
# を呼び分ける 5 型構成だった。正本を対象リポジトリ自身の
# `.github/rulesets/*.json` に一本化した結果、型を問わず同じ
# scripts/apply-rulesets.sh を呼べば足りる(D4「還元」)。
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF_APPLY_SCRIPT="${GITHUB_RULESETS_APPLY_SELF_SCRIPT:-$SCRIPT_DIR/apply-rulesets.sh}"

usage() {
  cat <<'EOF'
usage: github-rulesets-apply [--ref REF] [--reconcile] [--dry-run]
                              [--unverified-contexts] <owner/repo>...
                              [-- <passthrough args>]
       github-rulesets-apply --selftest

対象リポジトリごとに scripts/apply-rulesets.sh <owner/repo> を呼び、その
リポジトリ自身の .github/rulesets/*.json 宣言を live な branch ruleset に
適用する。

--ref/--reconcile/--dry-run/--unverified-contexts は全 repo に共通で渡す。
`--` 以降は apply-rulesets.sh へそのまま渡す(例: `-- --verify-sha <sha>`)。

失敗した repo があっても他の repo の適用は続け、最後にまとめて報告する
(1 つの失敗が全体を止めない)。呼び出し自体が不正な場合、または失敗した
repo が 1 つでもあれば exit 1。
EOF
}

apply_one() {
  local owner_repo="$1"
  shift
  local -a args=("$owner_repo" "$@")

  if [[ ! -x "$SELF_APPLY_SCRIPT" ]]; then
    echo "ERROR: $SELF_APPLY_SCRIPT not found or not executable (home-manager 未配備の可能性)" >&2
    return 1
  fi

  bash "$SELF_APPLY_SCRIPT" "${args[@]}"
}

main() {
  local ref='' reconcile=0 dry_run=0 unverified=0 owner_repo_arg_seen=0
  local -a repos=() passthrough=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ref) ref="$2"; shift 2 ;;
      --reconcile) reconcile=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      --unverified-contexts) unverified=1; shift ;;
      --) shift; passthrough=("$@"); break ;;
      -*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
      *)
        [[ "$1" == */* ]] || { echo "ERROR: '$1' is not owner/repo" >&2; exit 2; }
        repos+=("$1")
        owner_repo_arg_seen=1
        shift
        ;;
    esac
  done

  ((owner_repo_arg_seen)) || { echo "ERROR: at least one owner/repo is required" >&2; usage >&2; exit 2; }

  local -a common_args=()
  [[ -n "$ref" ]] && common_args+=(--ref "$ref")
  ((reconcile)) && common_args+=(--reconcile)
  ((dry_run)) && common_args+=(--dry-run)
  ((unverified)) && common_args+=(--unverified-contexts)

  local -a failed=()
  local r
  for r in "${repos[@]}"; do
    if ! apply_one "$r" "${common_args[@]}" "${passthrough[@]}"; then
      failed+=("$r")
    fi
  done

  if ((${#failed[@]} > 0)); then
    echo "" >&2
    echo "FAILED (${#failed[@]}):" >&2
    printf '  %s\n' "${failed[@]}" >&2
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# selftest — no network, stubs apply-rulesets.sh to record how it was called.
# ---------------------------------------------------------------------------

SELFTEST_TMP=""
cleanup_selftest() { [[ -n ${SELFTEST_TMP:-} ]] && rm -rf "$SELFTEST_TMP"; }

selftest() {
  local fails=0 tmp
  SELFTEST_TMP="$(mktemp -d)"
  trap cleanup_selftest EXIT
  tmp="$SELFTEST_TMP"

  cat >"$tmp/self-apply-rulesets.sh" <<'EOF'
#!/usr/bin/env bash
if [[ -n "${STUB_FAIL_REPO:-}" && "$1" == "$STUB_FAIL_REPO" ]]; then
  printf 'CALLED SELF(fail): %s\n' "$*" >>"$STUB_LOG"
  exit 1
fi
printf 'CALLED SELF: %s\n' "$*" >>"$STUB_LOG"
EOF
  chmod +x "$tmp/self-apply-rulesets.sh"
  export GITHUB_RULESETS_APPLY_SELF_SCRIPT="$tmp/self-apply-rulesets.sh"
  export STUB_LOG="$tmp/calls.log"

  expect_contains() { # $1=ラベル $2=期待する部分文字列
    grep -qF -- "$2" "$STUB_LOG" 2>/dev/null || {
      echo "FAIL($1): ログに含まれない: $2" >&2
      echo "  --- log ---" >&2
      cat "$STUB_LOG" 2>/dev/null >&2 || echo "  (empty)" >&2
      fails=$((fails + 1))
    }
  }
  expect_fail() { # $1=ラベル $2..=コマンド
    local label="$1"
    shift
    if "$SELF" "$@" >/dev/null 2>&1; then
      echo "FAIL($label: 失敗を期待したが成功した): $*" >&2
      fails=$((fails + 1))
    fi
  }

  # 1: 単一 repo
  : >"$STUB_LOG"
  "$SELF" tarotene/example-repo >/dev/null
  expect_contains "1 単一 repo" "CALLED SELF: tarotene/example-repo"

  # 2: 複数 repo で複数回呼ばれる
  : >"$STUB_LOG"
  "$SELF" tarotene/a tarotene/b tarotene/c >/dev/null
  expect_contains "2 repo a" "CALLED SELF: tarotene/a"
  expect_contains "2 repo b" "CALLED SELF: tarotene/b"
  expect_contains "2 repo c" "CALLED SELF: tarotene/c"
  if [[ "$(wc -l <"$STUB_LOG")" -ne 3 ]]; then
    echo "FAIL(2 呼び出し回数): 期待=3 実際=$(wc -l <"$STUB_LOG")" >&2
    fails=$((fails + 1))
  fi

  # 3: --ref/--reconcile/--dry-run/--unverified-contexts の透過
  : >"$STUB_LOG"
  "$SELF" --ref feat --reconcile --dry-run --unverified-contexts tarotene/example-repo >/dev/null
  expect_contains "3 --ref" "--ref feat"
  expect_contains "3 --reconcile" "--reconcile"
  expect_contains "3 --dry-run" "--dry-run"
  expect_contains "3 --unverified-contexts" "--unverified-contexts"

  # 4: -- 以降の passthrough
  : >"$STUB_LOG"
  "$SELF" tarotene/example-repo -- --verify-sha deadbeef >/dev/null
  expect_contains "4 -- passthrough" "--verify-sha deadbeef"

  # 5: エラー系
  expect_fail "5 owner/repo 形式違反" example-repo
  expect_fail "5 repo 引数無し"

  # 6: 1 repo が失敗しても他は呼ばれ、全体は exit 1
  : >"$STUB_LOG"
  STUB_FAIL_REPO="tarotene/b" "$SELF" tarotene/a tarotene/b tarotene/c >/dev/null 2>&1 && {
    echo "FAIL(6 1repo失敗で全体成功した)" >&2
    fails=$((fails + 1))
  }
  expect_contains "6 a は呼ばれる" "CALLED SELF: tarotene/a"
  expect_contains "6 b は失敗として呼ばれる" "CALLED SELF(fail): tarotene/b"
  expect_contains "6 c も呼ばれる" "CALLED SELF: tarotene/c"

  if ((fails > 0)); then
    echo "selftest: ${fails} 件失敗" >&2
    exit 1
  fi
  echo "selftest: OK"
}

SELF="$(realpath "$0")"

case "${1-}" in
  --selftest) selftest ;;
  --help | -h) usage ;;
  *) main "$@" ;;
esac

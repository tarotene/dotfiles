    {"type": "copilot_code_review"},
    {"type": "pull_request", "parameters": {"required_review_thread_resolution": true, "allowed_merge_methods": ["squash"]}}
  ]
}
EOF

  local other_repo
  for other_repo in all-drifted pj-ambiguous not-pj-prefixed no-renovate-target exempted .github; do
    printf '[]' >"$tmp/fixtures/repos_tarotene_${other_repo}_rulesets.json"
  done

  cat >"$tmp/fixtures/graphql-response.json" <<'EOF'
{
  "data": {
    "r1": {

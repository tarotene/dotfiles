  jq -e '.[] | select(.repo=="no-renovate-target") | .domains.renovate.verdict == "not-applicable"' <<<"$out" >/dev/null || {
    printf 'FAIL: no-renovate-target renovate should be not-applicable\n' >&2
    return 1
  }

  # charters domain
  jq -e '.[] | select(.repo=="all-ok") | .domains.charters.verdict == "ok"' <<<"$out" >/dev/null || {
    printf 'FAIL: all-ok charters should be ok: %s\n' "$(jq -c '.[] | select(.repo=="all-ok") | .domains.charters' <<<"$out")" >&2
    return 1
  }
  jq -e '.[] | select(.repo=="all-drifted") | .domains.charters.missing | index("readme-missing")' <<<"$out" >/dev/null || {
    printf 'FAIL: all-drifted charters should flag readme-missing\n' >&2
    return 1
  }
  jq -e '.[] | select(.repo=="all-drifted") | .domains.charters.missing | index("contributing-missing")' <<<"$out" >/dev/null || {
    printf 'FAIL: all-drifted charters should flag contributing-missing\n' >&2
    return 1
  }
  jq -e '.[] | select(.repo=="all-drifted") | .domains.charters.missing | index("root-doc-not-allowlisted:CONTEXT.md")' <<<"$out" >/dev/null || {
    printf 'FAIL: all-drifted charters should flag CONTEXT.md as a stray root doc\n' >&2
    return 1
  }
  jq -e '.[] | select(.repo=="all-drifted") | .domains.charters.missing | index("claude-md-not-routed")' <<<"$out" >/dev/null || {
    printf 'FAIL: all-drifted charters should flag claude-md-not-routed\n' >&2
    return 1
  }
  jq -e '.[] | select(.repo=="all-drifted") | .domains.charters.missing | index("skills-not-routed:bar")' <<<"$out" >/dev/null || {
    printf 'FAIL: all-drifted charters should flag skills-not-routed:bar\n' >&2
    return 1
  }
  # Regression (ADR-0017): pj-ambiguous's CONTRIBUTING.md fixture still
  # carries the retired "## Issue litmus" heading instead of "## Issues" —
  # confirm it is caught as an out-of-schema stray heading, not silently
  # accepted the way the pre-ADR-0017 grep-for-litmus check would have.
  jq -e '.[] | select(.repo=="pj-ambiguous") | .domains.charters.missing | index("contributing-stray-heading:Issue litmus")' <<<"$out" >/dev/null || {
    printf 'FAIL: pj-ambiguous charters should flag the retired Issue litmus heading as stray\n' >&2
    return 1
  }
  jq -e '.[] | select(.repo=="pj-ambiguous") | .domains.charters.missing | index("contributing-schema-incomplete-or-out-of-order")' <<<"$out" >/dev/null || {
    printf 'FAIL: pj-ambiguous charters should flag missing Issues/Pull requests headings\n' >&2
    return 1
  }

  # nav-doc domain (ADR-0033): README/CONTRIBUTING/AGENTS.md/CLAUDE.md must
  # not materialise trees, inventories, or transcribed file contents.
  #
  # all-ok's AGENTS.md Background section carries a *used* path-inventory
  # exemption (four backtick-quoted legacy filenames that would otherwise
  # meet the threshold) — this repo staying verdict=ok already proves both
  # that the exemption suppresses the finding AND that it is not
  # mis-flagged as unused (either bug would flip all-ok to drifted).
  jq -e '.[] | select(.repo=="all-ok") | .domains.charters.verdict == "ok"' <<<"$out" >/dev/null || {
    printf 'FAIL: all-ok charters should stay ok with a correctly-used nav-doc-exempt marker: %s\n' "$(jq -c '.[] | select(.repo=="all-ok") | .domains.charters' <<<"$out")" >&2
    return 1
  }

  # all-drifted's CLAUDE.md has an un-exempted four-path comment-style
  # listing (no box-drawing characters) under "## Structure" — the
  # plain-inventory case, not the tree-fence case.
  jq -e '.[] | select(.repo=="all-drifted") | .domains.charters.missing | index("nav-doc-path-inventory:CLAUDE.md:Structure:4")' <<<"$out" >/dev/null || {
    printf 'FAIL: all-drifted charters should flag CLAUDE.md Structure as a path inventory: %s\n' "$(jq -c '.[] | select(.repo=="all-drifted") | .domains.charters.missing' <<<"$out")" >&2
    return 1
  }

  # no-renovate-target's README has an un-exempted box-drawing tree fence
  # under "## Background" (the tree-fence case), a second fence guarded by
  # a tree-fence exemption that turns out not to contain any tree
  # characters (the exemption is pointless — nav-doc-exempt-unused), and a
  # two-path mention under "## Scope" that must NOT drift (below
  # threshold). Its CLAUDE.md carries a marker missing the "— reason" half
  # (nav-doc-exempt-malformed).
  jq -e '.[] | select(.repo=="no-renovate-target") | .domains.charters.missing | index("nav-doc-tree-fence:README.md")' <<<"$out" >/dev/null || {
    printf 'FAIL: no-renovate-target charters should flag the un-exempted README tree fence: %s\n' "$(jq -c '.[] | select(.repo=="no-renovate-target") | .domains.charters.missing' <<<"$out")" >&2
    return 1
  }
  jq -e '.[] | select(.repo=="no-renovate-target") | .domains.charters.missing | index("nav-doc-exempt-unused:README.md:tree-fence")' <<<"$out" >/dev/null || {
    printf 'FAIL: no-renovate-target charters should flag the pointless tree-fence exemption as unused: %s\n' "$(jq -c '.[] | select(.repo=="no-renovate-target") | .domains.charters.missing' <<<"$out")" >&2
    return 1
  }
  jq -e '.[] | select(.repo=="no-renovate-target") | (.domains.charters.missing | map(select(startswith("nav-doc-path-inventory:README.md:Scope")))) == []' <<<"$out" >/dev/null || {
    printf 'FAIL: no-renovate-target charters should NOT flag a legitimate two-path Scope mention: %s\n' "$(jq -c '.[] | select(.repo=="no-renovate-target") | .domains.charters.missing' <<<"$out")" >&2
    return 1
  }
  jq -e '.[] | select(.repo=="no-renovate-target") | .domains.charters.missing | index("nav-doc-exempt-malformed:CLAUDE.md")' <<<"$out" >/dev/null || {
    printf 'FAIL: no-renovate-target charters should flag the reason-less CLAUDE.md exemption marker as malformed: %s\n' "$(jq -c '.[] | select(.repo=="no-renovate-target") | .domains.charters.missing' <<<"$out")" >&2
    return 1
  }

  # rulesets domain (ADR-0021: review layer addin)
  jq -e '.[] | select(.repo=="all-ok") | .domains.rulesets.review_layer == "complete"' <<<"$out" >/dev/null || {
    printf 'FAIL: all-ok rulesets should be review_layer=complete\n' >&2
    return 1
  }
  jq -e '.[] | select(.repo=="rulesets-core-only") | .domains.rulesets.verdict == "ok" and .domains.rulesets.review_layer == "absent"' <<<"$out" >/dev/null || {
    printf 'FAIL: rulesets-core-only should be ok with review_layer=absent\n' >&2
    return 1
  }
  jq -e '.[] | select(.repo=="rulesets-partial-review") | .domains.rulesets.verdict == "drifted" and .domains.rulesets.review_layer == "partial-drift"' <<<"$out" >/dev/null || {
    printf 'FAIL: rulesets-partial-review should be drifted with review_layer=partial-drift\n' >&2
    return 1
  }
  jq -e '.[] | select(.repo=="rulesets-partial-review") | .domains.rulesets.missing | index("review_layer.required_review_thread_resolution")' <<<"$out" >/dev/null || {
    printf 'FAIL: rulesets-partial-review should flag review_layer.required_review_thread_resolution\n' >&2
    return 1
  }
  jq -e '.[] | select(.repo=="rulesets-partial-review") | .domains.rulesets.missing | index("review_layer.copilot_code_review") | not' <<<"$out" >/dev/null || {
    printf 'FAIL: rulesets-partial-review already has copilot_code_review — should not flag it missing\n' >&2
    return 1
  }

  # rulesets domain (ADR-0021: aggregation across TWO active rulesets, not
  # just multiple pull_request rules on one — the shape Stage 2 produces)
  jq -e '.[] | select(.repo=="rulesets-review-split") | .domains.rulesets.verdict == "ok" and .domains.rulesets.review_layer == "complete" and (.domains.rulesets.missing | length == 0)' <<<"$out" >/dev/null || {
    printf 'FAIL: rulesets-review-split should be ok/complete with no missing (cross-ruleset OR + intersection): %s\n' "$(jq -c '.[] | select(.repo=="rulesets-review-split") | .domains.rulesets' <<<"$out")" >&2
    return 1
  }
  jq -e '.[] | select(.repo=="rulesets-squash-conflict") | .domains.rulesets.verdict == "drifted" and (.domains.rulesets.missing | index("pull_request.allowed_merge_methods"))' <<<"$out" >/dev/null || {
    printf 'FAIL: rulesets-squash-conflict should flag pull_request.allowed_merge_methods (empty cross-ruleset intersection): %s\n' "$(jq -c '.[] | select(.repo=="rulesets-squash-conflict") | .domains.rulesets' <<<"$out")" >&2
    return 1
  }
  # #349: two DISTINCT active rulesets (ids 8/9) both carry pull_request and
  # review_layer is absent here — the legitimate "review layer split across
  # two rulesets" exception (ADR-0021, review_layer=complete) does not apply,
  # so this must be flagged as a genuine layout duplicate (dotfiles' own
  # real-world "Ephemeral Initial" + "Workflow" both holding pull_request).
  jq -e '.[] | select(.repo=="rulesets-squash-conflict") | .domains.rulesets.missing | map(select(startswith("duplicate-ruleset:pull_request:"))) | length == 1' <<<"$out" >/dev/null || {
    printf 'FAIL: rulesets-squash-conflict should flag duplicate-ruleset:pull_request (2 distinct rulesets, review_layer=absent): %s\n' "$(jq -c '.[] | select(.repo=="rulesets-squash-conflict") | .domains.rulesets.missing' <<<"$out")" >&2
    return 1
  }
  # ...but the legitimate review-layer split (rulesets-review-split, both
  # halves complete) must NOT be flagged as a duplicate — already covered by
  # the "missing | length == 0" assertion above, restated explicitly here so
  # a future regression is unambiguous about which invariant broke.
  jq -e '.[] | select(.repo=="rulesets-review-split") | .domains.rulesets.missing | map(select(startswith("duplicate-ruleset:"))) | length == 0' <<<"$out" >/dev/null || {
    printf 'FAIL: rulesets-review-split must not flag duplicate-ruleset (legitimate core+review pull_request split): %s\n' "$(jq -c '.[] | select(.repo=="rulesets-review-split") | .domains.rulesets.missing' <<<"$out")" >&2
    return 1
  }
  jq -e '.[] | select(.repo=="rulesets-squash-conflict") | .domains.rulesets.review_layer == "absent"' <<<"$out" >/dev/null || {
    printf 'FAIL: rulesets-squash-conflict should be review_layer=absent (neither half opted in)\n' >&2
    return 1
  }

  # exempt short-circuit
  jq -e '.[] | select(.repo=="exempted") | [.domains[].verdict] | all(. == "exempt")' <<<"$out" >/dev/null || {
    printf 'FAIL: exempted repo should be exempt in every domain\n' >&2
    return 1
  }

  # overrides を空にすると、exempted も自前の drift(README fixture すら無い
  # ので readme-missing、topics も無いので class-undeclared)で判定される
  # ことを確認する — override が短絡しているだけで、たまたま同じ結果
  # だったわけではないことの回帰。
  : >"$tmp/config/overrides.tsv"
  out="$("$SELF" --json 2>&1)" || true
  jq -e '.[] | select(.repo=="exempted") | .domains.charters.verdict == "drifted" and (.domains.charters.missing | index("readme-missing"))' <<<"$out" >/dev/null || {
    printf 'FAIL: override 解除後に exempted が readme-missing で drift しなかった\n' >&2
    return 1
  }
  jq -e '.[] | select(.repo=="exempted") | .domains.naming.verdict == "drifted" and (.domains.naming.missing | index("class-undeclared"))' <<<"$out" >/dev/null || {
    printf 'FAIL: override 解除後に exempted が class-undeclared で drift しなかった\n' >&2
    return 1
  }
  printf 'exempted\t*\texempt\n' >"$tmp/config/overrides.tsv"

  # ledger + human report
  [[ -f "$tmp/state/ledger.json" ]] || {
    printf 'FAIL: ledger.json が書かれなかった\n' >&2
    return 1
  }
  jq -e '.repos | length == 11' "$tmp/state/ledger.json" >/dev/null || {
    printf 'FAIL: ledger.json の repos 件数が一致しない\n' >&2
    return 1
  }

  out="$("$SELF" 2>&1)" && {
    printf 'FAIL: drift が存在するのに exit 0 だった\n' >&2
    return 1
  }
  grep -qF 'repo=all-ok' <<<"$out" || {
    printf 'FAIL: 人間可読レポートに all-ok が含まれない\n' >&2
    return 1
  }

  # rulesets domain isolated: only requested domain runs judge_rulesets
  out="$("$SELF" --json rulesets 2>&1)" || true
  jq -e '.[] | select(.repo=="all-ok") | .domains.rulesets.verdict == "ok"' <<<"$out" >/dev/null || {
    printf 'FAIL: rulesets-only run should still judge all-ok as ok\n' >&2
    return 1
  }
  jq -e '.[] | select(.repo=="all-ok") | (.domains | keys) == ["rulesets"]' <<<"$out" >/dev/null || {
    printf 'FAIL: rulesets-only run should not include other domains\n' >&2
    return 1
  }

  # ---------------------------------------------------------------------
  # ADR-0020: direct function-call checks. judge_rulesets()/judge_naming()
  # are plain functions in this same script, so they can be called
  # in-process instead of round-tripping through a "$SELF" subprocess —
  # this isolates each new branch precisely instead of needing a
  # combinatorial fixture repo per branch.
  # ---------------------------------------------------------------------

  # rulesets: CI-absence derivation (ci-absent vs required_status_checks)
  jq -e '.verdict == "drifted" and (.missing | index("ci-absent")) and (.missing | index("required_status_checks") | not)' \
    <<<"$(judge_rulesets ruleset-ci-test false)" >/dev/null || {
    printf 'FAIL: judge_rulesets(has_workflows=false) should report ci-absent, not required_status_checks\n' >&2
    return 1
  }
  jq -e '.verdict == "drifted" and (.missing | index("required_status_checks")) and (.missing | index("ci-absent") | not)' \
    <<<"$(judge_rulesets ruleset-ci-test true)" >/dev/null || {
    printf 'FAIL: judge_rulesets(has_workflows=true) should report required_status_checks, not ci-absent\n' >&2
    return 1
  }

  # renovate: flake.nix alone counts as a manifest (#3 — this repo itself
  # uses flake.nix/flake.lock, not Cargo.toml/package.json/pyproject.toml/
  # go.mod, and was previously silently not-applicable).
  jq -e '.verdict == "drifted" and (.missing | index("renovate-config-missing"))' \
    <<<"$(judge_renovate '{"flakeNix": {"id": "x"}, "workflowsDir": {"entries": [{"name": "ci.yml"}]}}')" >/dev/null || {
    printf 'FAIL: judge_renovate(flakeNix present, no other manifest) should be drifted, not not-applicable\n' >&2
    return 1
  }
  jq -e '.verdict == "ok"' \
    <<<"$(judge_renovate '{"flakeNix": {"id": "x"}, "workflowsDir": {"entries": [{"name": "ci.yml"}]}, "renovateJson": {"text": "{}"}, "renovateDashboard": {"totalCount": 1}}')" >/dev/null || {
    printf 'FAIL: judge_renovate(flakeNix present, renovate.json present, dashboard exists) should be ok\n' >&2
    return 1
  }

  # #465: renovate.json はあるのに Dependency Dashboard Issue が一度も
  # 作られていない(App の install 漏れ等によるサイレント失敗)場合は
  # drifted:renovate-dashboard-missing を報告する。
  jq -e '.verdict == "drifted" and (.missing | index("renovate-dashboard-missing"))' \
    <<<"$(judge_renovate '{"flakeNix": {"id": "x"}, "workflowsDir": {"entries": [{"name": "ci.yml"}]}, "renovateJson": {"text": "{}"}, "renovateDashboard": {"totalCount": 0}}')" >/dev/null || {
    printf 'FAIL: judge_renovate(renovate.json present, dashboard totalCount=0) should be renovate-dashboard-missing\n' >&2
    return 1
  }
  # renovateDashboard フィールド自体が無い(GraphQL 側の欠落)場合も
  # totalCount 0 と同じ扱いで drift 側に倒す(fail-safe デフォルト)。
  jq -e '.verdict == "drifted" and (.missing | index("renovate-dashboard-missing"))' \
    <<<"$(judge_renovate '{"flakeNix": {"id": "x"}, "workflowsDir": {"entries": [{"name": "ci.yml"}]}, "renovateJson": {"text": "{}"}}')" >/dev/null || {
    printf 'FAIL: judge_renovate(renovate.json present, renovateDashboard field missing) should be renovate-dashboard-missing\n' >&2
    return 1
  }
  # config が明示的に dependencyDashboard: false としているリポジトリは
  # Dashboard が無くて正常なので、drift にしない。
  jq -e '.verdict == "ok"' \
    <<<"$(judge_renovate '{"flakeNix": {"id": "x"}, "workflowsDir": {"entries": [{"name": "ci.yml"}]}, "renovateJson": {"text": "{\"dependencyDashboard\": false}"}, "renovateDashboard": {"totalCount": 0}}')" >/dev/null || {
    printf 'FAIL: judge_renovate(dependencyDashboard: false, no dashboard issue) should be ok\n' >&2
    return 1
  }
  # JSON5(コメント付き)等パース不能な config テキストでも Dashboard
  # totalCount が非0なら ok(dashboard_disabled の判定失敗をどちらに
  # 倒しても、Dashboard が実在するなら drift にならないことを確認)。
  jq -e '.verdict == "ok"' \
    <<<"$(judge_renovate '{"flakeNix": {"id": "x"}, "workflowsDir": {"entries": [{"name": "ci.yml"}]}, "renovateJson5": {"text": "{ // comment\n}"}, "renovateDashboard": {"totalCount": 1}}')" >/dev/null || {
    printf 'FAIL: judge_renovate(unparseable renovate.json5, dashboard exists) should be ok\n' >&2
    return 1
  }

  # naming: ADR-0020 closed vocabularies
  local species='["toolbox"]' registry='["regcode"]' domains='["known.site"]'
  local pre='2020-01-01T00:00:00Z' post='2027-01-01T00:00:00Z'

  jq -e '.verdict == "ok"' <<<"$(judge_naming foo-toolbox '["naming-descriptive"]' "$post" "$species" "$registry" "$domains")" >/dev/null || {
    printf 'FAIL: foo-toolbox (post-cutoff, species in closed set) should be naming ok\n' >&2
    return 1
  }
  jq -e '.missing | index("species-unrecognized:cleanup")' \
    <<<"$(judge_naming foo-cleanup '["naming-descriptive"]' "$post" "$species" "$registry" "$domains")" >/dev/null || {
    printf 'FAIL: foo-cleanup (post-cutoff, species not in closed set) should flag species-unrecognized\n' >&2
    return 1
  }
  jq -e '.verdict == "ok"' <<<"$(judge_naming foo-ancient '["naming-descriptive"]' "$pre" '[]' "$registry" "$domains")" >/dev/null || {
    printf 'FAIL: foo-ancient (pre-cutoff, empty species set) should grandfather to naming ok\n' >&2
    return 1
  }
  jq -e '.verdict == "ok"' <<<"$(judge_naming regcode '["naming-codename"]' "$pre" "$species" "$registry" "$domains")" >/dev/null || {
    printf 'FAIL: regcode (registered codename) should be naming ok\n' >&2
    return 1
  }
  jq -e '.missing | index("codename-not-registered")' \
    <<<"$(judge_naming roguecode '["naming-codename"]' "$pre" "$species" "$registry" "$domains")" >/dev/null || {
    printf 'FAIL: roguecode (unregistered codename, even pre-cutoff) should flag codename-not-registered\n' >&2
    return 1
  }
  jq -e '.verdict == "ok"' <<<"$(judge_naming known.site '["naming-site"]' "$post" "$species" "$registry" "$domains")" >/dev/null || {
    printf 'FAIL: known.site (post-cutoff, domain in closed set) should be naming ok\n' >&2
    return 1
  }
  jq -e '.missing | index("domain-unrecognized")' \
    <<<"$(judge_naming rogue.site '["naming-site"]' "$post" "$species" "$registry" "$domains")" >/dev/null || {
    printf 'FAIL: rogue.site (post-cutoff, domain not in closed set) should flag domain-unrecognized\n' >&2
    return 1
  }

  # ---------------------------------------------------------------------
  # #278 (ADR-0026): naming-coined class + lifecycle axis candidates.
  # ---------------------------------------------------------------------

  local lifespecies='["study","research"]'

  # naming-coined: same single-token pattern as naming-codename, but NO
  # closed-vocabulary check (that absence is the whole point of the split).
  jq -e '.verdict == "ok" and .class == "naming-coined"' \
    <<<"$(judge_naming somecoinage '["naming-coined"]' "$post" "$species" "$registry" "$domains" "$lifespecies" "" false)" >/dev/null || {
    printf 'FAIL: naming-coined (single-token, unregistered) should be ok, no registry check\n' >&2
    return 1
  }
  jq -e '.missing | index("pattern-mismatch:naming-coined")' \
    <<<"$(judge_naming some-coinage '["naming-coined"]' "$post" "$species" "$registry" "$domains" "$lifespecies" "" false)" >/dev/null || {
    printf 'FAIL: naming-coined with a hyphen (multi-token) should flag pattern-mismatch\n' >&2
    return 1
  }

  # lifecycle-study-candidate: description matches the closed vocabulary,
  # topic not yet declared. Works whether archived or not (ADR-0026 covers
  # both "進行中" and "完了済み").
  jq -e '.lifecycle_candidates | any(startswith("lifecycle-study-candidate:"))' \
    <<<"$(judge_naming foo-archive '["naming-descriptive"]' "$pre" "$species" "$registry" "$domains" "$lifespecies" "My graduate school study notes" false)" >/dev/null || {
    printf 'FAIL: description matching lifecycle-species vocabulary should surface lifecycle-study-candidate\n' >&2
    return 1
  }
  jq -e '.lifecycle_candidates | length == 0' \
    <<<"$(judge_naming foo-archive '["naming-descriptive"]' "$pre" "$species" "$registry" "$domains" "$lifespecies" "My graduate school study notes" false)" >/dev/null && {
    printf 'FAIL: (sanity inverse) matching description must produce a non-empty lifecycle_candidates\n' >&2
    return 1
  }
  # already declared → no duplicate candidate suggested
  jq -e '.lifecycle_candidates | any(startswith("lifecycle-study-candidate:")) | not' \
    <<<"$(judge_naming foo-archive '["naming-descriptive","lifecycle-study"]' "$pre" "$species" "$registry" "$domains" "$lifespecies" "My graduate school study notes" false)" >/dev/null || {
    printf 'FAIL: lifecycle-study already declared should not re-suggest the candidate\n' >&2
    return 1
  }
  # non-matching description → no candidate
  jq -e '.lifecycle_candidates | length == 0' \
    <<<"$(judge_naming plain-tool '["naming-descriptive"]' "$pre" "$species" "$registry" "$domains" "$lifespecies" "A CLI for managing widgets" false)" >/dev/null || {
    printf 'FAIL: non-matching description should not produce a lifecycle_candidates entry\n' >&2
    return 1
  }

  # lifecycle-timeboxed-candidate: naming-pj, not archived, topic not
  # declared yet → suggest adding.
  jq -e '.lifecycle_candidates | index("lifecycle-timeboxed-candidate")' \
    <<<"$(judge_naming pj-thing '["naming-pj"]' "$pre" "$species" "$registry" "$domains" "$lifespecies" "" false)" >/dev/null || {
    printf 'FAIL: live naming-pj repo without the topic should suggest lifecycle-timeboxed-candidate\n' >&2
    return 1
  }
  jq -e '.lifecycle_candidates | index("lifecycle-timeboxed-candidate") | not' \
    <<<"$(judge_naming pj-thing '["naming-pj","lifecycle-timeboxed"]' "$pre" "$species" "$registry" "$domains" "$lifespecies" "" false)" >/dev/null || {
    printf 'FAIL: naming-pj repo already carrying the topic should not re-suggest it\n' >&2
    return 1
  }

  # lifecycle-timeboxed-removal-candidate: topic declared, repo archived
  # → suggest removing (completion signal).
  jq -e '.lifecycle_candidates | index("lifecycle-timeboxed-removal-candidate")' \
    <<<"$(judge_naming pj-done '["naming-pj","lifecycle-timeboxed"]' "$pre" "$species" "$registry" "$domains" "$lifespecies" "" true)" >/dev/null || {
    printf 'FAIL: archived naming-pj repo carrying the topic should suggest removal\n' >&2
    return 1
  }
  jq -e '.lifecycle_candidates | index("lifecycle-timeboxed-removal-candidate") | not' \
    <<<"$(judge_naming pj-live '["naming-pj","lifecycle-timeboxed"]' "$pre" "$species" "$registry" "$domains" "$lifespecies" "" false)" >/dev/null || {
    printf 'FAIL: non-archived naming-pj repo carrying the topic should not suggest removal\n' >&2
    return 1
  }

  # ---------------------------------------------------------------------
  # #275: lifecycle domain (dormancy scoring). Direct function-call checks
  # with a fixed reference "now" for determinism (GITHUB_AUDIT_LIFECYCLE_NOW).
  # ---------------------------------------------------------------------

  export GITHUB_AUDIT_LIFECYCLE_NOW='2026-09-23T00:00:00Z'
  local gql_empty='{}'
  local gql_release_recent='{"latestRelease":{"nodes":[{"createdAt":"2026-08-01T00:00:00Z"}]}}'
  local gql_release_stale='{"latestRelease":{"nodes":[{"createdAt":"2025-01-01T00:00:00Z"}]}}'
  local gql_issue_recent='{"openIssueActivity":{"totalCount":1,"nodes":[{"updatedAt":"2026-09-01T00:00:00Z"}]}}'
  local gql_issue_stale='{"openIssueActivity":{"totalCount":1,"nodes":[{"updatedAt":"2026-01-01T00:00:00Z"}]}}'
  local gql_no_open_issues='{"openIssueActivity":{"totalCount":0,"nodes":[]}}'

  # 全シグナル健全 → ok、score=0
  jq -e '.verdict == "ok" and .score == 0 and (.missing | length == 0)' \
    <<<"$(judge_lifecycle repo-fresh '2026-09-20T00:00:00Z' true "$gql_release_recent" success)" >/dev/null || {
    printf 'FAIL: 全シグナル健全な repo は ok/score=0 になるべき: %s\n' \
      "$(judge_lifecycle repo-fresh '2026-09-20T00:00:00Z' true "$gql_release_recent" success)" >&2
    return 1
  }

  # push 停滞(400日)だけでは閾値(3)未満 → drift ではなく ok のまま、
  # ただし signal 自体は missing に載る(候補提示であって二値の drift ではない)
  jq -e '.verdict == "ok" and .score == 2 and (.missing | index("stale-push:400d"))' \
    <<<"$(judge_lifecycle repo-old-push '2025-08-19T00:00:00Z' true "$gql_release_recent" success)" >/dev/null || {
    printf 'FAIL: push 400日停滞は score=2/ok(閾値未満)になるべき: %s\n' \
      "$(judge_lifecycle repo-old-push '2025-08-19T00:00:00Z' true "$gql_release_recent" success)" >&2
    return 1
  }

  # push 停滞 + release 停滞 + issue 停滞 + CI absent が全て揃う → score>=閾値で dormancy-candidate
  jq -e '.verdict == "dormancy-candidate" and (.score >= 3)
    and (any(.missing[]; . == "stale-push:400d"))
    and (any(.missing[]; startswith("stale-release:")))
    and (any(.missing[]; startswith("stale-issues:")))
    and (any(.missing[]; . == "ci-absent"))' \
    <<<"$(judge_lifecycle repo-dormant '2025-08-19T00:00:00Z' false "$(jq -c '. + '"$gql_issue_stale"'' <<<"$gql_release_stale")" '')" >/dev/null || {
    printf 'FAIL: 全シグナル停滞は dormancy-candidate になるべき: %s\n' \
      "$(judge_lifecycle repo-dormant '2025-08-19T00:00:00Z' false "$(jq -c '. + '"$gql_issue_stale"'' <<<"$gql_release_stale")" '')" >&2
    return 1
  }

  # release が 1 件も無ければ release シグナルは計上しない(#275: 「あれば」の条件)
  jq -e '.missing | any(startswith("stale-release:")) | not' \
    <<<"$(judge_lifecycle repo-no-release '2026-09-20T00:00:00Z' true "$gql_empty" success)" >/dev/null || {
    printf 'FAIL: release 0件の repo は stale-release を計上してはいけない: %s\n' \
      "$(judge_lifecycle repo-no-release '2026-09-20T00:00:00Z' true "$gql_empty" success)" >&2
    return 1
  }

  # open issue が 0 件なら issue シグナルは計上しない
  jq -e '.missing | any(startswith("stale-issues:")) | not' \
    <<<"$(judge_lifecycle repo-no-issues '2026-09-20T00:00:00Z' true "$gql_no_open_issues" success)" >/dev/null || {
    printf 'FAIL: open issue 0件の repo は stale-issues を計上してはいけない: %s\n' \
      "$(judge_lifecycle repo-no-issues '2026-09-20T00:00:00Z' true "$gql_no_open_issues" success)" >&2
    return 1
  }

  # CI は有るが直近 run が failure → ci-failing(ci-absent ではない)
  jq -e '(.missing | index("ci-failing")) and (.missing | index("ci-absent") | not)' \
    <<<"$(judge_lifecycle repo-ci-fail '2026-09-20T00:00:00Z' true "$gql_release_recent" failure)" >/dev/null || {
    printf 'FAIL: CI failure は ci-failing のみ計上すべき: %s\n' \
      "$(judge_lifecycle repo-ci-fail '2026-09-20T00:00:00Z' true "$gql_release_recent" failure)" >&2
    return 1
  }
  unset GITHUB_AUDIT_LIFECYCLE_NOW

  # any_drift(): dormancy-candidate は drift として数えない
  local lifecycle_only_findings='[{"repo":"x","language":"-","visibility":"PUBLIC","domains":{"lifecycle":{"verdict":"dormancy-candidate","missing":["stale-push:400d"],"score":4}}}]'
  any_drift "$lifecycle_only_findings" || {
    printf 'FAIL: any_drift は dormancy-candidate のみの findings を drift と数えてはいけない\n' >&2
    return 1
  }
  local mixed_findings='[{"repo":"x","language":"-","visibility":"PUBLIC","domains":{"lifecycle":{"verdict":"dormancy-candidate","missing":[],"score":4},"charters":{"verdict":"drifted","missing":["readme-missing"]}}}]'
  any_drift "$mixed_findings" && {
    printf 'FAIL: any_drift は他ドメインの本物の drift は見逃してはいけない\n' >&2
    return 1
  }
  true

  # ---------------------------------------------------------------------
  # ADR-0031: settings domain extension (squash commit title/message) +
  # titles domain (presence-detection). Direct function-call checks, same
  # rationale as the ADR-0020 block above.
  # ---------------------------------------------------------------------

  local meta_ok='{"squashMergeAllowed":true,"mergeCommitAllowed":false,"rebaseMergeAllowed":false,"deleteBranchOnMerge":true,"defaultBranchRef":{"name":"main"},"hasWikiEnabled":false,"hasProjectsEnabled":false}'
  local rest_ok='{"squash_merge_commit_title":"PR_TITLE","squash_merge_commit_message":"BLANK"}'
  local rest_drift='{"squash_merge_commit_title":"COMMIT_OR_PR_TITLE","squash_merge_commit_message":"COMMIT_MESSAGES"}'

  jq -e '.verdict == "ok"' <<<"$(judge_settings "$meta_ok" "$rest_ok")" >/dev/null || {
    printf 'FAIL: judge_settings should be ok when every field (incl. squash title/message) matches\n' >&2
    return 1
  }
  jq -e '.missing | index("squash-title-not-pr-title")' <<<"$(judge_settings "$meta_ok" "$rest_drift")" >/dev/null || {
    printf 'FAIL: judge_settings should flag squash-title-not-pr-title when squash_merge_commit_title != PR_TITLE\n' >&2
    return 1
  }
  jq -e '.missing | index("squash-message-not-blank")' <<<"$(judge_settings "$meta_ok" "$rest_drift")" >/dev/null || {
    printf 'FAIL: judge_settings should flag squash-message-not-blank when squash_merge_commit_message != BLANK\n' >&2
    return 1
  }
  jq -e '.verdict == "drifted" and (.missing | index("squash-title-not-pr-title")) and (.missing | index("squash-message-not-blank")) and (.missing | index("merge-not-squash-only") | not)' \
    <<<"$(judge_settings "$meta_ok" '{}')" >/dev/null || {
    printf 'FAIL: judge_settings with an unfetchable REST response ({}) should report the squash fields as drifted (fail-open to drift, not silently pass) without also misreporting the otherwise-compliant GraphQL-sourced fields\n' >&2
    return 1
  }

  jq -e '.verdict == "not-applicable"' <<<"$(judge_titles no-ci-repo '{"workflowsDir": null}')" >/dev/null || {
    printf 'FAIL: judge_titles should be not-applicable for a repo with no .github/workflows\n' >&2
    return 1
  }
  jq -e '.verdict == "ok"' \
    <<<"$(judge_titles titles-ok '{"workflowsDir": {"entries": [{"name": "ci.yml"}, {"name": "pr-title.yml"}]}}')" >/dev/null || {
    printf 'FAIL: judge_titles should be ok when the caller workflow exists and the required check is registered\n' >&2
    return 1
  }
  jq -e '.missing | index("pr-title-check-not-required")' \
    <<<"$(judge_titles titles-missing-check '{"workflowsDir": {"entries": [{"name": "ci.yml"}, {"name": "pr-title.yml"}]}}')" >/dev/null || {
    printf 'FAIL: judge_titles should flag pr-title-check-not-required when the ruleset lacks the "PR title" context\n' >&2
    return 1
  }
  jq -e '.missing | index("pr-title-workflow-missing")' \
    <<<"$(judge_titles titles-ok '{"workflowsDir": {"entries": [{"name": "ci.yml"}]}}')" >/dev/null || {
    printf 'FAIL: judge_titles should flag pr-title-workflow-missing when no pr-title.yml caller exists, even if the ruleset happens to have the context registered\n' >&2
    return 1
  }
  # #337: workflow_call の連結名の正しい形("PR Title / PR title" — 呼び
  # 出し側 job の固定 name / 呼び出される job の name)は ok として受け
  # 付ける — dotfiles 自身以外の全播き先はこの形になる。
  jq -e '.verdict == "ok"' \
    <<<"$(judge_titles titles-connected-ok '{"workflowsDir": {"entries": [{"name": "ci.yml"}, {"name": "pr-title.yml"}]}}')" >/dev/null || {
    printf 'FAIL: judge_titles should accept the workflow_call-connected context form ("PR Title / PR title"), not just the unconnected "PR title"\n' >&2
    return 1
  }
  # 2026-09-26 の事故再発防止: 完全一致に締めた後は、旧・接尾辞後方一致
  # だけを満たす形("CI / PR title" のような、呼び出し側 job の name が
  # "PR Title" 以外の任意の値)を ok と誤判定しない。
  jq -e '.missing | index("pr-title-check-not-required")' \
    <<<"$(judge_titles titles-old-suffix-form '{"workflowsDir": {"entries": [{"name": "ci.yml"}, {"name": "pr-title.yml"}]}}')" >/dev/null || {
    printf 'FAIL: judge_titles should reject a context that only satisfies the old suffix match (e.g. "CI / PR title") now that matching is exact\n' >&2
    return 1
  }

  # ADR-0031 Amendment(2026-09-26): $3 の ground-truth 突き合わせ
  # (pr-title-context-mismatch)。#337 の事故そのもの — ruleset の context
  # は正しい文字列だが、実際の run が報告した check 名がそれと違う
  # (呼び出し側 job に name: が無かったため "check / PR title" になって
  # いた)場合を検出できることを確認する。
  jq -e '.missing | index("pr-title-context-mismatch")' \
    <<<"$(judge_titles titles-connected-ok '{"workflowsDir": {"entries": [{"name": "ci.yml"}, {"name": "pr-title.yml"}]}}' '["check / PR title"]')" >/dev/null || {
    printf 'FAIL: judge_titles should flag pr-title-context-mismatch when the latest run'"'"'s actual job name does not match any required context\n' >&2
    return 1
  }
  # 旧型の別 PR タイトル検査ワークフロー(job 名がそもそも別物)を残した
  # ままのリポジトリでも同様に検出できることを確認する。
  jq -e '.missing | index("pr-title-context-mismatch")' \
    <<<"$(judge_titles titles-connected-ok '{"workflowsDir": {"entries": [{"name": "ci.yml"}, {"name": "pr-title.yml"}]}}' '["PR title (Conventional Commits)"]')" >/dev/null || {
    printf 'FAIL: judge_titles should flag pr-title-context-mismatch for a legacy inline workflow whose job name differs entirely\n' >&2
    return 1
  }
  # 実際に一致していれば mismatch は立たない。
  jq -e '(.missing | index("pr-title-context-mismatch")) | not' \
    <<<"$(judge_titles titles-connected-ok '{"workflowsDir": {"entries": [{"name": "ci.yml"}, {"name": "pr-title.yml"}]}}' '["PR Title / PR title"]')" >/dev/null || {
    printf 'FAIL: judge_titles should not flag pr-title-context-mismatch when the latest run job name matches a required context\n' >&2
    return 1
  }
  # run が一度も走っていない(既定 '[]')場合は ground truth が無いので
  # drift 扱いにしない — pr-title-workflow-missing 側が別途拾う。
  jq -e '(.missing | index("pr-title-context-mismatch")) | not' \
    <<<"$(judge_titles titles-connected-ok '{"workflowsDir": {"entries": [{"name": "ci.yml"}, {"name": "pr-title.yml"}]}}')" >/dev/null || {
    printf 'FAIL: judge_titles should not flag pr-title-context-mismatch when no run has happened yet (default $3=[])\n' >&2
    return 1
  }
  # dotfiles 自己適用の単一名 "PR title" も ground truth と一致すれば ok。
  jq -e '(.missing | index("pr-title-context-mismatch")) | not' \
    <<<"$(judge_titles titles-ok '{"workflowsDir": {"entries": [{"name": "ci.yml"}, {"name": "pr-title.yml"}]}}' '["PR title"]')" >/dev/null || {
    printf 'FAIL: judge_titles should not flag pr-title-context-mismatch for dotfiles self-apply'"'"'s unconnected "PR title" job name\n' >&2
    return 1
  }

  # ---------------------------------------------------------------------
  # releaser domain (grill-me セッション調べ): release-plz/release-please 用
  # GitHub App の secret 配線検出。judge_releaser() の直接呼び出しテスト、
  # 同じ理由で settings/titles と同じスタイル。
  # ---------------------------------------------------------------------

  jq -e '.verdict == "not-applicable" and (.missing | length == 0)' \
    <<<"$(judge_releaser false '[]')" >/dev/null || {
    printf 'FAIL: release workflow を持たない repo は not-applicable になるべき: %s\n' \
      "$(judge_releaser false '[]')" >&2
    return 1
  }
  jq -e '.verdict == "ok" and (.missing | length == 0)' \
    <<<"$(judge_releaser true '["RELEASER_APP_ID","RELEASER_APP_PRIVATE_KEY"]')" >/dev/null || {
    printf 'FAIL: 新 secret 名が揃っていれば ok になるべき: %s\n' \
      "$(judge_releaser true '["RELEASER_APP_ID","RELEASER_APP_PRIVATE_KEY"]')" >&2
    return 1
  }
  jq -e '.verdict == "drifted" and (.missing | index("releaser-secret-name-legacy"))' \
    <<<"$(judge_releaser true '["RELEASE_PLZ_APP_ID","RELEASE_PLZ_APP_PRIVATE_KEY"]')" >/dev/null || {
    printf 'FAIL: 旧 secret 名(rust 系)は releaser-secret-name-legacy になるべき: %s\n' \
      "$(judge_releaser true '["RELEASE_PLZ_APP_ID","RELEASE_PLZ_APP_PRIVATE_KEY"]')" >&2
    return 1
  }
  jq -e '.verdict == "drifted" and (.missing | index("releaser-secret-name-legacy"))' \
    <<<"$(judge_releaser true '["RELEASE_PLEASE_APP_ID","RELEASE_PLEASE_APP_PRIVATE_KEY"]')" >/dev/null || {
    printf 'FAIL: 旧 secret 名(astro 系)も releaser-secret-name-legacy になるべき: %s\n' \
      "$(judge_releaser true '["RELEASE_PLEASE_APP_ID","RELEASE_PLEASE_APP_PRIVATE_KEY"]')" >&2
    return 1
  }
  jq -e '.verdict == "drifted" and (.missing | index("releaser-app-secrets-missing"))' \
    <<<"$(judge_releaser true '[]')" >/dev/null || {
    printf 'FAIL: secret が無ければ releaser-app-secrets-missing になるべき: %s\n' \
      "$(judge_releaser true '[]')" >&2
    return 1
  }
  jq -e '.verdict == "drifted" and (.missing | index("releaser-app-secrets-missing"))' \
    <<<"$(judge_releaser true '["RELEASER_APP_ID"]')" >/dev/null || {
    printf 'FAIL: 片方だけ揃っている場合も releaser-app-secrets-missing になるべき: %s\n' \
      "$(judge_releaser true '["RELEASER_APP_ID"]')" >&2
    return 1
  }

  # ---------------------------------------------------------------------
  # releaser domain: REST 経由の secret 名取得($GH_BIN 越し)を含む配線を
  # 通しで確認する、独立の全パイプライン battery。共有 fixture(repo-list.json/
  # graphql-response.json)を一時的に上書きするので、下の「archived repos」
  # ブロックより前に置く — あちらは自分自身で全上書きするため、ここで残した
  # 状態に依存しない。
  # ---------------------------------------------------------------------

  cat >"$tmp/fixtures/repo-list.json" <<'RELFIX'
[
  {"name": "releaser-ok", "primaryLanguage": {"name": "Rust"}, "visibility": "PUBLIC", "description": "", "repositoryTopics": [], "defaultBranchRef": {"name": "main"}, "squashMergeAllowed": true, "mergeCommitAllowed": false, "rebaseMergeAllowed": false, "deleteBranchOnMerge": true, "hasWikiEnabled": false, "hasProjectsEnabled": false, "createdAt": "2020-01-01T00:00:00Z"},
  {"name": "releaser-legacy", "primaryLanguage": {"name": "Rust"}, "visibility": "PUBLIC", "description": "", "repositoryTopics": [], "defaultBranchRef": {"name": "main"}, "squashMergeAllowed": true, "mergeCommitAllowed": false, "rebaseMergeAllowed": false, "deleteBranchOnMerge": true, "hasWikiEnabled": false, "hasProjectsEnabled": false, "createdAt": "2020-01-01T00:00:00Z"},
  {"name": "releaser-missing", "primaryLanguage": {"name": "Rust"}, "visibility": "PUBLIC", "description": "", "repositoryTopics": [], "defaultBranchRef": {"name": "main"}, "squashMergeAllowed": true, "mergeCommitAllowed": false, "rebaseMergeAllowed": false, "deleteBranchOnMerge": true, "hasWikiEnabled": false, "hasProjectsEnabled": false, "createdAt": "2020-01-01T00:00:00Z"},
  {"name": "releaser-na", "primaryLanguage": {"name": "Rust"}, "visibility": "PUBLIC", "description": "", "repositoryTopics": [], "defaultBranchRef": {"name": "main"}, "squashMergeAllowed": true, "mergeCommitAllowed": false, "rebaseMergeAllowed": false, "deleteBranchOnMerge": true, "hasWikiEnabled": false, "hasProjectsEnabled": false, "createdAt": "2020-01-01T00:00:00Z"}
]
RELFIX
  cat >"$tmp/fixtures/graphql-response.json" <<'RELGQL'
{
  "data": {
    "r1": {"readme": null, "contributing": null, "claudeMd": null, "agentsMd": null, "rootTree": null, "claudeSkillsDir": null, "cargoToml": null, "packageJson": null, "pyprojectToml": null, "goMod": null, "workflowsDir": {"entries": [{"name": "ci.yml"}, {"name": "release-plz.yml"}]}, "renovateJson": null, "renovateJson5": null, "ghRenovateJson": null, "ghRenovateJson5": null, "renovaterc": null},
    "r2": {"readme": null, "contributing": null, "claudeMd": null, "agentsMd": null, "rootTree": null, "claudeSkillsDir": null, "cargoToml": null, "packageJson": null, "pyprojectToml": null, "goMod": null, "workflowsDir": {"entries": [{"name": "release-please.yml"}]}, "renovateJson": null, "renovateJson5": null, "ghRenovateJson": null, "ghRenovateJson5": null, "renovaterc": null},
    "r3": {"readme": null, "contributing": null, "claudeMd": null, "agentsMd": null, "rootTree": null, "claudeSkillsDir": null, "cargoToml": null, "packageJson": null, "pyprojectToml": null, "goMod": null, "workflowsDir": {"entries": [{"name": "release-plz.yml"}]}, "renovateJson": null, "renovateJson5": null, "ghRenovateJson": null, "ghRenovateJson5": null, "renovaterc": null},
    "r4": {"readme": null, "contributing": null, "claudeMd": null, "agentsMd": null, "rootTree": null, "claudeSkillsDir": null, "cargoToml": null, "packageJson": null, "pyprojectToml": null, "goMod": null, "workflowsDir": {"entries": [{"name": "ci.yml"}]}, "renovateJson": null, "renovateJson5": null, "ghRenovateJson": null, "ghRenovateJson5": null, "renovaterc": null}
  }
}
RELGQL
  # secret 名 REST fixture(mock gh は --jq を適用しないので、フィルタ後の
  # 形をそのまま置く — fetch_repo_settings() 用の repos_tarotene_all-ok.json
  # と同じ約束)。releaser-missing は意図的に置かない — mock の既定
  # フォールバック([])がそのまま「secret 無し」の実運用と一致する。
  printf '["RELEASER_APP_ID","RELEASER_APP_PRIVATE_KEY"]' >"$tmp/fixtures/repos_tarotene_releaser-ok_actions_secrets.json"
  printf '["RELEASE_PLEASE_APP_ID","RELEASE_PLEASE_APP_PRIVATE_KEY"]' >"$tmp/fixtures/repos_tarotene_releaser-legacy_actions_secrets.json"

  local out_releaser
  out_releaser="$("$SELF" --json 2>&1)" || true
  jq -e '.[] | select(.repo=="releaser-ok") | .domains.releaser.verdict == "ok"' <<<"$out_releaser" >/dev/null || {
    printf 'FAIL: releaser-ok は releaser=ok になるべき: %s\n' \
      "$(jq -c '.[] | select(.repo=="releaser-ok") | .domains.releaser' <<<"$out_releaser")" >&2
    return 1
  }
  jq -e '.[] | select(.repo=="releaser-legacy") | .domains.releaser.verdict == "drifted" and (.domains.releaser.missing | index("releaser-secret-name-legacy"))' <<<"$out_releaser" >/dev/null || {
    printf 'FAIL: releaser-legacy は drifted/releaser-secret-name-legacy になるべき: %s\n' \
      "$(jq -c '.[] | select(.repo=="releaser-legacy") | .domains.releaser' <<<"$out_releaser")" >&2
    return 1
  }
  jq -e '.[] | select(.repo=="releaser-missing") | .domains.releaser.verdict == "drifted" and (.domains.releaser.missing | index("releaser-app-secrets-missing"))' <<<"$out_releaser" >/dev/null || {
    printf 'FAIL: releaser-missing は drifted/releaser-app-secrets-missing になるべき: %s\n' \
      "$(jq -c '.[] | select(.repo=="releaser-missing") | .domains.releaser' <<<"$out_releaser")" >&2
    return 1
  }
  jq -e '.[] | select(.repo=="releaser-na") | .domains.releaser.verdict == "not-applicable"' <<<"$out_releaser" >/dev/null || {
    printf 'FAIL: release workflow を持たない releaser-na は not-applicable になるべき: %s\n' \
      "$(jq -c '.[] | select(.repo=="releaser-na") | .domains.releaser' <<<"$out_releaser")" >&2
    return 1
  }

  # ---------------------------------------------------------------------
  # #278: archived repos are now included in the account listing —
  # non-naming/non-lifecycle domains must report not-applicable for them
  # instead of judging drift on a read-only repo (or silently disappearing,
  # the pre-#278 --no-archived behavior). This overwrites the shared
  # repo-list.json/graphql-response.json fixtures, so it MUST run last —
  # every earlier assertion in this function has already consumed its own
  # `$out` before this point.
  # ---------------------------------------------------------------------

  cat >"$tmp/fixtures/repo-list.json" <<'ARCHFIX'
[
  {"name": "archived-repo", "primaryLanguage": {"name": "Rust"}, "visibility": "PUBLIC", "description": "old research notes for my exam prep", "repositoryTopics": [{"name": "naming-descriptive"}], "defaultBranchRef": {"name": "main"}, "squashMergeAllowed": true, "mergeCommitAllowed": false, "rebaseMergeAllowed": false, "deleteBranchOnMerge": true, "hasWikiEnabled": false, "hasProjectsEnabled": false, "createdAt": "2020-01-01T00:00:00Z", "isArchived": true}
]
ARCHFIX
  printf '[]' >"$tmp/fixtures/repos_tarotene_archived-repo_rulesets.json"
  cat >"$tmp/fixtures/graphql-response.json" <<'ARCHGQL'
{"data": {"r1": {"readme": null, "contributing": null, "claudeMd": null, "agentsMd": null, "rootTree": null, "claudeSkillsDir": null, "cargoToml": null, "packageJson": null, "pyprojectToml": null, "goMod": null, "flakeNix": null, "workflowsDir": null, "renovateJson": null, "renovateJson5": null, "ghRenovateJson": null, "ghRenovateJson5": null, "renovaterc": null, "latestRelease": null, "openIssueActivity": null}}}
ARCHGQL
  local out_archived
  out_archived="$("$SELF" --json 2>&1)" || true
  jq -e '.[] | select(.repo=="archived-repo") | .domains.rulesets.verdict == "not-applicable"' <<<"$out_archived" >/dev/null || {
    printf 'FAIL: archived repo should report rulesets not-applicable, not drifted/silently-excluded: %s\n' "$(jq -c '.[] | select(.repo=="archived-repo") | .domains' <<<"$out_archived")" >&2
    return 1
  }
  jq -e '.[] | select(.repo=="archived-repo") | .domains.charters.verdict == "not-applicable"' <<<"$out_archived" >/dev/null || {
    printf 'FAIL: archived repo should report charters not-applicable\n' >&2
    return 1
  }
  jq -e '.[] | select(.repo=="archived-repo") | .domains.lifecycle.verdict == "not-applicable"' <<<"$out_archived" >/dev/null || {
    printf 'FAIL: archived repo should report lifecycle not-applicable too (already triaged, no new dormancy signal): %s\n' "$(jq -c '.[] | select(.repo=="archived-repo") | .domains.lifecycle' <<<"$out_archived")" >&2
    return 1
  }
  jq -e '.[] | select(.repo=="archived-repo") | .domains.naming.verdict == "ok" and (.domains.naming.lifecycle_candidates | any(startswith("lifecycle-study-candidate:")))' <<<"$out_archived" >/dev/null || {
    printf 'FAIL: archived repo should still be judged by naming and surface a lifecycle-study candidate from its description: %s\n' "$(jq -c '.[] | select(.repo=="archived-repo") | .domains.naming' <<<"$out_archived")" >&2
    return 1
  }

  printf 'selftest: OK\n'
}

main() {
  local mode=report
  local -a domain_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) mode=json ;;
      --selftest)
        selftest
        return
        ;;
      -h | --help)
        usage
        return
        ;;
      -*)
        usage >&2
        return 2
        ;;
      *) domain_args+=("$1") ;;
    esac
    shift
  done

  local -a DOMAINS=()
  parse_domains "${domain_args[@]}"

  local findings
  findings="$(audit)" || {
    printf 'github-audit: aborting — audit() failed, not writing ledger or findings\n' >&2
    return 1
  }
  write_ledger "$findings"
  case "$mode" in
    report) render_report "$findings" ;;
    json) printf '%s\n' "$findings" ;;
  esac
  any_drift "$findings"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi

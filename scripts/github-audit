#!/usr/bin/env bash
# Unified cross-repository GitHub audit (ADR-0015). Replaces the sibling
# scripts github-audit-rulesets (#130) and github-audit-charters (ADR-0013),
# and adds three new domains: naming (ADR-0014), settings, renovate. Every
# domain is judged deterministically — this script never calls an LLM. Its
# findings feed the github-audit-triage skill, which is the only place an
# LLM enters the loop (docs/github-audit.md).
set -euo pipefail
# Command substitutions ($(...)) run in a subshell; without this, a bare
# `exit N` inside one does not propagate errexit to the assignment's caller
# (bash resets errexit state entering the subshell unless inherit_errexit is
# set). fetch_graphql_batch()/audit() below rely on `||` failure checks that
# need this to actually short-circuit main(), not just report a stray exit.
shopt -s inherit_errexit

SELF="$(realpath "$0")"
OWNER="${GITHUB_AUDIT_OWNER:-tarotene}"
CONFIG_DIR="${GITHUB_AUDIT_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/github-audit}"
STATE_DIR="${GITHUB_AUDIT_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/github-audit}"
OVERRIDES_FILE="${GITHUB_AUDIT_OVERRIDES_FILE:-$CONFIG_DIR/overrides.tsv}"
GH_BIN="${GITHUB_AUDIT_GH_BIN:-gh}"
TEST_TMP=''

# ADR-0020: closed vocabularies for the naming domain's generative grammar.
# Repo-tracked files hold PUBLIC repository entries (dotfiles is itself
# PUBLIC); the .local.tsv siblings hold PRIVATE repository entries and are
# never committed (docs/claude/public-publish-guard.md) — the audit reads
# the union of both.
CODENAME_REGISTRY_FILE="${GITHUB_AUDIT_CODENAME_REGISTRY_FILE:-$CONFIG_DIR/codename-registry.tsv}"
CODENAME_REGISTRY_LOCAL_FILE="${GITHUB_AUDIT_CODENAME_REGISTRY_LOCAL_FILE:-$CONFIG_DIR/codename-registry.local.tsv}"
DESCRIPTIVE_SPECIES_FILE="${GITHUB_AUDIT_DESCRIPTIVE_SPECIES_FILE:-$CONFIG_DIR/descriptive-species.tsv}"
SITE_DOMAINS_FILE="${GITHUB_AUDIT_SITE_DOMAINS_FILE:-$CONFIG_DIR/site-domains.tsv}"
SITE_DOMAINS_LOCAL_FILE="${GITHUB_AUDIT_SITE_DOMAINS_LOCAL_FILE:-$CONFIG_DIR/site-domains.local.tsv}"

# ADR-0020: repositories created on/before this instant are grandfathered
# under the loose ADR-0014 pattern check; only repositories created after it
# face the closed-vocabulary strict grammar (species set / site domain set).
# The codename registry inclusion check applies regardless of this cutoff —
# see judge_naming(). This is ADR-0020's own acceptance date, end-of-day.
NAMING_STRICT_CUTOFF='2026-09-19T23:59:59Z'

ALL_DOMAINS=(rulesets charters naming settings renovate titles)

# Account-wide ruleset baseline (rulesets domain). Derived from the
# rust-repo-governance/typst-repo-governance/astro-site-governance skills'
# rulesets/*.json plus what is actually live on the reference repos — see
# docs/github-audit.md for the full evidence trail. Core layer only —
# always required, regardless of a repository's development phase.
BASELINE_RULE_TYPES=(
  deletion
  non_fast_forward
  required_signatures
  required_linear_history
  required_status_checks
  pull_request
)

# Review layer (ADR-0021): a self-contained addin, not part of the core
# baseline. Judged only if a repository has opted in — presence is
# detected by either half showing up (the copilot_code_review rule type,
# or any active pull_request rule with required_review_thread_resolution
# true). A repository that opts into neither is reported informationally
# (review_layer=absent) and never drifts on this layer.
REVIEW_LAYER_RULE_TYPE=copilot_code_review

# README schema (charters domain, ADR-0016). Background is optional and may
# appear only before Install; the rest is a fixed, required sequence.
REQUIRED_README_HEADINGS=(Install Usage Scope Development License)
ALLOWED_README_HEADINGS=(Background Install Usage Scope Development License)

# CONTRIBUTING.md schema (charters domain, ADR-0017). Both headings are
# required, in this order; Expectations is optional and, if present, comes
# last. "Issue litmus" is retired vocabulary (ADR-0013/ADR-0016) — it is not
# in this allowed set, so a document that still carries it is flagged as a
# stray heading like any other.
REQUIRED_CONTRIBUTING_HEADINGS=(Issues "Pull requests")
ALLOWED_CONTRIBUTING_HEADINGS=(Issues "Pull requests" Expectations)

ROOT_ALLOWLIST_EXACT=(README.md CONTRIBUTING.md CHANGELOG.md AGENTS.md CLAUDE.md)

# CJK-presence threshold (charters domain, ADR-0017). README/CONTRIBUTING are
# fixed to a single English original (ADR-0016 Decision 4), so any CJK
# content at or above this floor is drift on its own — unlike the retired
# two-script "mixing" heuristic, Latin content is not required to co-occur.
CJK_PRESENCE_THRESHOLD=5

# nav-doc thresholds (charters domain, ADR-0033). A heading-delimited
# section whose unique path-like token count meets or exceeds this floor is
# a hand-written inventory (file/content listing) rather than incidental
# path mentions. Calibrated against real drift examples: a 13-line
# directory-structure code block scored 11, a prose ADR index scored 5, a
# legitimate 1-2 path mention scored 1-2.
NAV_DOC_PATH_THRESHOLD=4
# Extensions that make a bare token (no leading '/') look like a file
# reference even without a path separator (e.g. a bare `profile.yml`).
NAV_DOC_PATH_EXTENSIONS='\.(md|yml|yaml|typ|toml|json|sh|nix|rs|py|ts|js|lock|tsv|bib)$'
# Box-drawing characters (U+251C ├, U+2514 └, U+2502 │) that mark a
# hand-drawn directory tree inside a fenced code block. PCRE \x{} escapes
# match count_cjk's style above — locale-independent, unlike bash's [[ =~ ]]
# bracket expressions.
NAV_DOC_TREE_CHARS_PATTERN='[\x{251C}\x{2514}\x{2502}]'

usage() {
  cat <<'EOF'
usage: github-audit [--json|--selftest] [domain...]

Read-only cross-repository audit (ADR-0015). For every non-archived,
non-fork repository owned by $GITHUB_AUDIT_OWNER (default: tarotene),
judges the requested domains (default: all of them):

  rulesets   default-branch GitHub ruleset rule-type coverage (#130).
             required_status_checks is derived from CI presence
             (ADR-0020) — repos with no .github/workflows are reported
             drifted with missing=ci-absent instead of silently excused
  charters   README + CONTRIBUTING.md schema + root doc allowlist + CJK
             presence + CLAUDE.md/AGENTS.md routing (ADR-0013/0016/0017)
  naming     repository naming class declaration + pattern match
             (ADR-0014); repos created after ADR-0020's cutoff also face
             its closed vocabularies (descriptive species set, codename
             registry, site domain set) — the codename registry check
             applies to every repo regardless of cutoff
  settings   squash-only merge, delete-branch-on-merge, default branch,
             wiki/projects disabled, squash commit title=PR_TITLE/
             message=BLANK (ADR-0031)
  renovate   Renovate config presence, for repos with a dependency manifest
             and a CI workflow
  titles     PR-title commit-message contract enforcement presence
             (ADR-0031): pr-title.yml caller workflow + "PR title" required
             status check. Presence-detection only, not individual open PR
             titles (the client guard and the required check judge those).
             not-applicable for repos with no .github/workflows

Without options, prints a human-readable report and exits 1 if any
non-exempt repository is drifted/ungoverned in any judged domain. --json
prints the machine-readable findings array instead. A ledger snapshot is
always written to $XDG_STATE_HOME/github-audit/ledger.json (override with
GITHUB_AUDIT_STATE_DIR).

This audit only reports drift — it never applies a fix. Use the
github-audit-triage skill (or the relevant *-repo-governance skill / gh
directly) to fix what it finds.

Exempt a repository from one domain (or all of them) by adding a line
"<repo><TAB><domain-or-*><TAB>exempt" to
$XDG_CONFIG_HOME/github-audit/overrides.tsv (override with
GITHUB_AUDIT_OVERRIDES_FILE). Lines starting with # are ignored. ".github"
is permanently exempt from the naming and charters domains (GitHub reserves
the name).

ADR-0020's closed vocabularies (naming domain) live in
$XDG_CONFIG_HOME/github-audit/{codename-registry,descriptive-species,
site-domains}.tsv (repo-tracked, PUBLIC repos only) plus a
{codename-registry,site-domains}.local.tsv sibling for PRIVATE repos
(never committed). Override the paths with GITHUB_AUDIT_CODENAME_REGISTRY_FILE
/ GITHUB_AUDIT_CODENAME_REGISTRY_LOCAL_FILE /
GITHUB_AUDIT_DESCRIPTIVE_SPECIES_FILE / GITHUB_AUDIT_SITE_DOMAINS_FILE /
GITHUB_AUDIT_SITE_DOMAINS_LOCAL_FILE.
EOF
}

# ---------------------------------------------------------------------------
# Repository listing (shared across all domains)
# ---------------------------------------------------------------------------

list_repos_meta() { # print: JSON array of repo metadata objects
  "$GH_BIN" repo list "$OWNER" --no-archived --source --limit 500 --json \
    name,primaryLanguage,visibility,description,repositoryTopics,defaultBranchRef,\
squashMergeAllowed,mergeCommitAllowed,rebaseMergeAllowed,deleteBranchOnMerge,\
hasWikiEnabled,hasProjectsEnabled,createdAt 2>/dev/null
}

# squash_merge_commit_title/squash_merge_commit_message (ADR-0031) are REST-
# only fields — `gh repo list --json` is backed by GraphQL, and the
# Repository GraphQL type does not expose them (confirmed 2026-09-22: `gh
# repo list --json squashMergeCommitTitle` errors with "Unknown JSON
# field"). One extra REST call per repo, only made when the settings domain
# is actually being audited (see need_repo_rest in audit()). A fetch
# failure is treated the same way judge_rulesets() treats an unfetchable
# ruleset — silently reported as drift rather than aborting the whole run
# (unlike the GraphQL batch fetch, a single repo's REST failure does not
# risk blanket false-positive drift across every repo).
fetch_repo_settings() { # $1=repo -> JSON (REST repo object) or {} on failure
  "$GH_BIN" api "repos/$OWNER/$1" 2>/dev/null || printf '{}'
}

read_overrides() { # print: <repo TAB domain TAB directive>, comments/blanks dropped
  [[ -f $OVERRIDES_FILE ]] || return 0
  grep -Ev '^[[:space:]]*(#|$)' "$OVERRIDES_FILE" || true
}

# ---------------------------------------------------------------------------
# ADR-0020 closed-vocabulary readers (naming domain)
# ---------------------------------------------------------------------------

read_tsv_col1() { # $1=tsv-file -> newline-separated column-1 values (never errors, may be empty)
  [[ -f $1 ]] || return 0
  grep -Ev '^[[:space:]]*(#|$)' "$1" | cut -f1 || true
}

read_closed_set_json() { # $1=repo-file $2=local-file -> JSON array of deduped column-1 tokens
  { read_tsv_col1 "$1"; read_tsv_col1 "$2"; } | LC_ALL=C sort -u | jq -R -c -s 'split("\n") | map(select(length > 0))'
}

is_exempt() { # $1=repo $2=domain $3=overrides-tsv-blob -> 0 if exempt
  local repo="$1" domain="$2" overrides="$3"
  if [[ $repo == .github && ($domain == naming || $domain == charters) ]]; then
    return 0
  fi
  awk -F'\t' -v r="$repo" -v d="$domain" '
    $1 == r && ($2 == d || $2 == "*") && $3 == "exempt" { found = 1 }
    END { exit !found }
  ' <<<"$overrides"
}

# ---------------------------------------------------------------------------
# GraphQL batch fetch (charters + renovate domains): file existence/content
# across every repo in one call, avoiding REST secondary rate limits.
# ---------------------------------------------------------------------------

build_graphql_query() { # $1=JSON array of repo names -> GraphQL query string
  local repos_json="$1" i=0 name query='query {'
  while IFS= read -r name; do
    i=$((i + 1))
    query+=" r$i: repository(owner: \"$OWNER\", name: \"$name\") {
      readme: object(expression: \"HEAD:README.md\") { ... on Blob { text } }
      contributing: object(expression: \"HEAD:CONTRIBUTING.md\") { ... on Blob { text } }
      claudeMd: object(expression: \"HEAD:CLAUDE.md\") { ... on Blob { text } }
      agentsMd: object(expression: \"HEAD:AGENTS.md\") { ... on Blob { text } }
      rootTree: object(expression: \"HEAD:\") { ... on Tree { entries { name type } } }
      claudeSkillsDir: object(expression: \"HEAD:.claude/skills\") { ... on Tree { entries { name type mode } } }
      cargoToml: object(expression: \"HEAD:Cargo.toml\") { ... on Blob { id } }
      packageJson: object(expression: \"HEAD:package.json\") { ... on Blob { id } }
      pyprojectToml: object(expression: \"HEAD:pyproject.toml\") { ... on Blob { id } }
      goMod: object(expression: \"HEAD:go.mod\") { ... on Blob { id } }
      flakeNix: object(expression: \"HEAD:flake.nix\") { ... on Blob { id } }
      workflowsDir: object(expression: \"HEAD:.github/workflows\") { ... on Tree { entries { name } } }
      renovateJson: object(expression: \"HEAD:renovate.json\") { ... on Blob { id } }
      renovateJson5: object(expression: \"HEAD:renovate.json5\") { ... on Blob { id } }
      ghRenovateJson: object(expression: \"HEAD:.github/renovate.json\") { ... on Blob { id } }
      ghRenovateJson5: object(expression: \"HEAD:.github/renovate.json5\") { ... on Blob { id } }
      renovaterc: object(expression: \"HEAD:.renovaterc.json\") { ... on Blob { id } }
    }"
  done < <(jq -r '.[]' <<<"$repos_json")
  query+=' }'
  printf '%s' "$query"
}

# A single query spanning every audited repo (~35 repos, ~50KB of query text)
# reliably gets HTTP 502 from GitHub's GraphQL endpoint (observed 2026-09-19;
# see docs.github.com/en/graphql/overview/resource-limitations on node/point
# limits for large queries). Fetch in fixed-size chunks instead.
GRAPHQL_CHUNK_SIZE=10

fetch_graphql_batch() { # $1=JSON array of repo names -> {repoName: {...}} keyed object
  local repos_json="$1" total start=0 merged='{}'
  total="$(jq 'length' <<<"$repos_json")"
  ((total > 0)) || {
    printf '{}'
    return
  }
  while ((start < total)); do
    local chunk query result mapped
    chunk="$(jq -c --argjson s "$start" --argjson n "$GRAPHQL_CHUNK_SIZE" '.[$s:($s+$n)]' <<<"$repos_json")"
    query="$(build_graphql_query "$chunk")"
    # Fail loud: a fetch failure here must abort the whole audit, not fall
    # back to an empty object — an empty object reads downstream as "every
    # file in every repo in this chunk is missing", producing wholesale
    # false-positive drift instead of surfacing the actual fetch failure.
    if ! result="$("$GH_BIN" api graphql -f query="$query")"; then
      printf 'github-audit: GraphQL batch fetch failed for repos [%s] — aborting (not falling back to empty data)\n' \
        "$(jq -r 'join(", ")' <<<"$chunk")" >&2
      return 1
    fi
    # $result can carry the full README/CONTRIBUTING text of every repo in
    # the chunk, which blows past ARG_MAX if passed as a jq --argjson
    # command-line argument — pipe it through stdin instead; only the small
    # $chunk goes as --argjson.
    mapped="$(jq -c --argjson names "$chunk" '
      .data as $data
      | reduce range(0; ($names | length)) as $i
          ({}; . + {($names[$i]): ($data["r\($i+1)"] // {})})
    ' <<<"$result")"
    # Same ARG_MAX hazard as above: $merged accumulates every prior chunk's
    # README/CONTRIBUTING text, so it must not go through --argjson either —
    # feed both sides via process substitution instead.
    merged="$(jq -c -s '.[0] + .[1]' <(printf '%s' "$merged") <(printf '%s' "$mapped"))"
    start=$((start + GRAPHQL_CHUNK_SIZE))
  done
  printf '%s' "$merged"
}

# ---------------------------------------------------------------------------
# rulesets domain (unchanged judgement logic from github-audit-rulesets)
# ---------------------------------------------------------------------------

fetch_rulesets_list() { "$GH_BIN" api "repos/$OWNER/$1/rulesets" 2>/dev/null; }
fetch_ruleset_detail() { "$GH_BIN" api "repos/$OWNER/$1/rulesets/$2" 2>/dev/null; }

default_branch_rulesets() {
  local repo="$1" ids id detail arr='[]'
  ids="$(fetch_rulesets_list "$repo" | jq -r '.[]? | select(.target=="branch" and .enforcement=="active") | .id' 2>/dev/null)" || ids=''
  while IFS= read -r id; do
    [[ -n $id ]] || continue
    detail="$(fetch_ruleset_detail "$repo" "$id")" || continue
    [[ -n $detail ]] || continue
    if jq -e '
      ((.conditions.ref_name.include // []) | (index("~DEFAULT_BRANCH") or index("~ALL")))
      and ((.conditions.ref_name.exclude // []) | (index("~DEFAULT_BRANCH") | not))
    ' <<<"$detail" >/dev/null 2>&1; then
      arr="$(jq -c --argjson d "$detail" '. + [$d]' <<<"$arr")"
    fi
  done <<<"$ids"
  printf '%s' "$arr"
}

judge_rulesets() { # $1=repo $2=has_workflows(true/false) -> one JSON finding object (no repo/language wrapper)
  local repo="$1" has_workflows="${2:-true}" arr count types t pr_params thread_ok squash_ok checks
  local -a missing=()
  arr="$(default_branch_rulesets "$repo")"
  count="$(jq 'length' <<<"$arr")"
  if [[ $count -eq 0 ]]; then
    jq -n '{verdict: "ungoverned", missing: [], status_checks: [], review_layer: "absent"}'
    return
  fi

  types="$(jq -c '[.[].rules[]?.type] | unique' <<<"$arr")"
  for t in "${BASELINE_RULE_TYPES[@]}"; do
    # ADR-0020: required_status_checks is derived from CI presence — a repo
    # with no .github/workflows has nothing to require a status check from,
    # so this one rule type is excluded from the baseline loop for it. This
    # is not silent — see the ci-absent push below, which keeps such a repo
    # reported as drifted (not not-applicable) so it surfaces for human
    # triage {CI 播種 PR / 誘導 Issue / exempt} instead of going quiet forever.
    if [[ $t == required_status_checks && $has_workflows != true ]]; then
      continue
    fi
    jq -e --arg t "$t" 'index($t)' <<<"$types" >/dev/null 2>&1 || missing+=("$t")
  done
  [[ $has_workflows == true ]] || missing+=("ci-absent")

  # A pull_request rule may appear on more than one active ruleset (the core
  # layer's own rule, plus the review layer's, once split into review.json —
  # ADR-0021). GitHub aggregates same-type rules across rulesets by applying
  # the most restrictive value per parameter (GitHub Docs, "About rulesets",
  # rule layering), so thread resolution is an OR and allowed_merge_methods
  # is an intersection across every pull_request rule found.
  pr_params="$(jq -c '[.[].rules[]? | select(.type=="pull_request") | .parameters]' <<<"$arr")"
  thread_ok=false
  if [[ "$(jq 'length' <<<"$pr_params")" -gt 0 ]]; then
    jq -e 'any(.[]; (.required_review_thread_resolution // false) == true)' <<<"$pr_params" >/dev/null 2>&1 &&
      thread_ok=true
    jq -e '
      [.[] | select(.allowed_merge_methods != null) | .allowed_merge_methods] as $lists
      | ($lists | length) > 0
        and (($lists[1:] | reduce .[] as $l ($lists[0]; [.[] | select(. as $x | $l | index($x) != null)])) == ["squash"])
    ' <<<"$pr_params" >/dev/null 2>&1 && squash_ok=true || squash_ok=false
    [[ $squash_ok == true ]] || missing+=("pull_request.allowed_merge_methods")
  fi

  # Review layer (ADR-0021): opt-in addin, judged only if present. A
  # repository that opted into neither half is not drift — it is reported
  # informationally as review_layer=absent.
  local review_layer_present=false
  jq -e --arg t "$REVIEW_LAYER_RULE_TYPE" 'index($t)' <<<"$types" >/dev/null 2>&1 && review_layer_present=true
  [[ $thread_ok == true ]] && review_layer_present=true

  local review_layer=absent
  if [[ $review_layer_present == true ]]; then
    local -a review_missing=()
    jq -e --arg t "$REVIEW_LAYER_RULE_TYPE" 'index($t)' <<<"$types" >/dev/null 2>&1 ||
      review_missing+=("review_layer.copilot_code_review")
    [[ $thread_ok == true ]] || review_missing+=("review_layer.required_review_thread_resolution")
    if ((${#review_missing[@]} == 0)); then
      review_layer=complete
    else
      review_layer=partial-drift
      missing+=("${review_missing[@]}")
    fi
  fi

  checks="$(jq -c '[.[].rules[]? | select(.type=="required_status_checks") | .parameters.required_status_checks[]?.context] | unique' <<<"$arr")"

  if ((${#missing[@]} == 0)); then
    jq -n --argjson checks "$checks" --arg rl "$review_layer" \
      '{verdict: "ok", missing: [], status_checks: $checks, review_layer: $rl}'
  else
    local missing_json
    missing_json="$(printf '%s\n' "${missing[@]}" | jq -R . | jq -s .)"
    jq -n --argjson missing "$missing_json" --argjson checks "$checks" --arg rl "$review_layer" \
      '{verdict: "drifted", missing: $missing, status_checks: $checks, review_layer: $rl}'
  fi
}

# ---------------------------------------------------------------------------
# charters domain (ADR-0013 purpose/topics + ADR-0016 README schema/
# allowlist/routing + ADR-0017 CONTRIBUTING schema/CJK presence)
# ---------------------------------------------------------------------------

extract_purpose() { # $1=readme text -> first non-empty paragraph after the H1
  awk '
    /^# / && !seenH1 { seenH1 = 1; next }
    !seenH1 { next }
    !started && /^[[:space:]]*$/ { next }
    !started { started = 1 }
    started && /^[[:space:]]*$/ { exit }
    started && /^#/ { exit }
    started {
      if (para == "") para = $0
      else para = para " " $0
    }
    END { print para }
  ' <<<"$1"
}

first_sentence() {
  local s
  s="$(grep -oP '^.*?[.。]' <<<"$1" | head -n1)"
  [[ -n $s ]] && printf '%s' "$s" || printf '%s' "$1"
}

normalize_text() {
  local s="$1"
  s="${s//\*\*/}"
  s="${s//__/}"
  s="$(sed -E 's/\[([^]]*)\]\([^)]*\)/\1/g' <<<"$s")"
  s="$(tr -s '[:space:]' ' ' <<<"$s")"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  s="${s%.}"
  s="${s%。}"
  printf '%s' "$s"
}

# strip_for_lang: drop fenced code blocks, inline code, and URLs before
# classifying a document's language mix.
strip_for_lang() {
  awk '
    /^```/ { infence = !infence; next }
    infence { next }
    { print }
  ' <<<"$1" | sed -E 's/`[^`]*`//g; s#https?://[^ )]+##g'
}

count_cjk() { grep -oP '[\x{3040}-\x{30FF}\x{4E00}\x{9FFF}\x{3400}-\x{4DBF}]' <<<"$1" 2>/dev/null | wc -l; }

is_cjk_present() { # $1=doc text -> 0 (true) if CJK count meets the presence floor
  local stripped cjk
  stripped="$(strip_for_lang "$1")"
  cjk="$(count_cjk "$stripped")"
  [[ $cjk -ge $CJK_PRESENCE_THRESHOLD ]]
}

# doc_headings: '## X' heading texts in document order, skipping fenced code
# blocks. Used for both README and CONTRIBUTING.md.
doc_headings() {
  awk '
    /^```/ { infence = !infence; next }
    infence { next }
    /^## / { sub(/^## /, ""); print }
  ' <<<"$1"
}

# ---------------------------------------------------------------------------
# nav-doc domain (ADR-0033): README/CONTRIBUTING/AGENTS.md/CLAUDE.md must not
# materialise a directory tree, a hand-written file/content inventory, or the
# transcribed contents of another file — see repo-charter SKILL.md §4a for
# the regime. Transcription can't be judged deterministically (it requires
# semantic comparison against the source file) so it is left to the
# github-audit-triage LLM node; the two signals below ARE deterministic and
# are judged here.
# ---------------------------------------------------------------------------

# nav_doc_path_tokens: $1=section body text -> one unique path-like token per
# line. A token is either an inline-code-span payload (`...`) or a fenced
# code line's first whitespace-delimited word, kept only if it has no
# internal whitespace, does not start with http(s)://, and either contains
# '/' or ends in a known file extension. Trailing '/' is stripped before
# dedup. Guarded with `|| true` because grep exits 1 on "zero matches",
# which is the common (not exceptional) case for a section with no path
# mentions at all — under this script's `set -o pipefail`, an unguarded
# empty result would abort the caller instead of just meaning "no tokens".
nav_doc_path_tokens() {
  awk '
    /^```/ { infence = !infence; next }
    infence {
      n = split($0, parts, /[[:space:]]+/)
      if (n >= 1 && parts[1] != "") print parts[1]
      next
    }
    {
      s = $0
      while (match(s, /`[^`]+`/)) {
        tok = substr(s, RSTART + 1, RLENGTH - 2)
        if (tok !~ /[[:space:]]/) print tok
        s = substr(s, RSTART + RLENGTH)
      }
    }
  ' <<<"$1" \
    | grep -vE '^https?://' \
    | grep -E "(/|${NAV_DOC_PATH_EXTENSIONS})" \
    | sed -E 's#/$##' \
    | sort -u || true
}

# nav_doc_scan: $1=file label (e.g. "README.md") $2=doc text -> newline-
# separated finding tokens: nav-doc-tree-fence:<file> / nav-doc-path-
# inventory:<file>:<heading>:<n> / nav-doc-exempt-malformed:<file> /
# nav-doc-exempt-unused:<file>:<check>. Empty input yields no findings.
#
# `<!-- nav-doc-exempt: <check> — <reason> -->` (check is path-inventory or
# tree-fence) exempts the block immediately following the marker — the
# whole fence if the next line opens one, otherwise contiguous lines up to
# the next blank line or heading — from that one check only. A marker
# missing the check name or the reason is nav-doc-exempt-malformed. A
# marker whose guarded block would not have drifted anyway (the fence has
# no tree characters; the section's raw, unexempted count is still below
# threshold) is nav-doc-exempt-unused — mirroring ESLint's
# reportUnusedDisableDirectives / Ruff's RUF100.
nav_doc_scan() {
  local file="$1" text="$2"
  [[ -n $text ]] || return 0

  local -a lines
  mapfile -t lines <<<"$text"
  local n=${#lines[@]}
  ((n > 0)) || return 0

  # Section index per line (0-based; section 0 is content before the first
  # heading of any level 1-6), and the heading text starting each section.
  # A '#'-prefixed line inside a fenced code block (e.g. a shell comment,
  # or example content like a sample notes.md) is not a real heading —
  # track fence state so it isn't mistaken for one.
  local -a section_idx=() section_heading=("(intro)")
  local cur=0 k infence_hdr=0
  for ((k = 0; k < n; k++)); do
    if [[ "${lines[$k]}" == '```'* ]]; then
      infence_hdr=$((1 - infence_hdr))
    elif ((! infence_hdr)) && [[ "${lines[$k]}" =~ ^#{1,6}[[:space:]](.*)$ ]]; then
      cur=$((cur + 1))
      section_heading+=("${BASH_REMATCH[1]}")
    fi
    section_idx[k]=$cur
  done
  local n_sections=$((cur + 1))

  # Locate nav-doc-exempt markers and each one's guarded-block line range
  # (0-based, inclusive; end < start means "guards nothing").
  local -a m_check=() m_start=() m_end=() m_malformed=()
  for ((k = 0; k < n; k++)); do
    local trimmed="${lines[$k]}"
    trimmed="${trimmed#"${trimmed%%[![:space:]]*}"}"
    trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
    [[ $trimmed == '<!-- nav-doc-exempt:'*'-->' ]] || continue

    local content="${trimmed#<!-- nav-doc-exempt:}"
    content="${content%-->}"
    content="${content#"${content%%[![:space:]]*}"}"
    content="${content%"${content##*[![:space:]]}"}"

    local check='' malformed=1
    if [[ $content == *' — '* ]]; then
      local c="${content%% — *}" r="${content#* — }"
      c="${c%"${c##*[![:space:]]}"}"
      r="${r#"${r%%[![:space:]]*}"}"
      if { [[ $c == "path-inventory" ]] || [[ $c == "tree-fence" ]]; } && [[ -n $r ]]; then
        check="$c"
        malformed=0
      fi
    fi

    local start=$((k + 1)) end
    if ((malformed == 0)); then
      if ((start < n)) && [[ "${lines[$start]}" == '```'* ]]; then
        end=$start
        local j
        for ((j = start + 1; j < n; j++)); do
          if [[ "${lines[$j]}" == '```'* ]]; then
            end=$j
            break
          fi
        done
      else
        local j=$start
        while ((j < n)); do
          local bl="${lines[$j]}"
          [[ -z $bl ]] && break
          [[ $bl =~ ^#{1,6}[[:space:]] ]] && break
          j=$((j + 1))
        done
        end=$((j - 1))
      fi
    else
      end=$((start - 1))
    fi
    m_check+=("$check")
    m_start+=("$start")
    m_end+=("$end")
    m_malformed+=("$malformed")
  done

  # Blank out each valid marker's guarded range, per check type, so the
  # scans below skip exactly what was exempted and nothing else.
  local -a lines_path=("${lines[@]}") lines_tree=("${lines[@]}")
  local mi
  for ((mi = 0; mi < ${#m_check[@]}; mi++)); do
    ((m_malformed[mi] == 0)) || continue
    local s=${m_start[mi]} e=${m_end[mi]}
    ((e >= s)) || continue
    local idx
    for ((idx = s; idx <= e; idx++)); do
      if [[ ${m_check[mi]} == "path-inventory" ]]; then
        lines_path[idx]=""
      else
        lines_tree[idx]=""
      fi
    done
  done

  local -a findings=()

  # tree-fence: any fence (post path/tree exemption) containing box-drawing
  # characters is a hand-drawn directory tree. File-level, not per-section.
  local infence=0
  for ((k = 0; k < n; k++)); do
    local l="${lines_tree[$k]}"
    if [[ $l == '```'* ]]; then
      infence=$((1 - infence))
      continue
    fi
    if ((infence)) && grep -qP "$NAV_DOC_TREE_CHARS_PATTERN" <<<"$l"; then
      findings+=("nav-doc-tree-fence:$file")
      break
    fi
  done

  # path-inventory: per-section unique path-token count, on both the
  # exempted lines (what actually drifts) and the raw lines (the baseline
  # used below to tell a used exemption from an unused one).
  local -a section_raw_count=()
  local si
  for ((si = 0; si < n_sections; si++)); do
    local body_exempted='' body_raw=''
    for ((k = 0; k < n; k++)); do
      ((section_idx[k] == si)) || continue
      body_exempted+="${lines_path[$k]}"$'\n'
      body_raw+="${lines[$k]}"$'\n'
    done
    local count_exempted count_raw
    count_exempted="$(nav_doc_path_tokens "$body_exempted" | wc -l | tr -d '[:space:]')"
    count_raw="$(nav_doc_path_tokens "$body_raw" | wc -l | tr -d '[:space:]')"
    if ((count_exempted >= NAV_DOC_PATH_THRESHOLD)); then
      findings+=("nav-doc-path-inventory:$file:${section_heading[$si]}:$count_exempted")
    fi
    section_raw_count[si]=$count_raw
  done

  # Marker bookkeeping: malformed (missing check name or reason) and unused
  # (the guarded block would not have drifted even without the exemption).
  local any_malformed=0
  for ((mi = 0; mi < ${#m_check[@]}; mi++)); do
    if ((m_malformed[mi] == 1)); then
      any_malformed=1
      continue
    fi
    if [[ ${m_check[mi]} == "tree-fence" ]]; then
      local has_tree=0 idx2
      for ((idx2 = m_start[mi]; idx2 <= m_end[mi]; idx2++)); do
        ((idx2 >= 0 && idx2 < n)) || continue
        grep -qP "$NAV_DOC_TREE_CHARS_PATTERN" <<<"${lines[$idx2]}" && has_tree=1
      done
      ((has_tree == 1)) || findings+=("nav-doc-exempt-unused:$file:tree-fence")
    else
      local sec=0
      ((m_start[mi] < n)) && sec=${section_idx[${m_start[mi]}]}
      ((section_raw_count[sec] >= NAV_DOC_PATH_THRESHOLD)) || findings+=("nav-doc-exempt-unused:$file:path-inventory")
    fi
  done
  ((any_malformed == 0)) || findings+=("nav-doc-exempt-malformed:$file")

  ((${#findings[@]} > 0)) && printf '%s\n' "${findings[@]}"
  return 0
}

judge_charters() { # $1=repo $2=description $3=topicCount $4=gql-data-json -> finding
  local repo="$1" description="$2" topics="$3" gql="$4"
  local readme contributing claude_md agents_md has_agents_md root_tree claude_skills_dir
  local -a missing=()

  readme="$(jq -r '.readme.text // ""' <<<"$gql")"
  contributing="$(jq -r '.contributing.text // ""' <<<"$gql")"
  claude_md="$(jq -r '.claudeMd.text // ""' <<<"$gql")"
  agents_md="$(jq -r '.agentsMd.text // ""' <<<"$gql")"
  [[ -n $agents_md ]] && has_agents_md=true || has_agents_md=false
  root_tree="$(jq -c '.rootTree.entries // []' <<<"$gql")"
  claude_skills_dir="$(jq -c '.claudeSkillsDir.entries // null' <<<"$gql")"

  if [[ -z $readme ]]; then
    missing+=("readme-missing")
  else
    local purpose_para purpose_sentence
    purpose_para="$(extract_purpose "$readme")"
    if [[ -z $purpose_para ]]; then
      missing+=("no-purpose-paragraph")
    else
      purpose_sentence="$(first_sentence "$purpose_para")"
      if [[ -z $description ]] || [[ "$(normalize_text "$purpose_sentence")" != "$(normalize_text "$description")" ]]; then
        missing+=("purpose-mismatch")
      fi
    fi

    local -a headings=() stray=() present_required=()
    while IFS= read -r h; do
      [[ -n $h ]] || continue
      headings+=("$h")
    done < <(doc_headings "$readme")
    for h in "${headings[@]}"; do
      local ok=0 a
      for a in "${ALLOWED_README_HEADINGS[@]}"; do [[ "$h" == "$a" ]] && ok=1 && break; done
      ((ok)) || stray+=("$h")
      for a in "${REQUIRED_README_HEADINGS[@]}"; do [[ "$h" == "$a" ]] && present_required+=("$h"); done
    done
    [[ "${present_required[*]:-}" == "${REQUIRED_README_HEADINGS[*]}" ]] || missing+=("readme-schema-incomplete-or-out-of-order")
    ((${#stray[@]} == 0)) || missing+=("readme-stray-heading:$(
      IFS=,
      echo "${stray[*]}"
    )")

    grep -qE '^## Issue litmus([[:space:]]|$)' <<<"$readme" && missing+=("litmus-not-migrated")

    is_cjk_present "$readme" && missing+=("readme-cjk-present")

    while IFS= read -r finding; do
      [[ -n $finding ]] && missing+=("$finding")
    done < <(nav_doc_scan "README.md" "$readme")
  fi

  if [[ -z $contributing ]]; then
    missing+=("contributing-missing")
  else
    local -a c_headings=() c_stray=() c_present_required=()
    while IFS= read -r h; do
      [[ -n $h ]] || continue
      c_headings+=("$h")
    done < <(doc_headings "$contributing")
    for h in "${c_headings[@]}"; do
      local ok=0 a
      for a in "${ALLOWED_CONTRIBUTING_HEADINGS[@]}"; do [[ "$h" == "$a" ]] && ok=1 && break; done
      ((ok)) || c_stray+=("$h")
      for a in "${REQUIRED_CONTRIBUTING_HEADINGS[@]}"; do [[ "$h" == "$a" ]] && c_present_required+=("$h"); done
    done
    [[ "${c_present_required[*]:-}" == "${REQUIRED_CONTRIBUTING_HEADINGS[*]}" ]] || missing+=("contributing-schema-incomplete-or-out-of-order")
    ((${#c_stray[@]} == 0)) || missing+=("contributing-stray-heading:$(
      IFS=,
      echo "${c_stray[*]}"
    )")

    is_cjk_present "$contributing" && missing+=("contributing-cjk-present")

    while IFS= read -r finding; do
      [[ -n $finding ]] && missing+=("$finding")
    done < <(nav_doc_scan "CONTRIBUTING.md" "$contributing")
  fi

  while IFS= read -r finding; do
    [[ -n $finding ]] && missing+=("$finding")
  done < <(nav_doc_scan "AGENTS.md" "$agents_md")
  while IFS= read -r finding; do
    [[ -n $finding ]] && missing+=("$finding")
  done < <(nav_doc_scan "CLAUDE.md" "$claude_md")

  [[ $topics -ge 1 ]] || missing+=("no-topics")

  # Root doc allowlist
  local -a stray_root=()
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    [[ $name == *.md ]] || continue
    local ok=0 a
    for a in "${ROOT_ALLOWLIST_EXACT[@]}"; do [[ "$name" == "$a" ]] && ok=1 && break; done
    [[ $name == LICENSE* ]] && ok=1
    ((ok)) || stray_root+=("$name")
  done < <(jq -r '.[]? | select(.type=="blob") | .name' <<<"$root_tree")
  ((${#stray_root[@]} == 0)) || missing+=("root-doc-not-allowlisted:$(
    IFS=,
    echo "${stray_root[*]}"
  )")

  # CLAUDE.md router check: only judged if CLAUDE.md exists.
  if [[ -n $claude_md ]]; then
    if ! grep -qE '^@AGENTS\.md[[:space:]]*$' <<<"$claude_md"; then
      missing+=("claude-md-not-routed")
    elif [[ $has_agents_md != true ]]; then
      missing+=("claude-md-routed-but-agents-md-missing")
    fi
  fi

  # skills routing check: entries directly under .claude/skills must be
  # symlinks (git mode 120000) into ../.agents/skills/<name>, not real
  # directories.
  if [[ $claude_skills_dir != null ]]; then
    local -a stray_skills=()
    while IFS= read -r entry; do
      [[ -n $entry ]] || continue
      local name mode
      name="$(jq -r '.name' <<<"$entry")"
      mode="$(jq -r '.mode // ""' <<<"$entry")"
      # #259: GraphQL's TreeEntry.mode returns the symlink mode as a decimal
      # (40960), while REST's git/trees API returns the same mode as an octal
      # string ("120000") — 040960 (decimal) == 0120000 (octal), same mode.
      # Accept both representations rather than only the REST one.
      [[ $mode == "120000" || $mode == "40960" ]] || stray_skills+=("$name")
    done < <(jq -c '.[]?' <<<"$claude_skills_dir")
    ((${#stray_skills[@]} == 0)) || missing+=("skills-not-routed:$(
      IFS=,
      echo "${stray_skills[*]}"
    )")
  fi

  if ((${#missing[@]} == 0)); then
    jq -n '{verdict: "ok", missing: []}'
  else
    local missing_json
    missing_json="$(printf '%s\n' "${missing[@]}" | jq -R . | jq -s .)"
    jq -n --argjson missing "$missing_json" '{verdict: "drifted", missing: $missing}'
  fi
}

# ---------------------------------------------------------------------------
# naming domain (ADR-0014)
# ---------------------------------------------------------------------------

judge_naming() { # $1=repo $2=topics-json $3=createdAt $4=species-json $5=codename-registry-json $6=site-domains-json -> finding
  local repo="$1" topics_json="$2" created_at="$3"
  local species_json="${4:-[]}" registry_json="${5:-[]}" site_json="${6:-[]}"
  local -a naming_topics=() missing=()
  while IFS= read -r t; do
    [[ -n $t ]] || continue
    naming_topics+=("$t")
  done < <(jq -r '.[] | select(startswith("naming-"))' <<<"$topics_json")

  # ADR-0020: repositories created after the strict cutoff face the closed
  # vocabulary (species set / site domain set) on top of the ADR-0014
  # lexical pattern; earlier repositories are grandfathered (ADR-0007
  # precedent — no retroactive rename). The codename registry-inclusion
  # check below is NOT gated by this flag: it applies to every
  # naming-codename declaration regardless of when the repo was created.
  local strict=0
  [[ "$created_at" > "$NAMING_STRICT_CUTOFF" ]] && strict=1

  local class='' pattern=''
  if ((${#naming_topics[@]} == 0)); then
    missing+=("class-undeclared")
  elif ((${#naming_topics[@]} > 1)); then
    missing+=("class-ambiguous")
  else
    class="${naming_topics[0]}"
    case "$class" in
      naming-pj) pattern='^pj-[a-z0-9]+(-[a-z0-9]+)*$' ;;
      naming-codename)
        pattern='^[a-z0-9]+$'
        jq -e --arg r "$repo" 'index($r)' <<<"$registry_json" >/dev/null 2>&1 ||
          missing+=("codename-not-registered")
        ;;
      naming-descriptive)
        pattern='^[a-z0-9]+(-[a-z0-9]+)+$'
        if ((strict)); then
          local species_token="${repo##*-}"
          jq -e --arg s "$species_token" 'index($s)' <<<"$species_json" >/dev/null 2>&1 ||
            missing+=("species-unrecognized:$species_token")
        fi
        ;;
      naming-site)
        pattern='^[a-z0-9]+(\.[a-z0-9]+)+$'
        if ((strict)); then
          jq -e --arg r "$repo" 'index($r)' <<<"$site_json" >/dev/null 2>&1 ||
            missing+=("domain-unrecognized")
        fi
        ;;
      *) missing+=("class-unknown:$class") ;;
    esac
    if [[ -n $pattern ]] && ! [[ $repo =~ $pattern ]]; then
      missing+=("pattern-mismatch:$class")
    fi
  fi

  if ((${#missing[@]} == 0)); then
    jq -n --arg class "$class" '{verdict: "ok", missing: [], class: $class}'
  else
    local missing_json
    missing_json="$(printf '%s\n' "${missing[@]}" | jq -R . | jq -s .)"
    jq -n --argjson missing "$missing_json" --arg class "$class" \
      '{verdict: "drifted", missing: $missing, class: $class}'
  fi
}

# ---------------------------------------------------------------------------
# settings domain
# ---------------------------------------------------------------------------

judge_settings() { # $1=repo-meta-json(GraphQL) $2=repo-rest-json(REST, optional) -> finding
  local meta="$1" rest="${2:-{\}}"
  local -a missing=()
  jq -e '.squashMergeAllowed == true and .mergeCommitAllowed == false and .rebaseMergeAllowed == false' <<<"$meta" >/dev/null 2>&1 ||
    missing+=("merge-not-squash-only")
  jq -e '.deleteBranchOnMerge == true' <<<"$meta" >/dev/null 2>&1 || missing+=("delete-branch-on-merge-disabled")
  jq -e '(.defaultBranchRef.name // "") == "main"' <<<"$meta" >/dev/null 2>&1 || missing+=("default-branch-not-main")
  jq -e '.hasWikiEnabled == false' <<<"$meta" >/dev/null 2>&1 || missing+=("wiki-enabled")
  jq -e '.hasProjectsEnabled == false' <<<"$meta" >/dev/null 2>&1 || missing+=("projects-enabled")
  # ADR-0031: PR タイトル = main の squash commit subject という契約は、
  # この2つの値の上に成立している(config/claude/skills/*-repo-governance/
  # scripts/apply-repo-settings.sh の適用側と同じ宣言値)。
  jq -e '.squash_merge_commit_title == "PR_TITLE"' <<<"$rest" >/dev/null 2>&1 ||
    missing+=("squash-title-not-pr-title")
  jq -e '.squash_merge_commit_message == "BLANK"' <<<"$rest" >/dev/null 2>&1 ||
    missing+=("squash-message-not-blank")

  if ((${#missing[@]} == 0)); then
    jq -n '{verdict: "ok", missing: []}'
  else
    local missing_json
    missing_json="$(printf '%s\n' "${missing[@]}" | jq -R . | jq -s .)"
    jq -n --argjson missing "$missing_json" '{verdict: "drifted", missing: $missing}'
  fi
}

# ---------------------------------------------------------------------------
# renovate domain
# ---------------------------------------------------------------------------

judge_renovate() { # $1=gql-data-json -> finding
  local gql="$1" has_manifest has_workflows has_config
  has_manifest="$(jq -e '(.cargoToml != null) or (.packageJson != null) or (.pyprojectToml != null) or (.goMod != null) or (.flakeNix != null)' <<<"$gql" >/dev/null 2>&1 && echo true || echo false)"
  has_workflows="$(jq -e '(.workflowsDir.entries // []) | length > 0' <<<"$gql" >/dev/null 2>&1 && echo true || echo false)"

  if [[ $has_manifest != true || $has_workflows != true ]]; then
    jq -n '{verdict: "not-applicable", missing: []}'
    return
  fi

  has_config="$(jq -e '(.renovateJson != null) or (.renovateJson5 != null) or (.ghRenovateJson != null) or (.ghRenovateJson5 != null) or (.renovaterc != null)' <<<"$gql" >/dev/null 2>&1 && echo true || echo false)"
  if [[ $has_config == true ]]; then
    jq -n '{verdict: "ok", missing: []}'
  else
    jq -n '{verdict: "drifted", missing: ["renovate-config-missing"]}'
  fi
}

# ---------------------------------------------------------------------------
# titles domain (ADR-0031): presence-detection only — whether the PR-title
# commit-message contract's enforcement mechanism exists, not whether any
# individual open PR's title currently conforms (that is the client guard's
# and the required check's job; auditing it too would let this domain
# report drift while CI is green, docs/claude/pr-title-contract.md).
# ---------------------------------------------------------------------------

REQUIRED_PR_TITLE_CONTEXT='PR title'

judge_titles() { # $1=repo $2=repo-gql-json -> finding
  local repo="$1" gql="$2" has_workflows has_caller arr checks
  has_workflows="$(jq -e '(.workflowsDir.entries // []) | length > 0' <<<"$gql" >/dev/null 2>&1 && echo true || echo false)"
  # ADR-0020 の grandfathering 型と同じ: CI を持たないリポジトリには
  # required check を要求する土台自体が無いため not-applicable にする
  # (renovate ドメインと同じ判定、上の judge_renovate() 参照)。
  if [[ $has_workflows != true ]]; then
    jq -n '{verdict: "not-applicable", missing: []}'
    return
  fi

  local -a missing=()
  has_caller="$(jq -e '(.workflowsDir.entries // []) | any(.name == "pr-title.yml")' <<<"$gql" >/dev/null 2>&1 && echo true || echo false)"
  [[ $has_caller == true ]] || missing+=("pr-title-workflow-missing")

  arr="$(default_branch_rulesets "$repo")"
  checks="$(jq -c '[.[].rules[]? | select(.type=="required_status_checks") | .parameters.required_status_checks[]?.context] | unique' <<<"$arr")"
  jq -e --arg c "$REQUIRED_PR_TITLE_CONTEXT" 'index($c)' <<<"$checks" >/dev/null 2>&1 ||
    missing+=("pr-title-check-not-required")

  if ((${#missing[@]} == 0)); then
    jq -n '{verdict: "ok", missing: []}'
  else
    local missing_json
    missing_json="$(printf '%s\n' "${missing[@]}" | jq -R . | jq -s .)"
    jq -n --argjson missing "$missing_json" '{verdict: "drifted", missing: $missing}'
  fi
}

# ---------------------------------------------------------------------------
# Orchestration
# ---------------------------------------------------------------------------

parse_domains() { # $@=args -> sets DOMAINS array, echoes remaining unrecognized args to stderr and exits 2
  local -a out=()
  local d ok
  for d in "$@"; do
    ok=0
    for known in "${ALL_DOMAINS[@]}"; do [[ "$d" == "$known" ]] && ok=1 && break; done
    ((ok)) || {
      printf 'unknown domain: %s\n' "$d" >&2
      return 2
    }
    out+=("$d")
  done
  ((${#out[@]} > 0)) && DOMAINS=("${out[@]}") || DOMAINS=("${ALL_DOMAINS[@]}")
}

audit() { # uses global DOMAINS -> prints JSON array of {repo, language, visibility, domains: {...}}
  local repos_meta overrides results='[]'
  repos_meta="$(list_repos_meta)"
  overrides="$(read_overrides)"

  local need_graphql=0 need_rulesets=0 need_repo_rest=0
  for d in "${DOMAINS[@]}"; do
    # ADR-0020: rulesets also needs GraphQL now, for workflowsDir (CI
    # presence) — required_status_checks is derived from it, not just
    # charters/renovate's file-existence checks. titles (ADR-0031) needs
    # the same workflowsDir data to detect the pr-title.yml caller.
    [[ $d == charters || $d == renovate || $d == rulesets || $d == titles ]] && need_graphql=1
    [[ $d == rulesets ]] && need_rulesets=1
    # settings (ADR-0031 extension) needs the REST-only squash commit title/
    # message fields (see fetch_repo_settings() comment).
    [[ $d == settings ]] && need_repo_rest=1
  done

  local repo_names_json gql_batch='{}'
  repo_names_json="$(jq -c '[.[].name]' <<<"$repos_meta")"
  if ((need_graphql)); then
    gql_batch="$(fetch_graphql_batch "$repo_names_json")" || {
      printf 'github-audit: aborting — charters/renovate/rulesets judgement requires GraphQL data that failed to fetch\n' >&2
      return 1
    }
  fi

  # ADR-0020: closed vocabularies, read once for the whole run (not per-repo).
  local species_json registry_json site_json
  species_json="$(read_closed_set_json "$DESCRIPTIVE_SPECIES_FILE" /dev/null)"
  registry_json="$(read_closed_set_json "$CODENAME_REGISTRY_FILE" "$CODENAME_REGISTRY_LOCAL_FILE")"
  site_json="$(read_closed_set_json "$SITE_DOMAINS_FILE" "$SITE_DOMAINS_LOCAL_FILE")"

  local repo lang vis description topics_json topic_count meta domains_obj entry created_at repo_gql has_workflows
  while IFS= read -r meta; do
    repo="$(jq -r '.name' <<<"$meta")"
    lang="$(jq -r '.primaryLanguage.name // "-"' <<<"$meta")"
    vis="$(jq -r '.visibility' <<<"$meta")"
    description="$(jq -r '.description // ""' <<<"$meta")"
    created_at="$(jq -r '.createdAt // ""' <<<"$meta")"
    topics_json="$(jq -c '[.repositoryTopics[]?.name]' <<<"$meta")"
    topic_count="$(jq 'length' <<<"$topics_json")"
    repo_gql="$(jq -c --arg r "$repo" '.[$r] // {}' <<<"$gql_batch")"
    domains_obj='{}'

    for d in "${DOMAINS[@]}"; do
      if is_exempt "$repo" "$d" "$overrides"; then
        entry='{"verdict":"exempt","missing":[]}'
      else
        case "$d" in
          rulesets)
            if ((need_rulesets)); then
              has_workflows="$(jq -e '(.workflowsDir.entries // []) | length > 0' <<<"$repo_gql" >/dev/null 2>&1 && echo true || echo false)"
              entry="$(judge_rulesets "$repo" "$has_workflows")"
            fi
            ;;
          charters) entry="$(judge_charters "$repo" "$description" "$topic_count" "$repo_gql")" ;;
          naming) entry="$(judge_naming "$repo" "$topics_json" "$created_at" "$species_json" "$registry_json" "$site_json")" ;;
          settings)
            local repo_rest='{}'
            ((need_repo_rest)) && repo_rest="$(fetch_repo_settings "$repo")"
            entry="$(judge_settings "$meta" "$repo_rest")"
            ;;
          renovate) entry="$(judge_renovate "$repo_gql")" ;;
          titles) entry="$(judge_titles "$repo" "$repo_gql")" ;;
        esac
      fi
      domains_obj="$(jq -c --arg d "$d" --argjson e "$entry" '. + {($d): $e}' <<<"$domains_obj")"
    done

    results="$(jq -c --arg repo "$repo" --arg lang "$lang" --arg vis "$vis" --argjson domains "$domains_obj" \
      '. + [{repo: $repo, language: $lang, visibility: $vis, domains: $domains}]' <<<"$results")"
  done < <(jq -c '.[]' <<<"$repos_meta")

  printf '%s' "$results"
}

write_ledger() {
  local findings="$1" tmp
  mkdir -p "$STATE_DIR"
  tmp="$(mktemp "$STATE_DIR/ledger.json.XXXXXX")"
  jq -n --argjson repos "$findings" --arg generated_at "$(date --iso-8601=seconds)" \
    '{generated_at: $generated_at, repos: $repos}' >"$tmp"
  mv "$tmp" "$STATE_DIR/ledger.json"
}

render_report() {
  local findings="$1" total
  jq -r '
    .[] as $r
    | ($r.domains | to_entries[])
    | select(.value.verdict != "not-applicable")
    | "\(.value.verdict)\tdomain=\(.key) verdict=\(.value.verdict) repo=\($r.repo)"
      + (if (.value.missing | length) > 0 then " missing=" + (.value.missing | join(",")) else "" end)
      + (if .value.review_layer then " review_layer=" + .value.review_layer else "" end)
  ' <<<"$findings" | LC_ALL=C sort | cut -f2-
  total="$(jq '[.[].domains | to_entries[]] | length' <<<"$findings")"
  printf 'total: %d finding(s) across %d repo(s)\n' "$total" "$(jq 'length' <<<"$findings")"
  local verdict
  for verdict in ok drifted ungoverned exempt not-applicable; do
    local count
    count="$(jq --arg v "$verdict" '[.[].domains | to_entries[] | select(.value.verdict == $v)] | length' <<<"$findings")"
    printf '  %s=%d\n' "$verdict" "$count"
  done
}

any_drift() { # $1=findings -> exit 0 if any non-exempt/non-ok/non-not-applicable verdict exists
  jq -e '[.[].domains | to_entries[] | select(.value.verdict != "ok" and .value.verdict != "exempt" and .value.verdict != "not-applicable")] | length == 0' <<<"$1" >/dev/null
}


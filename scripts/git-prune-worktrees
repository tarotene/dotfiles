#!/usr/bin/env bash
# `git prune-worktrees` — remove every stale worktree `git audit-worktrees`
# reports, across both classes it detects (see that script's usage text and
# docs/worktree-lifecycle.md for the exact criteria):
#   prunable  registration survives after the checkout directory disappeared
#             → `git worktree prune --expire=now` (metadata only)
#   orphaned  checkout still present but abandoned → `git worktree remove`
#
# This is the single deletion half of the worktree-lifecycle pair:
#   git audit-worktrees   detection only, read-only, never deletes
#   git prune-worktrees   deletion for both classes above
#   git prune-branches    the [gone] branches left behind by either
#
# --expire=now on the prunable path guarantees "what audit reports, this
# deletes" — git's own default (gc.worktreePruneExpire, 3 months) would
# otherwise silently keep recently-vanished registrations that audit already
# surfaced, leaving a gap between "detected" and "removable" (see plan
# git-audit-force-logical-seal.md, D2).
#
# For the orphaned path, plain `git worktree remove` is used unless --force
# is given: a Git refusal (e.g. the tree turned dirty after listing) is
# reported and skipped, not overridden. The one built-in exception is a
# worktree containing a submodule — Git's plain `remove` refuses those
# unconditionally regardless of cleanliness (see `man git-worktree`), so
# after doing our own stricter clean check (which also inspects submodule
# working-tree content, `--ignore-submodules=none`) we retry with `--force`
# for that case only. With --force, every re-validated candidate goes
# straight to `git worktree remove --force` — this only overrides Git's own
# delete refusal; the pre-delete re-validation against a fresh scan (state
# may have changed between listing and confirming) still applies and can
# still skip a candidate (see plan git-audit-force-logical-seal.md, D3).
# Branches are never touched here — `git prune-branches` is the follow-up.
set -euo pipefail

AUDIT_BIN="${GIT_PRUNE_WORKTREES_AUDIT_BIN:-git-audit-worktrees}"
TEST_TMP=''

usage() {
  cat <<'EOF'
usage: git prune-worktrees [--dry-run|--yes|--force|--selftest]

Lists every stale worktree finding from `git audit-worktrees` — both
prunable (registration only, checkout already gone) and orphaned (checkout
still present but abandoned) — confirms once, re-validates right before
acting, then removes each:
  prunable  git worktree prune --expire=now (metadata only; branch kept)
  orphaned  git worktree remove (no --force unless --force is given —
            except a worktree containing a submodule, which Git refuses
            unconditionally: after our own stricter clean check passes,
            that case retries with --force regardless)

Branches are left alone; run `git prune-branches` afterward.

--dry-run  list candidates only, remove nothing
--yes      skip the confirmation prompt (required for non-interactive use)
--force    also override Git's own delete refusal for orphaned checkouts
           (e.g. dirty content) — re-validation still applies and can skip
EOF
}

# candidates: TSV common, repo, path, branch, class, reason — every row from
# the audit's own scan (its "porcelain" TSV format), which already applies
# every safety check for the orphaned class (clean, not open in Herdr, no
# active shelve, [gone] or never-pushed) and reuses Git's own "prunable"
# verdict for the prunable class.
candidates() {
  "$AUDIT_BIN" --porcelain 2>/dev/null
}

prunable_candidates() { awk -F'\t' '$5 == "prunable"'; }
orphaned_candidates() { awk -F'\t' '$5 == "orphaned" { print $2"\t"$3"\t"$4"\t"$6 }'; }

# has_submodule: true if the worktree at $1 has any gitlink (mode 160000)
# entry in its index — i.e. Git's plain `worktree remove` will refuse it
# unconditionally, independent of cleanliness. Deliberately does not end the
# pipe in `grep -q`: on a large repo's `ls-files -s` output, `grep -q` exits
# the moment it matches, and under `pipefail` that early exit can SIGPIPE the
# still-writing `git` upstream — turning a true match into a false (141)
# under `set -o pipefail`. The awk here reads the stream to completion (no
# `exit` in the main rule) before deciding in END, so it never closes the
# pipe early.
has_submodule() {
  git -C "$1" ls-files -s 2>/dev/null | awk '$1 == "160000" { found = 1 } END { exit !found }'
}

# strictly_clean: true if the worktree at $1 has no uncommitted changes
# anywhere, including inside submodule working trees. `--ignore-submodules=none`
# makes this check stricter than the audit's own dirty check (which uses
# plain `status --porcelain` and so does not look inside submodules) — this
# is deliberate: retrying with `--force` bypasses Git's own safety check, so
# this function must cover what that check would have caught.
strictly_clean() {
  [[ -z "$(git -C "$1" status --porcelain --ignore-submodules=none 2>&1)" ]]
}

render() {
  local prunable="$1" orphaned="$2" common repo path branch class reason count=0
  while IFS=$'\t' read -r common repo path branch class reason; do
    [[ -n $path ]] || continue
    count=$((count + 1))
    printf 'prunable worktree: repo=%s path=%s branch=%s reason=%s\n' "$repo" "$path" "${branch:-(detached)}" "$reason"
  done <<<"$prunable"
  while IFS=$'\t' read -r repo path branch reason; do
    [[ -n $path ]] || continue
    count=$((count + 1))
    printf 'orphaned worktree: repo=%s path=%s branch=%s reason=%s\n' "$repo" "$path" "$branch" "$reason"
  done <<<"$orphaned"
  [[ $count -eq 0 ]] || printf 'total: %d stale worktree(s)\n' "$count"
}

# prune_prunable: run `git worktree prune --expire=now` once per unique
# common-dir among the given prunable-class rows. No re-validation seam is
# needed here (unlike the orphaned path): `git worktree prune` itself
# re-evaluates prunability at the moment it runs, so a checkout that
# reappeared between listing and confirming is left alone by git, not by us.
prune_prunable() {
  local prunable="$1" common
  while IFS= read -r common; do
    [[ -n $common ]] || continue
    git --git-dir="$common" worktree prune --verbose --expire=now
  done < <(cut -f1 <<<"$prunable" | LC_ALL=C sort -u)
}

main() {
  local dry=false assume_yes=false force=false findings prunable orphaned fresh answer
  local removed=0 skipped=0
  local common repo path branch class reason err
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry=true ;;
      --yes) assume_yes=true ;;
      --force) force=true ;;
      --selftest)
        selftest
        return
        ;;
      -h | --help)
        usage
        return
        ;;
      *)
        usage >&2
        return 2
        ;;
    esac
    shift
  done

  findings="$(candidates)"
  prunable="$(prunable_candidates <<<"$findings")"
  orphaned="$(orphaned_candidates <<<"$findings")"
  if [[ -z $prunable && -z $orphaned ]]; then
    printf '削除対象の worktree はありません。\n'
    return 0
  fi
  render "$prunable" "$orphaned"

  if [[ $dry == true ]]; then
    printf '(--dry-run: 削除はしていません)\n'
    return 0
  fi

  if [[ $assume_yes != true ]]; then
    [[ -t 0 ]] || {
      printf '非対話実行では --yes が必要です。\n' >&2
      return 2
    }
    read -r -p '上記を削除しますか? [y/N] ' answer
    [[ $answer == y || $answer == Y ]] || return 2
  fi

  [[ -z $prunable ]] || prune_prunable "$prunable"

  if [[ -n $orphaned ]]; then
    # 再検証: 一覧表示・確認の間に状態が変わっていないか、削除に取り掛かる
    # 直前でもう一度スキャンし直す(TOCTOU 対策)。テスト専用シーム
    # GIT_PRUNE_WORKTREES_TEST_PRE_ACT_HOOK は git-unshelve の
    # GIT_UNSHELVE_TEST_PRE_DROP_HOOK と同じ役目 — 通常運用では未設定。
    if [[ -n "${GIT_PRUNE_WORKTREES_TEST_PRE_ACT_HOOK-}" ]]; then
      eval "$GIT_PRUNE_WORKTREES_TEST_PRE_ACT_HOOK"
    fi
    fresh="$(orphaned_candidates <<<"$(candidates)")"

    while IFS=$'\t' read -r repo path branch reason; do
      [[ -n $path ]] || continue
      if ! grep -qF "$path" <<<"$fresh"; then
        printf 'skip(状態が変化したため見送り): %s\n' "$path" >&2
        skipped=$((skipped + 1))
        continue
      fi
      if [[ $force == true ]]; then
        # --force: git 自身の削除拒否のみ押し切る。再検証は上で済んでおり、
        # ここでバイパスするのは「dirty な内容も含めて消す」という git の
        # 安全機構だけ(計画 git-audit-force-logical-seal.md D3)。
        if err="$(git -C "$repo" worktree remove --force -- "$path" 2>&1)"; then
          printf 'removed(--force): %s (%s)\n' "$path" "$branch"
          removed=$((removed + 1))
        else
          printf 'skip(git が拒否): %s: %s\n' "$path" "$err" >&2
          skipped=$((skipped + 1))
        fi
        continue
      fi
      if err="$(git -C "$repo" worktree remove -- "$path" 2>&1)"; then
        printf 'removed: %s (%s)\n' "$path" "$branch"
        removed=$((removed + 1))
      elif has_submodule "$path" && strictly_clean "$path"; then
        # Plain remove refuses any worktree with a submodule regardless of
        # cleanliness (see header comment) — our own stricter clean check
        # already covers what --force would otherwise bypass unchecked.
        if err="$(git -C "$repo" worktree remove --force -- "$path" 2>&1)"; then
          printf 'removed(submodule のため --force): %s (%s)\n' "$path" "$branch"
          removed=$((removed + 1))
        else
          printf 'skip(git が拒否): %s: %s\n' "$path" "$err" >&2
          skipped=$((skipped + 1))
        fi
      else
        printf 'skip(git が拒否): %s: %s\n' "$path" "$err" >&2
        skipped=$((skipped + 1))
      fi
    done <<<"$orphaned"
  fi

  printf 'removed=%d skipped=%d\n' "$removed" "$skipped"
  [[ $removed -eq 0 ]] || printf '[gone] ブランチが残っていれば git prune-branches で確認・削除してください。\n'
}

selftest() {
  local tmp repo common wt1 wt2 out sub repo_sub wt_sub
  tmp="$(mktemp -d)"
  TEST_TMP="$tmp"
  trap 'rm -rf "$TEST_TMP"' EXIT
  repo="$tmp/repo"
  mkdir -p "$repo"
  git -C "$repo" init -q
  git -C "$repo" config core.hooksPath /dev/null
  git -C "$repo" config commit.gpgsign false
  git -C "$repo" config user.name test
  git -C "$repo" config user.email test@example.invalid
  git -C "$repo" commit --allow-empty -qm initial
  common="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)"

  wt1="$tmp/orphan-a"
  wt2="$tmp/orphan-b"
  git -C "$repo" worktree add -q "$wt1" -b worktree/orphan-a
  git -C "$repo" worktree add -q "$wt2" -b worktree/orphan-b

  # Stub the audit binary: reports both as orphaned, independent of any real
  # Herdr/remote state — this selftest is about prune-worktrees' own
  # rendering/confirmation/re-validation/removal, not the audit's
  # classification (covered by git-audit-worktrees --selftest). Column 1
  # (common) is the real git-common-dir here, not a placeholder — the
  # prunable path below actually dereferences it via --git-dir.
  # マーカーファイルが無ければ両方 orphaned として返す。TOCTOU テストは
  # 「一覧表示直後の確認後・削除直前の再スキャン」で結果が変わる状況を
  # 模すため、マーカーを作って 2 回目以降の呼び出しから wt2 を消す。
  cat >"$tmp/audit-stub" <<STUB
#!/usr/bin/env bash
printf '%s\t%s\t%s\tworktree/orphan-a\torphaned\tno-upstream, unique=0\n' '$common' '$repo' '$wt1'
[[ -e '$tmp/drop-b' ]] || printf '%s\t%s\t%s\tworktree/orphan-b\torphaned\tno-upstream, unique=0\n' '$common' '$repo' '$wt2'
STUB
  chmod +x "$tmp/audit-stub"
  export GIT_PRUNE_WORKTREES_AUDIT_BIN="$tmp/audit-stub"

  out="$(bash "$0" --dry-run)"
  grep -qF "$wt1" <<<"$out"
  grep -qF "$wt2" <<<"$out"
  grep -qF -- '--dry-run' <<<"$out"
  [[ -d $wt1 ]] || {
    printf 'FAIL: --dry-run が削除した\n' >&2
    return 1
  }

  if bash "$0" </dev/null >/dev/null 2>&1; then
    printf 'FAIL: 非対話 かつ --yes 無しで確認をすり抜けた\n' >&2
    return 1
  fi
  [[ -d $wt1 ]] || {
    printf 'FAIL: 確認前に削除した\n' >&2
    return 1
  }

  # TOCTOU: 確認後・削除直前の再検証タイミングで wt2 がスタブの結果から
  # 消えるようにする。削除されるのは wt1 だけで、wt2 は「状態が変化した」
  # skip になり checkout もブランチも残るはず(git worktree remove 自体は
  # 一度も呼ばれない)。
  export GIT_PRUNE_WORKTREES_TEST_PRE_ACT_HOOK="touch '$tmp/drop-b'"
  out="$(bash "$0" --yes 2>&1)"
  unset GIT_PRUNE_WORKTREES_TEST_PRE_ACT_HOOK

  [[ ! -d $wt1 ]] || {
    printf 'FAIL: wt1 が削除されなかった\n' >&2
    return 1
  }
  [[ -d $wt2 ]] || {
    printf 'FAIL: 再検証で除外されるはずの wt2 が削除された\n' >&2
    return 1
  }
  grep -qF 'skip(状態が変化したため見送り)' <<<"$out"
  git -C "$repo" show-ref --verify --quiet refs/heads/worktree/orphan-a
  git -C "$repo" show-ref --verify --quiet refs/heads/worktree/orphan-b

  git -C "$repo" worktree remove --force "$wt2"

  # prunable ケース: 登録は残るが checkout ディレクトリが消えた状態
  # (git-audit-worktrees が prunable と判定する状況)を再現し、
  # `git worktree prune --expire=now` 経由でメタデータだけが消え、
  # branch は残ることを確認する(audit 側から移設した検証)。
  local wt3
  wt3="$tmp/prunable-a"
  git -C "$repo" worktree add -q "$wt3" -b worktree/prunable-a
  rm -rf "$wt3"
  cat >"$tmp/audit-stub" <<STUB
#!/usr/bin/env bash
printf '%s\t%s\t%s\tworktree/prunable-a\tprunable\tgitdir file points to non-existent location\n' '$common' '$repo' '$wt3'
STUB
  out="$(bash "$0" --yes 2>&1)"
  grep -qF 'prunable worktree' <<<"$out" || {
    printf 'FAIL(prunable): 一覧に表示されなかった\n' >&2
    return 1
  }
  git --git-dir="$common" worktree list --porcelain | grep -qF "worktree $wt3" && {
    printf 'FAIL(prunable): 登録メタデータが残った\n' >&2
    return 1
  }
  git -C "$repo" show-ref --verify --quiet refs/heads/worktree/prunable-a || {
    printf 'FAIL(prunable): branch まで削除された\n' >&2
    return 1
  }

  # submodule ケース: plain remove が submodule 入りを無条件拒否する状況を
  # 再現する。同じリポジトリを使わず別の sub/repo_sub を用意するのは、
  # worktree/orphan-a・-b 側の状態(すでに片方 drop 済み)を汚さないため。
  sub="$tmp/sub"
  mkdir -p "$sub"
  git -C "$sub" init -q
  git -C "$sub" config core.hooksPath /dev/null
  git -C "$sub" config commit.gpgsign false
  git -C "$sub" config user.name test
  git -C "$sub" config user.email test@example.invalid
  git -C "$sub" commit --allow-empty -qm sub-initial

  repo_sub="$tmp/repo-sub"
  mkdir -p "$repo_sub"
  git -C "$repo_sub" init -q
  git -C "$repo_sub" config core.hooksPath /dev/null
  git -C "$repo_sub" config commit.gpgsign false
  git -C "$repo_sub" config user.name test
  git -C "$repo_sub" config user.email test@example.invalid
  git -C "$repo_sub" -c protocol.file.allow=always submodule add -q "$sub" 0submodule
  # Bulk out `ls-files -s` past the pipe buffer (~64KiB), with the gitlink
  # sorting first (name "0submodule" < "bulk/f*"): this is what actually
  # exercises the `grep -q` SIGPIPE regression (#issue) — has_submodule
  # matching on line 1 while thousands of lines are still queued behind it
  # is exactly the shape that made `grep -q` race with `pipefail` on the
  # real company repos this was first observed on. A tiny index (as this test had
  # before) never reproduces it: the writer finishes before the reader
  # would ever need to close early.
  mkdir -p "$repo_sub/bulk"
  local i
  for i in $(seq -w 1 2000); do : >"$repo_sub/bulk/f$i"; done
  git -C "$repo_sub" add -A
  git -C "$repo_sub" commit -qm 'add submodule + bulk files'

  wt_sub="$tmp/orphan-sub"
  git -C "$repo_sub" worktree add -q "$wt_sub" -b worktree/orphan-sub
  git -C "$wt_sub" -c protocol.file.allow=always submodule update -q --init

  cat >"$tmp/audit-stub-sub" <<STUB
#!/usr/bin/env bash
printf 'common\t%s\t%s\tworktree/orphan-sub\torphaned\tno-upstream, unique=0\n' '$repo_sub' '$wt_sub'
STUB
  chmod +x "$tmp/audit-stub-sub"
  export GIT_PRUNE_WORKTREES_AUDIT_BIN="$tmp/audit-stub-sub"

  # Case A: clean submodule worktree — plain remove refuses, --force retry
  # should succeed.
  out="$(bash "$0" --yes 2>&1)"
  [[ ! -d $wt_sub ]] || {
    printf 'FAIL(submodule): clean な submodule worktree が削除されなかった\n' >&2
    return 1
  }
  grep -qF 'removed(submodule のため --force)' <<<"$out" || {
    printf 'FAIL(submodule): --force 経由の removed メッセージが出なかった\n' >&2
    return 1
  }

  # Case B: submodule 内が dirty — --force で誤って消してはいけない。
  git -C "$repo_sub" worktree add -q "$wt_sub" -b worktree/orphan-sub-dirty
  git -C "$wt_sub" -c protocol.file.allow=always submodule update -q --init
  echo dirty >"$wt_sub/0submodule/untracked.txt"

  cat >"$tmp/audit-stub-sub" <<STUB
#!/usr/bin/env bash
printf 'common\t%s\t%s\tworktree/orphan-sub-dirty\torphaned\tno-upstream, unique=0\n' '$repo_sub' '$wt_sub'
STUB

  out="$(bash "$0" --yes 2>&1)"
  [[ -d $wt_sub ]] || {
    printf 'FAIL(submodule): dirty な submodule worktree が誤って削除された\n' >&2
    return 1
  }
  grep -qF 'skip(git が拒否)' <<<"$out" || {
    printf 'FAIL(submodule): dirty ケースで skip されなかった\n' >&2
    return 1
  }

  # Case C: 同じ dirty な submodule worktree を今度は --force 付きで実行し、
  # git 自身の削除拒否だけを押し切って削除できることを確認する。
  out="$(bash "$0" --yes --force 2>&1)"
  [[ ! -d $wt_sub ]] || {
    printf 'FAIL(--force): dirty な submodule worktree が削除されなかった\n' >&2
    return 1
  }
  grep -qF 'removed(--force)' <<<"$out" || {
    printf 'FAIL(--force): --force 経由の removed メッセージが出なかった\n' >&2
    return 1
  }

  unset GIT_PRUNE_WORKTREES_AUDIT_BIN

  printf 'selftest: OK\n'
}

main "$@"

#!/usr/bin/env bash
# Idempotently add dotfiles-owned hooks to ~/.codex/hooks.json while preserving
# Herdr's own entries and any others already present. Codex owns this file at
# runtime, so each register() call only touches entries whose command matches
# exactly — everything else (including Herdr's integration hook) is untouched.
#
# Accepts any number of (event, matcher, command, timeout) tuples so callers
# from different home-manager modules can each register their own hooks
# against the same file without knowing about each other's tuples.
#
# Optional leading `--retire <event> <command>`... pairs (terminated by
# `--register` or end of args) remove command-exact-match entries first —
# same retire-then-register order and jq shape as register-claude-hooks'
# inline retire()/register(), added when the bleep rename (tarotene/bleep,
# formerly publish-guard) orphaned the old adapter command strings this
# script had registered (#160/#27 upstream cutover left no way to remove a
# stale entry from this file).
set -euo pipefail
TEST_TMP=''

retire() {
  local settings="$1" event="$2" command="$3" tmp
  if ! jq -e --arg event "$event" --arg command "$command" \
      '[.hooks[$event][]? | .hooks[]? | select(.command == $command)] | length > 0' \
      "$settings" >/dev/null; then
    return 0
  fi
  tmp="$(mktemp "$settings.hm.XXXXXX")"
  jq --arg event "$event" --arg command "$command" '
    .hooks[$event] = ( (.hooks[$event] // [])
      | map( if any(.hooks[]?; .command == $command)
             then (.hooks |= map(select(.command != $command)))
             else . end )
      | map(select((.hooks? == null) or ((.hooks | length) > 0))) )
    | (if ((.hooks[$event] // []) | length) == 0 then del(.hooks[$event]) else . end)
  ' "$settings" > "$tmp"
  chmod --reference="$settings" "$tmp" 2>/dev/null || chmod 600 "$tmp"
  mv "$tmp" "$settings"
}

register() {
  local settings="$1" event="$2" matcher="$3" command="$4" timeout="$5" tmp
  if jq -e --arg event "$event" --arg command "$command" \
      '[.hooks[$event][]? | .hooks[]? | select(.command == $command)] | length > 0' \
      "$settings" >/dev/null; then
    return 0
  fi
  tmp="$(mktemp "$settings.hm.XXXXXX")"
  jq --arg event "$event" --arg matcher "$matcher" --arg command "$command" \
    --argjson timeout "$timeout" '
      .hooks[$event] = ((.hooks[$event] // []) + [
        (if $matcher == "" then {} else {matcher: $matcher} end)
        + {hooks: [{type: "command", command: $command, timeout: $timeout}]}
      ])
    ' "$settings" > "$tmp"
  chmod --reference="$settings" "$tmp" 2>/dev/null || chmod 600 "$tmp"
  mv "$tmp" "$settings"
}

main() {
  local settings="$1"
  shift
  if [[ ! -f $settings ]]; then
    mkdir -p "$(dirname "$settings")"
    printf '{}\n' > "$settings"
  fi
  if [[ "${1-}" == --retire ]]; then
    shift
    while (( $# > 0 )) && [[ "$1" != --register ]]; do
      retire "$settings" "$1" "$2"
      shift 2
    done
    [[ "${1-}" == --register ]] && shift
  fi
  while (( $# > 0 )); do
    register "$settings" "$1" "$2" "$3" "$4"
    shift 4
  done
}

selftest() {
  local tmp settings settings2
  tmp="$(mktemp -d)"
  TEST_TMP="$tmp"
  trap 'rm -rf "$TEST_TMP"' EXIT

  settings="$tmp/hooks.json"
  printf '%s\n' '{"hooks":{"SessionStart":[{"hooks":[{"type":"command","command":"herdr-existing"}]}]}}' > "$settings"
  main "$settings" \
    PreToolUse Bash guard-command 10 \
    SessionStart 'startup|resume' context-command 30
  main "$settings" \
    PreToolUse Bash guard-command 10 \
    SessionStart 'startup|resume' context-command 30
  jq -e '
    ([.hooks.SessionStart[]?.hooks[]? | select(.command == "herdr-existing")] | length) == 1
    and (([.hooks.SessionStart[]?.hooks[]? | select(.command == "context-command")] | length) == 1)
    and (([.hooks.PreToolUse[]?.hooks[]? | select(.command == "guard-command")] | length) == 1)
  ' "$settings" >/dev/null

  # A second caller registering more (empty-matcher) tuples in one call must
  # be just as idempotent, and must not disturb the first caller's entries.
  settings2="$tmp/hooks2.json"
  main "$settings2" \
    SessionStart '' report-cmd 10 \
    UserPromptSubmit '' report-cmd 10 \
    Stop '' report-cmd 10 \
    SessionEnd '' clear-cmd 10
  main "$settings2" \
    SessionStart '' report-cmd 10 \
    UserPromptSubmit '' report-cmd 10 \
    Stop '' report-cmd 10 \
    SessionEnd '' clear-cmd 10
  jq -e '
    ([.hooks.SessionStart[]?.hooks[]? | select(.command == "report-cmd")] | length) == 1
    and (([.hooks.UserPromptSubmit[]?.hooks[]? | select(.command == "report-cmd")] | length) == 1)
    and (([.hooks.Stop[]?.hooks[]? | select(.command == "report-cmd")] | length) == 1)
    and (([.hooks.SessionEnd[]?.hooks[]? | select(.command == "clear-cmd")] | length) == 1)
  ' "$settings2" >/dev/null

  # --retire removes a command-exact-match entry (and collapses the now-empty
  # matcher group / event key), leaves other callers' entries untouched, and
  # is a no-op when the target command isn't present.
  main "$settings2" --retire \
    PreToolUse guard-command \
    --register
  main "$settings2" --retire \
    SessionStart report-cmd \
    --register \
    PreToolUse Bash new-guard-command 10
  jq -e '
    ([.hooks.SessionStart[]?.hooks[]? | select(.command == "report-cmd")] | length) == 0
    and (([.hooks.UserPromptSubmit[]?.hooks[]? | select(.command == "report-cmd")] | length) == 1)
    and (([.hooks.PreToolUse[]?.hooks[]? | select(.command == "new-guard-command")] | length) == 1)
  ' "$settings2" >/dev/null
  # Retiring the last remaining SessionStart entry collapses the empty key.
  jq -e '(.hooks | has("SessionStart")) | not' "$settings2" >/dev/null

  printf 'selftest: OK\n'
}

if [[ ${1-} == --selftest ]]; then
  selftest
elif [[ ${2-} == --retire ]] || { [[ $# -ge 5 ]] && (( ($# - 1) % 4 == 0 )); }; then
  main "$@"
else
  printf 'usage: register-codex-hooks <hooks.json> [--retire <event> <command>]... [--register] <event> <matcher> <command> <timeout> [<event> <matcher> <command> <timeout>]...\n' >&2
  exit 2
fi

#!/usr/bin/env bash
# Idempotently add dotfiles-owned hooks to ~/.copilot/settings.json's native
# "hooks" object, while preserving Herdr's own entry (installed out-of-band by
# `herdr integration install copilot`) and everything else in the file —
# notably the top-level "model" key, which Copilot CLI itself persists.
#
# Unlike Claude/Codex's {matcher?, hooks:[...]} nesting, Copilot's native shape
# puts {type, bash, timeoutSec} entries directly in the event array — this
# mirrors Herdr's own already-installed SessionStart entry. Accepts any number
# of (event, bash-command, timeoutSec) triples.
#
# Optional leading `--retire <event> <command>` pairs, each with its own
# `--retire` token (terminated by `--register` or end of args), remove
# bash-exact-match entries first — same retire-then-register order and
# per-pair-prefixed shape as register-codex-hooks, added when the bleep
# rename (tarotene/bleep, formerly publish-guard) orphaned the old adapter
# command strings this script had registered (#160/#27 upstream cutover left
# no way to remove a stale entry from this file). A caller retiring more than
# one command (home/modules/claude.nix's bleep-hook cutover, #576) repeats
# `--retire <event> <command>` once per pair rather than writing a single
# `--retire` ahead of several bare pairs — main() below only accepts that
# per-pair form; a bare-pairs run (or any arg count that doesn't divide into
# whole register tuples) is a usage error (exit 2), not a silent no-op.
set -euo pipefail
TEST_TMP=''

retire() {
  local settings="$1" event="$2" command="$3" tmp
  if ! jq -e --arg event "$event" --arg command "$command" \
      '[.hooks[$event][]? | select(.bash == $command)] | length > 0' \
      "$settings" >/dev/null; then
    return 0
  fi
  tmp="$(mktemp "$settings.hm.XXXXXX")"
  jq --arg event "$event" --arg command "$command" '
    .hooks[$event] = ((.hooks[$event] // []) | map(select(.bash != $command)))
    | (if ((.hooks[$event] // []) | length) == 0 then del(.hooks[$event]) else . end)
  ' "$settings" > "$tmp"
  chmod --reference="$settings" "$tmp" 2>/dev/null || chmod 600 "$tmp"
  mv "$tmp" "$settings"
}

register() {
  local settings="$1" event="$2" command="$3" timeout="$4" tmp
  if jq -e --arg event "$event" --arg command "$command" \
      '[.hooks[$event][]? | select(.bash == $command)] | length > 0' \
      "$settings" >/dev/null; then
    return 0
  fi
  tmp="$(mktemp "$settings.hm.XXXXXX")"
  jq --arg event "$event" --arg command "$command" --argjson timeout "$timeout" '
      .hooks[$event] = ((.hooks[$event] // []) + [
        {type: "command", bash: $command, timeoutSec: $timeout}
      ])
    ' "$settings" > "$tmp"
  chmod --reference="$settings" "$tmp" 2>/dev/null || chmod 600 "$tmp"
  mv "$tmp" "$settings"
}

main() {
  local settings="$1"
  shift
  if [[ ! -f $settings ]]; then
    mkdir -p "$(dirname "$settings")"
    printf '{}\n' > "$settings"
  fi
  while [[ "${1-}" == --retire ]]; do
    shift
    if (( $# < 2 )); then
      printf 'register-copilot-hooks: --retire requires an <event> <command> pair\n' >&2
      exit 2
    fi
    retire "$settings" "$1" "$2"
    shift 2
  done
  [[ "${1-}" == --register ]] && shift
  if (( $# > 0 )) && (( $# % 3 != 0 )); then
    printf 'register-copilot-hooks: register tuples must come in groups of 3 (event command timeout), got %d leftover arg(s)\n' "$#" >&2
    exit 2
  fi
  while (( $# > 0 )); do
    register "$settings" "$1" "$2" "$3"
    shift 3
  done
}

selftest() {
  local tmp settings
  tmp="$(mktemp -d)"
  TEST_TMP="$tmp"
  trap 'rm -rf "$TEST_TMP"' EXIT

  settings="$tmp/settings.json"
  printf '%s\n' '{"hooks":{"SessionStart":[{"type":"command","bash":"herdr-existing","timeoutSec":10}]},"model":"claude-opus-5"}' > "$settings"
  main "$settings" \
    sessionStart report-cmd 10 \
    userPromptSubmitted report-cmd 10 \
    agentStop report-cmd 10 \
    sessionEnd clear-cmd 10
  main "$settings" \
    sessionStart report-cmd 10 \
    userPromptSubmitted report-cmd 10 \
    agentStop report-cmd 10 \
    sessionEnd clear-cmd 10
  jq -e '
    ([.hooks.SessionStart[]? | select(.bash == "herdr-existing")] | length) == 1
    and (([.hooks.sessionStart[]? | select(.bash == "report-cmd")] | length) == 1)
    and (([.hooks.userPromptSubmitted[]? | select(.bash == "report-cmd")] | length) == 1)
    and (([.hooks.agentStop[]? | select(.bash == "report-cmd")] | length) == 1)
    and (([.hooks.sessionEnd[]? | select(.bash == "clear-cmd")] | length) == 1)
    and (.model == "claude-opus-5")
  ' "$settings" >/dev/null

  # --retire removes a bash-exact-match entry (collapsing the now-empty event
  # key), leaves Herdr's SessionStart entry and other callers' entries
  # untouched, and is a no-op when the target command isn't present.
  main "$settings" --retire \
    sessionEnd clear-cmd \
    --register
  main "$settings" --retire \
    agentStop report-cmd \
    --register \
    sessionStart new-report-cmd 10
  jq -e '
    ([.hooks.sessionEnd[]? | select(.bash == "clear-cmd")] | length) == 0
    and (([.hooks.userPromptSubmitted[]? | select(.bash == "report-cmd")] | length) == 1)
    and (([.hooks.sessionStart[]? | select(.bash == "new-report-cmd")] | length) == 1)
    and (([.hooks.SessionStart[]? | select(.bash == "herdr-existing")] | length) == 1)
  ' "$settings" >/dev/null
  # Retiring the only entry under an event key collapses that key entirely.
  jq -e '(.hooks | has("agentStop")) | not' "$settings" >/dev/null

  # The real caller (home/modules/claude.nix's bleep-hook cutover, #576)
  # repeats `--retire <event> <command>` once per pair rather than writing a
  # single leading `--retire` ahead of several bare pairs — main() must
  # accept that per-pair-prefixed shape and still register afterward (a
  # regression here previously shifted every subsequent arg by one, either
  # silently no-op'ing the register call or hitting an unbound-variable
  # error, #hms-arcturus-2026-09-29).
  main "$settings" \
    --retire userPromptSubmitted report-cmd \
    --retire sessionStart new-report-cmd \
    --register \
    userPromptSubmitted final-cmd 10
  jq -e '
    ([.hooks.userPromptSubmitted[]? | select(.bash == "report-cmd")] | length) == 0
    and (([.hooks.sessionStart[]? | select(.bash == "new-report-cmd")] | length) == 0)
    and (([.hooks.userPromptSubmitted[]? | select(.bash == "final-cmd")] | length) == 1)
    and (([.hooks.SessionStart[]? | select(.bash == "herdr-existing")] | length) == 1)
  ' "$settings" >/dev/null

  # An arg list that doesn't divide into whole register tuples is a usage
  # error (exit 2), not a silent no-op or an unbound-variable crash.
  local arity_settings arity_rc
  arity_settings="$tmp/arity.json"
  printf '{}\n' > "$arity_settings"
  if ( main "$arity_settings" sessionStart only-two-args ) 2>/dev/null; then
    arity_rc=0
  else
    arity_rc=$?
  fi
  [[ $arity_rc -eq 2 ]] || {
    printf 'FAIL: leftover arg count not a multiple of 3 should exit 2, got %d\n' "$arity_rc" >&2
    exit 1
  }

  printf 'selftest: OK\n'
}

if [[ ${1-} == --selftest ]]; then
  selftest
elif [[ ${2-} == --retire ]] || { [[ $# -ge 4 ]] && (( ($# - 1) % 3 == 0 )); }; then
  main "$@"
else
  printf 'usage: register-copilot-hooks <settings.json> [--retire <event> <bash-command>]... [--register] <event> <bash-command> <timeoutSec> [<event> <bash-command> <timeoutSec>]...\n' >&2
  exit 2
fi

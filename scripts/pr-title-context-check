#!/usr/bin/env bash
# pr-title-context-check — required check の context 文字列が、この run 自身の
# check 名と実際に一致しているかを required check(.github/workflows/
# pr-title.yml の最終 step)として検査する(ADR-0031 Amendment, 2026-09-26)。
#
# #337 の播きで、GitHub が reusable workflow の job に付ける check 名
# ("<呼び出し側 job の name> / <呼び出される job の name>")について
# 「呼び出し側 workflow の name」という誤った理論を基に required check
# context "PR Title / PR title" を ruleset に登録し、テンプレート側の
# job に name: が無かったため実際の check 名は "check / PR title" になり、
# required check が永久に「報告されるのを待機中」のまま merge を止める
# 事故が起きた(telepath#243, bleep#33 で実測)。「最初の PR で Checks タブを
# 目視確認する」という手動手順だけがこの不一致を検出する手段だったが、
# その手順自体が飛ばされた。
#
# このスクリプトは、呼び出し元の run のたびに自分自身の check 名を
# Actions API から実測し、有効な branch ruleset の required_status_checks
# と自己照合する — 手動確認を実行時の自動検査に置き換える。判定ロジックは
# 新設しない: repos/{owner}/{repo}/actions/runs/{run_id}/jobs と
# repos/{owner}/{repo}/rules/branches/{branch} を直接読むだけの薄い層で、
# scripts/github-audit の fetch_run_job_names() を source して再利用する
# (ADR-0035 D1「単一正本 > 複写+同期」、scripts/pr-merge-settings-check と
# 同じ構造)。
#
# audit(手動実行、検出のみ)とは違い、このスクリプトは required check の
# 一部として fail-closed — 自分自身の check 名の取得に失敗した場合も red
# にする。
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./github-audit
source "$SCRIPT_DIR/github-audit"

usage() {
  cat <<'EOF'
usage: pr-title-context-check <owner>/<repo> <run_id> <default_branch>
       pr-title-context-check --selftest

<run_id> の run が報告した「PR title」ジョブの check 名(「<job の name>」
または「<caller job の name> / PR title」)を実測し、<default_branch> に
有効な branch ruleset の required_status_checks と照合する。

- required 側に「PR title」を含む context があり、実測した check 名と
  完全一致するものが無ければ non-zero(fail-closed)。
- required 側に「PR title」を含む context が無ければ、まだ ruleset が
  この check を要求していないだけなので warning のみで exit 0
  (github-audit titles ドメインの pr-title-check-not-required が担当)。
- 自分自身の check 名の取得に失敗した場合(0 件 or 多義的)も non-zero。
EOF
}

# $1=repo $2=run_id -> このrunの「PR title」ジョブの実際のcheck名(1件)。
# 0件・取得失敗はexit 1、2件以上は in_progress に絞ってなお複数ならexit 1。
resolve_self_job_name() {
  local repo="$1" run_id="$2" jobs candidates n
  jobs="$(fetch_run_job_names "$repo" "$run_id")"
  if [[ -z "$jobs" || "$jobs" == "[]" ]]; then
    printf 'pr-title-context-check: run %s の jobs を取得できませんでした\n' "$run_id" >&2
    return 1
  fi

  candidates="$(jq -c '[.[] | select(. == "PR title" or endswith(" / PR title"))]' <<<"$jobs")"
  n="$(jq 'length' <<<"$candidates")"

  if [[ "$n" == 0 ]]; then
    printf 'pr-title-context-check: run %s に "PR title" ジョブが見つかりません(jobs=%s)\n' \
      "$run_id" "$jobs" >&2
    return 1
  elif [[ "$n" == 1 ]]; then
    jq -r '.[0]' <<<"$candidates"
    return 0
  fi

  # 2件以上 — in_progress に絞って再判定(このジョブ自身が走っている run
  # では他の同名候補が queued/completed で混在することがある想定への保険)。
  local in_progress
  in_progress="$(jq -c --argjson names "$candidates" '
    [.[] | select(.status == "in_progress" and (.name as $n | $names | index($n) != null)) | .name]
    | unique
  ' <<<"$jobs")"
  n="$(jq 'length' <<<"$in_progress")"
  if [[ "$n" == 1 ]]; then
    jq -r '.[0]' <<<"$in_progress"
    return 0
  fi

  printf 'pr-title-context-check: run %s の "PR title" ジョブ候補が複数あり一意に絞れません(candidates=%s)\n' \
    "$run_id" "$candidates" >&2
  return 1
}

# $1=repo $2=branch -> required_status_checks の context 配列(JSON)
fetch_required_pr_title_contexts() {
  local repo="$1" branch="$2" rules
  rules="$("$GH_BIN" api "repos/$OWNER/$repo/rules/branches/$branch" 2>/dev/null)" || rules=''
  if [[ -z "$rules" ]]; then
    printf ''
    return 1
  fi
  jq -c '[.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[]?.context
    | select(test(" PR title$") or . == "PR title")]' <<<"$rules"
}

check_run() { # $1=owner/repo $2=run_id $3=default_branch -> exit 0/1
  local owner_repo="$1" run_id="$2" branch="$3" repo self_name required n
  OWNER="${owner_repo%%/*}"
  repo="${owner_repo#*/}"

  self_name="$(resolve_self_job_name "$repo" "$run_id")" || return 1

  required="$(fetch_required_pr_title_contexts "$repo" "$branch")"
  if [[ -z "$required" ]]; then
    printf 'pr-title-context-check: %s の branch ruleset 取得に失敗しました(fail-closed で red にします)\n' \
      "$owner_repo" >&2
    return 1
  fi

  n="$(jq 'length' <<<"$required")"
  if [[ "$n" == 0 ]]; then
    printf '::warning::pr-title-context-check: %s の branch ruleset に PR title 系の required check がまだ登録されていません(github-audit titles の pr-title-check-not-required が該当)。この check の実際の名前は "%s" です。\n' \
      "$owner_repo" "$self_name"
    return 0
  fi

  if jq -e --arg n "$self_name" 'index($n) != null' <<<"$required" >/dev/null; then
    printf 'pr-title-context-check: %s OK — required check context "%s" と実際の check 名が一致\n' \
      "$owner_repo" "$self_name"
    return 0
  fi

  printf 'pr-title-context-check: %s の required check context が実際の check 名と一致しません。\n' \
    "$owner_repo" >&2
  printf '  ruleset が要求する context: %s\n' "$(jq -r '. | join(", ")' <<<"$required")" >&2
  printf '  この check が実際に報告する名前: %s\n' "$self_name" >&2
  printf '  呼び出し側 job の name: を required context に合わせるか、ruleset の context を修正してください。\n' >&2
  return 1
}

selftest() {
  local fails=0 tmp

  check() { # $1=名前 $2=owner/repo $3=run_id $4=branch $5=jobs-json $6=rules-json $7=期待exit $8=期待するstderrの文字列(空可)
    local name="$1" owner_repo="$2" run_id="$3" branch="$4" jobs_json="$5" rules_json="$6" want="$7" grep_for="${8:-}"
    local repo="${owner_repo#*/}" rc=0
    mkdir -p "$tmp/fixtures"
    printf '%s' "$jobs_json" >"$tmp/fixtures/repos_${owner_repo//\//_}_actions_runs_${run_id}_jobs.json"
    printf '%s' "$rules_json" >"$tmp/fixtures/repos_${owner_repo//\//_}_rules_branches_${branch}.json"
    check_run "$owner_repo" "$run_id" "$branch" >"$tmp/out.log" 2>"$tmp/err.log" || rc=$?
    if [[ "$rc" != "$want" ]]; then
      echo "FAIL $name (expected rc=$want got rc=$rc)" >&2
      cat "$tmp/out.log" "$tmp/err.log" >&2
      fails=$((fails + 1))
      return
    fi
    if [[ -n "$grep_for" ]] && ! grep -qF "$grep_for" "$tmp/out.log" "$tmp/err.log"; then
      echo "FAIL $name (expected output to contain: $grep_for)" >&2
      cat "$tmp/out.log" "$tmp/err.log" >&2
      fails=$((fails + 1))
      return
    fi
    echo "ok   $name"
  }

  tmp="$(mktemp -d)"
  mkdir -p "$tmp/bin" "$tmp/fixtures"

  # github-audit の selftest と同じ gh スタブ規則(path→file, '/' を '_' に、
  # '?' 以下は付けない呼び方に統一する)。
  cat >"$tmp/bin/gh" <<'STUB'
#!/usr/bin/env bash
# github-audit / pr-title-context-check が使う `gh api <path> [--jq FILTER]
# [-X METHOD] [-F key=value]` の呼び方を模擬する。実 gh は --jq をクライアント
# 側で fixture の JSON に適用してから返すので、ここでも同じことをする
# (fetch_run_job_names() 等は --jq でサーバ側の生レスポンスを絞っている
# 前提のため、このスタブが --jq を無視すると生 JSON がそのまま漏れて
# 呼び出し側の jq 処理が壊れる)。
set -euo pipefail
dir="$(dirname "$0")"
fixtures="$dir/../fixtures"
if [[ -f "$dir/fail" ]]; then
  exit 1
fi
[[ "$1" == api ]] || exit 1
shift
path="$1"
shift
jqfilter=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --jq)
      jqfilter="$2"
      shift 2
      ;;
    -X | -F)
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done
key="$(printf '%s' "$path" | tr '/' '_')"
[[ -f "$fixtures/$key.json" ]] || exit 1
if [[ -n "$jqfilter" ]]; then
  jq -c "$jqfilter" "$fixtures/$key.json"
else
  cat "$fixtures/$key.json"
fi
STUB
  chmod +x "$tmp/bin/gh"
  GH_BIN="$tmp/bin/gh"

  check "1 一致" "tarotene/all-ok" "1" "main" \
    '{"jobs":[{"name":"PR Title / PR title","status":"completed"}]}' \
    '[{"type":"required_status_checks","parameters":{"required_status_checks":[{"context":"PR Title / PR title"},{"context":"Format check"}]}}]' \
    0 'OK'

  check "2 不一致(呼び出し側 job に name: が無い旧テンプレート)" "tarotene/unnamed-caller" "2" "main" \
    '{"jobs":[{"name":"check / PR title","status":"completed"}]}' \
    '[{"type":"required_status_checks","parameters":{"required_status_checks":[{"context":"PR Title / PR title"}]}}]' \
    1 '一致しません'

  check "3 未要求(ruleset に PR title 系が無い — まだ播いていない)" "tarotene/not-required-yet" "3" "main" \
    '{"jobs":[{"name":"PR Title / PR title","status":"completed"}]}' \
    '[{"type":"required_status_checks","parameters":{"required_status_checks":[{"context":"Format check"}]}}]' \
    0 'warning'

  check "4 dotfiles 自己適用(接尾辞なしの単一名「PR title」)" "tarotene/dotfiles" "4" "main" \
    '{"jobs":[{"name":"PR title","status":"completed"}]}' \
    '[{"type":"required_status_checks","parameters":{"required_status_checks":[{"context":"PR title"}]}}]' \
    0 'OK'

  # このスクリプトは自分自身(tarotene/dotfiles/.github/workflows/
  # pr-title.yml の呼び出される job、常に name: "PR title")の check 名を
  # 実測するため、旧型の別 PR タイトル検査ワークフローの job は
  # そもそもこの run に存在しえない — その不一致は github-audit の
  # judge_titles() $3(ground truth 突き合わせ)側でテスト済み。ここでは
  # 代わりに、run に無関係な他ジョブが混ざっていても自分自身を正しく
  # 選び出せることを確認する。
  check "5 無関係な他ジョブが同じrunに混ざっていても自分を選べる" "tarotene/other-jobs-mixed" "5" "main" \
    '{"jobs":[{"name":"nix flake check","status":"completed"},{"name":"PR Title / PR title","status":"completed"},{"name":"Shell script validation","status":"completed"}]}' \
    '[{"type":"required_status_checks","parameters":{"required_status_checks":[{"context":"PR Title / PR title"}]}}]' \
    0 'OK'

  check "6 jobs 0件(取得失敗)" "tarotene/no-jobs" "6" "main" \
    '{"jobs":[]}' \
    '[{"type":"required_status_checks","parameters":{"required_status_checks":[{"context":"PR Title / PR title"}]}}]' \
    1 ''

  check "7 候補複数(あいまい)" "tarotene/ambiguous" "7" "main" \
    '{"jobs":[{"name":"check / PR title","status":"completed"},{"name":"other / PR title","status":"completed"}]}' \
    '[{"type":"required_status_checks","parameters":{"required_status_checks":[{"context":"PR Title / PR title"}]}}]' \
    1 ''

  touch "$tmp/bin/fail"
  check "8 ruleset 取得失敗(fail-closed)" "tarotene/unreachable" "8" "main" \
    '{"jobs":[{"name":"PR Title / PR title","status":"completed"}]}' \
    '[]' \
    1 ''
  rm -f "$tmp/bin/fail"

  # --- D3-3: テンプレートと quality.json の整合性(dotfiles 自身のファイルを直接読む) ---
  check_consistency

  rm -rf "$tmp"
  [[ "$fails" == 0 ]] && printf 'selftest: all passed\n'
  return "$fails"
}

# D3-3: common テンプレートの呼び出し側 job name + reusable job name の連結が
# 4つのquality.json(rust/typst/astro/repo-governance-common)の
# required_status_checks context と一致し、かつ dotfiles 自身の
# rulesets/quality.json の context が reusable job の name と一致することを
# 検査する。テンプレート/quality.json はリポジトリのソースそのものであり、
# fixture ではなく実ファイルを直接読む(pr-title.yml の sparse checkout 内
# では走らない選択、この step は selftest 経由でのみ実行される)。
check_consistency() {
  local repo_root common_job caller_job connected want_files ok=true
  repo_root="$(cd "$SCRIPT_DIR/.." && pwd)"
  # ネットワーク・GitHub API 不要な純ローカル検査のため、gh を呼ぶ他の
  # チェックとは独立した fails カウンタを使わず、直接標準出力に ok/FAIL を書く。

  common_job="$(sed -n 's/^ *name: *//p' \
    "$repo_root/config/claude/skills/repo-governance-common/templates/.github/workflows/pr-title.yml" | head -1)"
  caller_job="$(sed -n '/^jobs:/,$ { s/^ *name: *//p }' "$repo_root/.github/workflows/pr-title.yml" | head -1)"
  connected="${common_job} / ${caller_job}"

  want_files=(
    "config/claude/skills/rust-repo-governance/rulesets/quality.json"
    "config/claude/skills/typst-repo-governance/rulesets/quality.json"
    "config/claude/skills/astro-site-governance/rulesets/quality.json"
    "config/claude/skills/repo-governance-common/rulesets/quality.json"
  )
  local f
  for f in "${want_files[@]}"; do
    if jq -e --arg c "$connected" \
      '[.rules[]? | select(.type=="required_status_checks") | .parameters.required_status_checks[]?.context] | index($c) != null' \
      "$repo_root/$f" >/dev/null 2>&1; then
      echo "ok   consistency: $f has context \"$connected\""
    else
      echo "FAIL consistency: $f does not have context \"$connected\"" >&2
      ok=false
    fi
  done

  if jq -e --arg c "$caller_job" \
    '[.rules[]? | select(.type=="required_status_checks") | .parameters.required_status_checks[]?.context] | index($c) != null' \
    "$repo_root/rulesets/quality.json" >/dev/null 2>&1; then
    echo "ok   consistency: rulesets/quality.json has context \"$caller_job\""
  else
    echo "FAIL consistency: rulesets/quality.json does not have context \"$caller_job\"" >&2
    ok=false
  fi

  [[ "$ok" == true ]]
}

main() {
  case "${1:-}" in
    --selftest) selftest ;;
    -h | --help | '')
      usage
      [[ "${1:-}" == -h || "${1:-}" == --help ]]
      ;;
    *)
      if [[ $# -ne 3 ]]; then
        usage >&2
        return 2
      fi
      check_run "$1" "$2" "$3"
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi

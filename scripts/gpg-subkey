#!/usr/bin/env bash
# gpg-subkey — generate/rotate a machine-local ed25519/cv25519 [S]/[E]
# (signing/encryption) subkey under a card-backed primary key, monitor its
# expiry, and refresh this repo's committed public-key export.
#
# Absorbed from a now-archived private predecessor tool's
# generate-machine-subkey.sh / rotate-machine-subkey.sh (dotfiles GPG
# tooling review, 2026-09-19): that tool's `--command-file --expert
# --edit-key` batch mechanics for addkey/revkey are reused here (validated
# in production — the company identity's [S] subkey was rotated with it in
# 2025-12 and 2026-07), but its git-config-writing side effect is
# deliberately dropped. [E] support (#252, ADR-0003 Amendment 4) reuses the
# same addkey/revkey mechanics with a different menu choice (encrypt-only
# ECC instead of sign-only), validated against real GnuPG interactively
# (2026-09-20) before being encoded here.
# `home/modules/gpg.nix` header + `hosts/<host>.nix`'s
# `programs.git.signing.key` is the sole declared source of truth for which
# subkey Git signs with (ADR-0003) — this tool never touches git config, it
# only prints the next manual step.
#
# Usage:
#   gpg-subkey generate --key <primary-key> [--usage sign|encrypt] [--validity 1y] [--algorithm ed25519]
#   gpg-subkey rotate   --key <primary-key> [--usage sign|encrypt] [--validity 1y] [--revoke-old]
#   gpg-subkey revoke   --key <primary-key> --subkey <keyid>
#   gpg-subkey export   --repo <dotfiles-checkout> --identity <name>
#   gpg-subkey sync     --repo <dotfiles-checkout> --identity <name> [--fix] [--yes]
#   gpg-subkey status   [--repo <dotfiles-checkout>]
#   gpg-subkey remind   [--threshold 30] [--notify]
#   gpg-subkey --selftest
#
# generate/rotate need the card inserted: the primary key's own [C]
# (certify) capability signs the new subkey's binding signature, and that
# operation lives on the YubiKey (ADR-0003). --key accepts anything
# `gpg --list-secret-keys` resolves to exactly one primary key (a
# fingerprint, keyid, or email substring). --usage defaults to `sign` for
# backward compatibility; `encrypt` produces an encrypt-only cv25519 [E]
# subkey via the same addkey menu mechanics (menu choice 12 instead of 10 —
# both prompt the identical "which elliptic curve" follow-up, confirmed
# against real GnuPG 2.4.9, 2026-09-20).
#
# rotate's generate+revoke is the one irreversible step; everything after it
# — keys/<identity>.pub, GitHub's registered GPG key, keys.openpgp.org — is
# just a copy of local keyring state and can drift independently of it and
# of each other (this happened for real once already). `sync` detects that
# drift against the local keyring and, with --fix, converges every copy back
# to it; it is safe to re-run regardless of where a previous attempt
# stopped. It never edits hosts/<host>.nix — a mismatch there is reported,
# not fixed, same boundary `export` already draws.
#
# rotate NEVER revokes a card-backed subkey of the same usage, even if one
# exists alongside the on-disk one (#252, ADR-0003 Amendment 4 — [E]'s
# original card-backed subkey is deliberately kept live as a fallback/
# disaster-recovery path once an on-disk [E] takes over day-to-day
# decryption). Every "which subkey is currently active" resolution and every
# rotate revoke-candidate collection in this script is restricted to
# on-disk secret material (GnuPG `--with-colons` field 15 == "+", same test
# as config/claude/hooks/sign-prewarm.sh's key_is_on_disk) — card-backed
# (token serial) and stub (#) entries are never candidates.
set -euo pipefail

GPG_BIN="${GPG_SUBKEY_GPG_BIN:-gpg}"
HERDR_BIN="${GPG_SUBKEY_HERDR_BIN:-herdr}"
SELF="$(realpath "$0")"
DEFAULT_VALIDITY="1y"
DEFAULT_ALGORITHM="ed25519"
DEFAULT_USAGE="sign"
DEFAULT_THRESHOLD=30

# edit_key_extra_args — additional gpg flags for the --edit-key calls in
# _generate_on/_revoke_subkey. Empty in production: the real primary key's
# passphrase/PIN goes through the operator's configured pinentry
# (pinentry-gnome3 via home/modules/gpg.nix), interactively. --selftest sets
# GPG_SUBKEY_PINENTRY_MODE=loopback + GPG_SUBKEY_PASSPHRASE='' to unlock its
# throwaway empty-passphrase fixture key non-interactively — this switch
# never fires outside that fixture because both env vars stay unset otherwise.
edit_key_extra_args() {
  local -a args=()
  [[ -n ${GPG_SUBKEY_PINENTRY_MODE:-} ]] && args+=(--pinentry-mode "$GPG_SUBKEY_PINENTRY_MODE")
  [[ -v GPG_SUBKEY_PASSPHRASE ]] && args+=(--passphrase "$GPG_SUBKEY_PASSPHRASE")
  # `printf '%s\n' "${args[@]}"` with an EMPTY args array still runs once,
  # substituting "" for the unmet %s — i.e. it prints one blank line instead
  # of nothing. mapfile then turns that into extra=("") at the call site, an
  # empty-string positional argument that lands *before* --command-file on
  # gpg's command line and makes gpg stop recognizing every option after it
  # ("'--command-file' is not considered an option"). This is exactly the
  # production path (no GPG_SUBKEY_* env set), so the guard below is not
  # cosmetic — skip printf entirely when there is nothing to emit.
  ((${#args[@]} > 0)) && printf '%s\n' "${args[@]}"
  return 0
}

usage() {
  cat <<'EOF'
usage:
  gpg-subkey generate --key <primary-key> [--usage sign|encrypt] [--validity 1y] [--algorithm ed25519]
  gpg-subkey rotate   --key <primary-key> [--usage sign|encrypt] [--validity 1y] [--revoke-old]
  gpg-subkey revoke   --key <primary-key> --subkey <keyid>
  gpg-subkey export   --repo <dotfiles-checkout> --identity <name>
  gpg-subkey sync     --repo <dotfiles-checkout> --identity <name> [--fix] [--yes]
  gpg-subkey status   [--repo <dotfiles-checkout>]
  gpg-subkey remind   [--threshold 30] [--notify]
  gpg-subkey --selftest

generate/rotate require the card (the primary key's [C] capability signs the
new subkey). --usage defaults to sign ([S]); encrypt produces an [E]
encrypt-only subkey. rotate never revokes a card-backed subkey of the same
usage — only on-disk material is ever a revoke candidate. revoke is the
standalone form of that same on-disk-only revoke: use it to converge a
subkey that was already superseded without --revoke-old (or by a rotate
that failed partway) — the keyid to pass is whichever `status` still shows
as non-revoked but no longer the one hosts/<host>.nix declares. This tool
never writes git config — export/sync print the next manual step (update
programs.git.signing.key, PR, hms; for --usage encrypt, re-encrypt whatever
this identity's [E] protects, e.g. esa MCP's token.gpg). sync detects (and,
with --fix, converges) drift between the local keyring and keys/*.pub /
GitHub's registered GPG key ([S] only) / keys.openpgp.org ([S] and, once
present, [E]).
EOF
}

now_epoch() { date +%s; }

# days_until <expire_epoch> <now_epoch> — ceiling division; "" (no expiry) → "inf"
days_until() {
  local expire="$1" now="$2"
  [[ -n $expire && $expire != 0 ]] || {
    printf 'inf'
    return 0
  }
  printf '%d' $(((expire - now + 86399) / 86400))
}

# resolve_primary_key <selector> — echoes the fingerprint(s) matching the
# selector's primary key (one per line; callers reject anything but exactly
# one line as ambiguous/not-found).
resolve_primary_key() {
  local selector="$1"
  "$GPG_BIN" --list-secret-keys --with-colons --with-fingerprint "$selector" 2>/dev/null | awk -F: '
    $1 == "sec" { pending = 1; next }
    $1 == "fpr" && pending { print $10; pending = 0 }
  '
}

# primary_uid <fpr> — first uid line for that primary.
primary_uid() {
  local fpr="$1"
  "$GPG_BIN" --list-secret-keys --with-colons --with-fingerprint "$fpr" 2>/dev/null | awk -F: '
    $1 == "sec" { insec = 1; next }
    $1 == "uid" && insec { print $10; exit }
    $1 == "sec" || $1 == "pub" { insec = 0 }
  '
}

# usage_subkeys <cap-char> [selector] [on-disk] — TSV: primary_fpr,
# primary_uid, keyid, subkey_fpr, created_epoch, expire_epoch("" if none),
# revoked(0/1), capability_field (gpg's raw ssb capability string, e.g.
# "s"/"e"). Scans every secret primary when selector is empty. A non-empty
# 4th argument additionally restricts to on-disk secret material only
# (`--with-colons` field 15 == "+", GnuPG DETAILS doc; same判定 as
# sign-prewarm.sh's key_is_on_disk) — card-backed (token S/N) and stub (#)
# entries are excluded.
usage_subkeys() {
  local cap="$1" selector="${2:-}" ondisk_only="${3:-}"
  "$GPG_BIN" --list-secret-keys --with-colons --with-fingerprint ${selector:+"$selector"} 2>/dev/null | awk -F: -v capchar="$cap" -v ondisk_only="$ondisk_only" '
    $1 == "sec" { pfpr = ""; puid = ""; insec = 1; next }
    $1 == "fpr" && insec { pfpr = $10; insec = 0; next }
    $1 == "uid" && puid == "" { puid = $10; next }
    $1 == "ssb" {
      revoked = ($2 == "r") ? 1 : 0
      cap_field = $12
      created = $6
      expires = $7
      keyid = $5
      loc = $15
      cap_match = (index(cap_field, capchar) > 0)
      loc_match = (ondisk_only == "" || loc == "+")
      usage_pending = (cap_match && loc_match) ? 1 : 0
      next
    }
    $1 == "fpr" && usage_pending {
      print pfpr "\t" puid "\t" keyid "\t" $10 "\t" created "\t" expires "\t" revoked "\t" cap_field
      usage_pending = 0
    }
  '
}

# extract_latest_usage_keyid <cap-char> <primary-fpr-or-selector> — prints
# the keyid of the most-recently-created non-revoked ON-DISK subkey with
# that capability. `>=` (not `>`) so that two subkeys created within the
# same wall-clock second — generate immediately followed by rotate, both
# `date +%s`-resolution — break the tie toward whichever gpg listed last,
# i.e. the one actually added most recently.
#
# on-disk 限定の理由(#252, R1-B-1): 「現行」を card-backed/stub まで含めて
# 解決すると、generate/rotate 直後の新規鍵の特定を誤ったり、sync がカード
# 専用の [E] を「現行」と誤認したりする。card-backed な同一 usage の subkey
# (元 [E] 等)は意図して残置される既知の状態であり、これを「現行」扱いしない
# ことは設計そのもの(ADR-0003 Amendment 4)。
extract_latest_usage_keyid() {
  local cap="$1" selector="$2"
  usage_subkeys "$cap" "$selector" on-disk | awk -F'\t' '$7 == 0 { if ($5 >= max) { max = $5; keyid = $3 } } END { print keyid }'
}

# find_subkey_row <primary-fpr> <keyid> — TSV: keyid, revoked(0/1),
# capability_field, location(gpg's raw field 15: "+" on-disk, token S/N
# card-backed, "#" stub). Empty if no ssb with that keyid exists under the
# primary. Used by cmd_revoke, which needs a single specific subkey's row
# rather than usage_subkeys' capability-filtered listing.
find_subkey_row() {
  local fpr="$1" keyid="$2"
  "$GPG_BIN" --list-secret-keys --with-colons --with-fingerprint "$fpr" 2>/dev/null | awk -F: -v want="$keyid" '
    $1 == "ssb" && $5 == want {
      revoked = ($2 == "r") ? 1 : 0
      print $5 "\t" revoked "\t" $12 "\t" $15
    }
  '
}

# --- generate ---------------------------------------------------------------

cmd_generate() {
  local key="" validity="$DEFAULT_VALIDITY" algorithm="$DEFAULT_ALGORITHM" usage_kind="$DEFAULT_USAGE"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --key)
        key="$2"
        shift 2
        ;;
      --validity)
        validity="$2"
        shift 2
        ;;
      --algorithm)
        algorithm="$2"
        shift 2
        ;;
      --usage)
        usage_kind="$2"
        shift 2
        ;;
      *)
        printf 'gpg-subkey generate: 不明な引数 %s\n' "$1" >&2
        return 2
        ;;
    esac
  done
  [[ $algorithm == ed25519 ]] || {
    printf 'gpg-subkey generate: algorithm=%s は未対応(ed25519 のみ)\n' "$algorithm" >&2
    return 2
  }
  local cap addkey_choice
  case "$usage_kind" in
    sign)
      cap=s
      addkey_choice=10
      ;;
    encrypt)
      cap=e
      addkey_choice=12
      ;;
    *)
      printf 'gpg-subkey generate: usage=%s は未対応(sign|encrypt のみ)\n' "$usage_kind" >&2
      return 2
      ;;
  esac
  [[ -n $key ]] || {
    printf 'gpg-subkey generate: --key が必要です\n' >&2
    return 2
  }
  _generate_on "$key" "$validity" "$cap" "$addkey_choice"
}

# _generate_on <primary-selector> <validity> <cap-char> <addkey-menu-choice>
# — resolves the selector, addkey's an ECC subkey via the validated
# command-file menu answers, and prints the new subkey's keyid on stdout.
# addkey-menu-choice 10 = "ECC (sign only)" → ed25519; 12 = "ECC (encrypt
# only)" → cv25519. Both prompt an identical "select elliptic curve" follow-
# up where choice 1 = "Curve 25519" — confirmed interactively against real
# GnuPG 2.4.9 (2026-09-20) before this menu digit was hardcoded here.
_generate_on() {
  local selector="$1" validity="$2" cap="$3" addkey_choice="$4" fpr candidates batch out new_keyid
  candidates="$(resolve_primary_key "$selector")"
  if [[ -z $candidates ]]; then
    printf 'gpg-subkey: --key %s に一致する秘密鍵がありません\n' "$selector" >&2
    return 1
  fi
  if [[ $(wc -l <<<"$candidates") -gt 1 ]]; then
    printf 'gpg-subkey: --key %s が複数の秘密鍵に一致しました。fingerprint で指定してください:\n' "$selector" >&2
    printf '%s\n' "$candidates" >&2
    return 1
  fi
  fpr="$candidates"
  printf 'gpg-subkey: primary=%s (%s) に [%s] subkey を追加します(YubiKey のタッチ/PIN が必要です)\n' \
    "$fpr" "$(primary_uid "$fpr")" "${cap^^}" >&2

  batch="$(mktemp)"
  printf 'addkey\n%s\n1\n%s\ny\nsave\nquit\n' "$addkey_choice" "$validity" >"$batch"

  # No `trap ... RETURN` here: a RETURN trap set inside a function is not
  # function-scoped in bash — it keeps firing on every subsequent function
  # return in the same call chain (including the caller's), tripping `set -u`
  # on a `$batch` that no longer exists once this function itself returns.
  # Explicit rm on every exit path avoids that entirely.
  local -a extra=()
  mapfile -t extra < <(edit_key_extra_args)
  out="$("$GPG_BIN" --batch "${extra[@]}" --command-file "$batch" --expert --edit-key "$fpr" 2>&1)"
  local rc=$?
  rm -f "$batch"
  if [[ $rc -ne 0 ]]; then
    printf '%s\n' "$out" >&2
    printf 'gpg-subkey: subkey 生成に失敗しました\n' >&2
    return 1
  fi

  new_keyid="$(extract_latest_usage_keyid "$cap" "$fpr")"
  [[ -n $new_keyid ]] || {
    printf 'gpg-subkey: 生成後の新しい [%s] subkey を特定できませんでした\n' "${cap^^}" >&2
    return 1
  }
  if [[ $cap == e ]]; then
    printf 'gpg-subkey: 次の手順(このツールはファイルには触れません): この identity の [E]\n' >&2
    printf '  で暗号化している対象(例: esa MCP の token.gpg)を、新しい [E] subkey %s\n' "$new_keyid" >&2
    printf '  宛に再暗号化してください(docs/claude/esa-mcp.md 参照)\n' >&2
  fi
  printf '%s\n' "$new_keyid"
}

# --- rotate ------------------------------------------------------------------

cmd_rotate() {
  local key="" validity="$DEFAULT_VALIDITY" revoke_old=false usage_kind="$DEFAULT_USAGE"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --key)
        key="$2"
        shift 2
        ;;
      --validity)
        validity="$2"
        shift 2
        ;;
      --revoke-old)
        revoke_old=true
        shift
        ;;
      --usage)
        usage_kind="$2"
        shift 2
        ;;
      *)
        printf 'gpg-subkey rotate: 不明な引数 %s\n' "$1" >&2
        return 2
        ;;
    esac
  done
  [[ -n $key ]] || {
    printf 'gpg-subkey rotate: --key が必要です\n' >&2
    return 2
  }
  local cap addkey_choice
  case "$usage_kind" in
    sign)
      cap=s
      addkey_choice=10
      ;;
    encrypt)
      cap=e
      addkey_choice=12
      ;;
    *)
      printf 'gpg-subkey rotate: usage=%s は未対応(sign|encrypt のみ)\n' "$usage_kind" >&2
      return 2
      ;;
  esac

  local fpr old_keyids new_keyid
  fpr="$(resolve_primary_key "$key")"
  [[ -n $fpr && $(wc -l <<<"$fpr") -eq 1 ]] || {
    printf 'gpg-subkey: --key %s が primary key を一意に特定できません\n' "$key" >&2
    return 1
  }
  # on-disk 限定(#252, R1-B-1): card-backed な同 usage の subkey(例: [E] の
  # カード上の元鍵)を revoke 対象に含めない。カード鍵の残置は設計そのもの
  # (ADR-0003 Amendment 4)であり、rotate が誤って失効させてはならない。
  old_keyids="$(usage_subkeys "$cap" "$fpr" on-disk | awk -F'\t' '$7 == 0 { print $3 }')"

  new_keyid="$(_generate_on "$fpr" "$validity" "$cap" "$addkey_choice")" || return 1
  printf '%s\n' "$new_keyid"

  # The new key is created either way — a revoke failure below must NOT be
  # swallowed into an overall success, or `rotate --revoke-old` silently
  # leaves two live [S] subkeys while claiming the rotation is done (this
  # gap shipped once already: _revoke_subkey used to `return 0` on failure,
  # so the loop below never noticed).
  local revoke_failed=0
  if [[ $revoke_old == true && -n $old_keyids ]]; then
    local old
    while IFS= read -r old; do
      [[ -n $old ]] || continue
      _revoke_subkey "$fpr" "$old" || revoke_failed=1
    done <<<"$old_keyids"
  elif [[ $revoke_old == true ]]; then
    printf 'gpg-subkey: revoke 対象の旧 on-disk [%s] subkey がありませんでした\n' "${cap^^}" >&2
  fi
  if [[ $revoke_failed == 1 ]]; then
    printf 'gpg-subkey: 新 subkey %s は生成済みですが、旧 subkey の revoke に失敗したものがあります(要手動確認: gpg-subkey status)\n' "$new_keyid" >&2
    return 1
  fi
}

_revoke_subkey() { # <primary-fpr> <subkey-keyid> [<reason-text>] — exit 0 revoked, 1 failed.
  local fpr="$1" keyid="$2" reason="${3:-gpg-subkey rotate}" batch out rc
  batch="$(mktemp)"
  printf 'key %s\nrevkey\ny\n0\n%s\n\ny\nsave\nquit\n' "$keyid" "$reason" >"$batch"
  local -a extra=()
  mapfile -t extra < <(edit_key_extra_args)
  out="$("$GPG_BIN" --batch "${extra[@]}" --command-file "$batch" --expert --edit-key "$fpr" 2>&1)"
  rc=$?
  rm -f "$batch"
  if [[ $rc -ne 0 ]]; then
    printf '%s\n' "$out" >&2
    printf 'gpg-subkey: 旧 subkey %s の revoke に失敗しました\n' "$keyid" >&2
    return 1
  fi
  printf 'gpg-subkey: 旧 subkey %s を revoke しました\n' "$keyid" >&2
}

# --- revoke (standalone) -----------------------------------------------------

# gpg-subkey revoke --key <primary-key> --subkey <keyid>
#
# rotate --revoke-old only revokes an old subkey in the same breath as
# generating its replacement. That leaves no way to converge a subkey that
# was already rotated past without --revoke-old (or a previous rotate that
# failed partway) without generating yet another new one just to trigger the
# revoke path — this command fills that gap directly.
cmd_revoke() {
  local key="" subkey=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --key)
        key="$2"
        shift 2
        ;;
      --subkey)
        subkey="$2"
        shift 2
        ;;
      *)
        printf 'gpg-subkey revoke: 不明な引数 %s\n' "$1" >&2
        return 2
        ;;
    esac
  done
  [[ -n $key && -n $subkey ]] || {
    printf 'gpg-subkey revoke: --key と --subkey が必要です\n' >&2
    return 2
  }

  local fpr
  fpr="$(resolve_primary_key "$key")"
  [[ -n $fpr && $(wc -l <<<"$fpr") -eq 1 ]] || {
    printf 'gpg-subkey: --key %s が primary key を一意に特定できません\n' "$key" >&2
    return 1
  }

  local row revoked loc
  row="$(find_subkey_row "$fpr" "$subkey")"
  [[ -n $row ]] || {
    printf 'gpg-subkey revoke: subkey %s が primary %s の下に見つかりません\n' "$subkey" "$fpr" >&2
    return 1
  }
  IFS=$'\t' read -r _ revoked _ loc <<<"$row"

  if [[ $revoked == 1 ]]; then
    printf 'gpg-subkey revoke: subkey %s は既に revoked です\n' "$subkey" >&2
    return 1
  fi
  # rotate と同じ on-disk 限定(#252, R1-B-1 の判定を踏襲): card-backed な
  # subkey の残置は ADR-0003 Amendment 4 の意図的な設計であり、このツールの
  # revoke 対象に含めない。
  if [[ $loc != "+" ]]; then
    printf 'gpg-subkey revoke: subkey %s は on-disk ではありません(card-backed/stub は rotate と同じくこのツールの revoke 対象外 — ADR-0003 Amendment 4 の意図的な残置設計)\n' "$subkey" >&2
    return 1
  fi

  _revoke_subkey "$fpr" "$subkey" "gpg-subkey revoke"
}

# --- export / sync ----------------------------------------------------------

# repo_identity_fpr <repo> <identity> — echoes keys/<identity>.pub's primary
# fingerprint, or nothing (with a message on stderr) if it can't be read.
repo_identity_fpr() {
  local repo="$1" identity="$2" pubfile fpr
  pubfile="$repo/keys/$identity.pub"
  [[ -f $pubfile ]] || {
    printf 'gpg-subkey: %s がありません\n' "$pubfile" >&2
    return 1
  }
  fpr="$("$GPG_BIN" --with-colons --show-keys "$pubfile" 2>/dev/null | awk -F: '
    $1 == "pub" { want = 1; next }
    $1 == "fpr" && want { print $10; exit }
  ')"
  [[ -n $fpr ]] || {
    printf 'gpg-subkey: %s から primary fingerprint を読めませんでした\n' "$pubfile" >&2
    return 1
  }
  printf '%s\n' "$fpr"
}

cmd_export() {
  local repo="" identity=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        repo="$2"
        shift 2
        ;;
      --identity)
        identity="$2"
        shift 2
        ;;
      *)
        printf 'gpg-subkey export: 不明な引数 %s\n' "$1" >&2
        return 2
        ;;
    esac
  done
  [[ -n $repo && -n $identity ]] || {
    printf 'gpg-subkey export: --repo と --identity が必要です\n' >&2
    return 2
  }
  local pubfile="$repo/keys/$identity.pub" fpr new_export new_keyid
  fpr="$(repo_identity_fpr "$repo" "$identity")" || return 1
  new_export="$("$GPG_BIN" --armor --export "$fpr" 2>/dev/null)"
  [[ -n $new_export ]] || {
    printf 'gpg-subkey export: %s のローカル鍵束から export できませんでした\n' "$fpr" >&2
    return 1
  }
  if [[ "$new_export" == "$(cat "$pubfile")" ]]; then
    printf 'gpg-subkey export: %s に変更はありません\n' "$pubfile"
  else
    printf '%s\n' "$new_export" >"$pubfile"
    printf 'gpg-subkey export: %s を更新しました\n' "$pubfile"
  fi
  new_keyid="$(extract_latest_usage_keyid s "$fpr")"
  printf '\n次の手順(このツールは git config / nix ファイルには触れません):\n'
  printf '  1. hosts/<host>.nix の programs.git.signing.key を %s に更新\n' "${new_keyid:-<subkey-id>}"
  printf '  2. commit → push → PR\n'
  printf '  3. hms でこのホストに適用\n'
}

# --- sync --------------------------------------------------------------
# `rotate` (local GnuPG generate+revoke) is the one truly irreversible step
# in a rotation; everything downstream of it — the repo's keys/*.pub export,
# GitHub's registered GPG key, keys.openpgp.org's published copy — is just a
# *copy* of that local state, and copies can drift independently (this
# shipped for real: `gh -f key=@file` silently mangled a re-upload, and the
# committed keys/personal.pub sat stale until noticed by hand). True
# cross-system atomicity across GnuPG + the GitHub API + an independent
# keyserver isn't achievable — there's no shared transaction coordinator —
# so `sync` takes the realistic alternative instead: detect drift against
# the local keyring (the source of truth) and converge every downstream copy
# back to it, safely re-runnable regardless of where a previous attempt
# stopped. `home/hosts/<host>.nix`'s `programs.git.signing.key` is reported
# only, never edited — same boundary `export` already draws.
#
# [S] と [E] で監査対象が違う(#252, ADR-0003 Amendment 4): GitHub の GPG
# 登録は署名検証用途なので [S] のみ照合する。hosts/*.nix の
# programs.git.signing.key も [S] の宣言専用。export(主鍵の armored 一括
# export)と keys.openpgp.org は [S]/[E] 両方を含む/照合する — 主鍵の export
# は元々両方のsubkeyを含むため usage で分岐する必要がない。on-disk [E] が
# まだ無いホスト(#252 ロールアウト前)では [E] 関連チェックを無音でスキップ
# する — カードのみの運用も引き続き妥当な状態のため。
cmd_sync() {
  local repo="" identity="" fix=false yes=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        repo="$2"
        shift 2
        ;;
      --identity)
        identity="$2"
        shift 2
        ;;
      --fix)
        fix=true
        shift
        ;;
      --yes)
        yes=true
        shift
        ;;
      *)
        printf 'gpg-subkey sync: 不明な引数 %s\n' "$1" >&2
        return 2
        ;;
    esac
  done
  [[ -n $repo && -n $identity ]] || {
    printf 'gpg-subkey sync: --repo と --identity が必要です\n' >&2
    return 2
  }
  local fpr
  fpr="$(repo_identity_fpr "$repo" "$identity")" || return 1

  local sign_active_keyid sign_active_fpr
  sign_active_keyid="$(extract_latest_usage_keyid s "$fpr")"
  [[ -n $sign_active_keyid ]] || {
    printf 'gpg-subkey sync: %s に有効な on-disk [S] subkey がありません\n' "$fpr" >&2
    return 1
  }
  sign_active_fpr="$(usage_subkeys s "$fpr" | awk -F'\t' -v k="$sign_active_keyid" '$3 == k { print $4; exit }')"

  local encrypt_active_keyid=""
  encrypt_active_keyid="$(extract_latest_usage_keyid e "$fpr")"

  # revoked の収集はロケーションで絞らない — 失効は保管場所(on-disk/card)に
  # 関わらず全掲載箇所へ反映されるべきであり、drift 検査の対象はそこにある。
  local -a sign_revoked_keyids=() encrypt_revoked_keyids=()
  local row_keyid row_revoked row_cap
  while IFS=$'\t' read -r _ _ row_keyid _ _ _ row_revoked row_cap; do
    [[ -n $row_keyid ]] || continue
    [[ $row_revoked == 1 ]] || continue
    case "$row_cap" in
      *s*) sign_revoked_keyids+=("$row_keyid") ;;
      *e*) encrypt_revoked_keyids+=("$row_keyid") ;;
    esac
  done < <(usage_subkeys s "$fpr"; usage_subkeys e "$fpr")

  local -a problems=()

  # 1. repo keys/<identity>.pub — 主鍵の armored export は [S]/[E] 両方を含む
  # ため、usage で分けず 1 回の比較で両方のドリフトを検出できる。
  local pubfile="$repo/keys/$identity.pub" current_export
  current_export="$("$GPG_BIN" --armor --export "$fpr" 2>/dev/null)"
  [[ "$current_export" == "$(cat "$pubfile" 2>/dev/null)" ]] || problems+=("export")

  # 2. GitHub — [S] のみ(GitHub の GPG 登録は署名検証用途)。one registration
  # per primary key, keyed by its short keyid.
  local primary_short gh_json gh_entry github_drift=false
  primary_short="${fpr: -16}"
  gh_json="$(gh api user/gpg_keys 2>/dev/null)" || gh_json=""
  if [[ -z $gh_json ]]; then
    printf 'gpg-subkey sync: GitHub API に到達できませんでした(gh 未認証/ネットワーク不通) — スキップ\n' >&2
  else
    gh_entry="$(jq -c --arg k "$primary_short" '[.[] | select(.key_id==$k)][0] // empty' <<<"$gh_json")"
    if [[ -z $gh_entry ]]; then
      github_drift=true
    else
      [[ "$(jq -r --arg k "$sign_active_keyid" '.subkeys[]? | select(.key_id==$k) | (.can_sign and (.revoked|not))' <<<"$gh_entry")" == true ]] || github_drift=true
      local rk
      for rk in "${sign_revoked_keyids[@]}"; do
        local rk_on_gh
        rk_on_gh="$(jq -r --arg k "$rk" '.subkeys[]? | select(.key_id==$k) | .revoked' <<<"$gh_entry")"
        [[ -z $rk_on_gh || $rk_on_gh == true ]] || github_drift=true
      done
    fi
    [[ $github_drift == false ]] || problems+=("github")
  fi

  # 3. keys.openpgp.org — [S] は必須、[E] はこのホストに on-disk [E] がある
  # 場合のみ検査対象に加える。via a temp file, not a shell variable: the VKS
  # response is binary OpenPGP key material, and `$(...)` command
  # substitution can corrupt binary data (embedded NULs, trailing-newline
  # stripping).
  local ks_file keyserver_drift=false
  ks_file="$(mktemp)"
  if ! curl -sf "https://keys.openpgp.org/vks/v1/by-fingerprint/$fpr" -o "$ks_file" 2>/dev/null || [[ ! -s $ks_file ]]; then
    keyserver_drift=true
  else
    local ks_colons
    ks_colons="$("$GPG_BIN" --show-keys --with-colons "$ks_file" 2>/dev/null)"
    grep -qF $'sub:u:' <(grep "$sign_active_keyid" <<<"$ks_colons") || keyserver_drift=true
    local rk
    for rk in "${sign_revoked_keyids[@]}"; do
      grep -qF $'sub:r:' <(grep "$rk" <<<"$ks_colons") || keyserver_drift=true
    done
    if [[ -n $encrypt_active_keyid ]]; then
      grep -qF $'sub:u:' <(grep "$encrypt_active_keyid" <<<"$ks_colons") || keyserver_drift=true
      for rk in "${encrypt_revoked_keyids[@]}"; do
        grep -qF $'sub:r:' <(grep "$rk" <<<"$ks_colons") || keyserver_drift=true
      done
    fi
  fi
  rm -f "$ks_file"
  [[ $keyserver_drift == false ]] || problems+=("keyserver")

  # 4. THIS host's hosts/<host>.nix only — [S] のみ、report-only、このツール
  # は nix ファイルには触れない。[S] は per-machine(ADR-0003 Amendment §1):
  # 第二のホストが同じ identity を共有していても(例: altair と
  # personal-pop)、そのホストは自分自身の独立した [S] subkey を持つのが
  # 期待される挙動であり、ここでの鍵束には存在すらしない — 「このマシン」の
  # $sign_active_fpr で他ホストの hosts/*.nix を全部チェックすると、単に
  # 別の(同様に正当な)subkey を持つだけの他ホストを毎回 stale と誤報する。
  # 「このホスト」の解決は scripts/hms.sh の resolve_host() と同じ規則:
  # dotfiles/host マーカー、無ければ `hostname`。
  local -a stale_hosts=()
  local this_host marker hf hf_key
  marker="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/host"
  if [[ -r $marker ]]; then
    this_host="$(head -n1 "$marker" | tr -d '[:space:]')"
  fi
  [[ -n ${this_host:-} ]] || this_host="$(hostname)"
  hf="$repo/home/hosts/$this_host.nix"
  if [[ -f $hf ]] && grep -qF "identities/${identity}.nix" "$hf"; then
    # sed, not `grep -oP`: BSD grep (darwin, where this script also runs
    # per home/modules/gpg.nix's launchd branch) has no -P.
    hf_key="$(sed -n 's/.*programs\.git\.signing\.key = "\([^"]*\)".*/\1/p' "$hf" | head -1)"
    [[ "$hf_key" == "$sign_active_fpr" ]] || stale_hosts+=("$hf")
  fi

  if [[ ${#problems[@]} -eq 0 && ${#stale_hosts[@]} -eq 0 ]]; then
    if [[ -n $encrypt_active_keyid ]]; then
      printf 'gpg-subkey sync: %s は同期済みです(現行 [S] subkey %s、現行 [E] subkey %s)\n' \
        "$identity" "$sign_active_keyid" "$encrypt_active_keyid"
    else
      printf 'gpg-subkey sync: %s は同期済みです(現行 [S] subkey %s)\n' "$identity" "$sign_active_keyid"
    fi
    return 0
  fi

  printf 'gpg-subkey sync: %s の drift:\n' "$identity"
  local p
  for p in "${problems[@]}"; do
    case "$p" in
      export) printf '  - keys/%s.pub がローカル鍵束より古い\n' "$identity" ;;
      github) printf '  - GitHub の GPG 登録が現行 [S] subkey %s を反映していない\n' "$sign_active_keyid" ;;
      keyserver)
        printf '  - keys.openpgp.org が現行 [S] subkey %s を反映していない可能性があります\n' "$sign_active_keyid"
        [[ -n $encrypt_active_keyid ]] && printf '  - keys.openpgp.org が現行 [E] subkey %s を反映していない可能性があります\n' "$encrypt_active_keyid"
        ;;
    esac
  done
  for hf in "${stale_hosts[@]}"; do
    printf '  - %s の programs.git.signing.key が現行 [S] subkey (%s) と異なる(手動更新が必要)\n' "$hf" "$sign_active_fpr"
  done

  [[ $fix == true ]] || return 1

  if [[ $yes != true ]]; then
    [[ -t 0 ]] || {
      printf 'gpg-subkey sync --fix: 非対話実行では --yes が必要です\n' >&2
      return 2
    }
    local answer=""
    read -r -p '上記のうち keys.pub/GitHub/keyserver を現行状態へ反映しますか? [y/N] ' answer
    [[ $answer == y || $answer == Y ]] || return 1
  fi

  local p
  for p in "${problems[@]}"; do
    case "$p" in
      export)
        printf '%s\n' "$current_export" >"$pubfile"
        printf 'gpg-subkey sync: %s を更新しました\n' "$pubfile"
        ;;
      github)
        if [[ -n $gh_json ]]; then
          local old_id
          old_id="$(jq -r --arg k "$primary_short" '[.[] | select(.key_id==$k)][0].id // empty' <<<"$gh_json")"
          [[ -n $old_id ]] && gh api -X DELETE "user/gpg_keys/$old_id" >/dev/null 2>&1
          local payload_file
          payload_file="$(mktemp)"
          jq -n --arg key "$current_export" '{armored_public_key: $key}' >"$payload_file"
          if gh api user/gpg_keys -X POST --input "$payload_file" >/dev/null 2>&1; then
            printf 'gpg-subkey sync: GitHub の GPG 登録を更新しました\n'
          else
            printf 'gpg-subkey sync: GitHub の GPG 登録更新に失敗しました\n' >&2
          fi
          rm -f "$payload_file"
        fi
        ;;
      keyserver)
        if "$GPG_BIN" --keyserver hkps://keys.openpgp.org --send-keys "$fpr" >/dev/null 2>&1; then
          printf 'gpg-subkey sync: keys.openpgp.org へ送信しました\n'
        else
          printf 'gpg-subkey sync: keys.openpgp.org への送信に失敗しました\n' >&2
        fi
        ;;
    esac
  done
  return 0
}

# --- status / remind -------------------------------------------------------

_status_rows() { # <repo-or-empty> → TSV rows([S]/[E] 両方), restricted to
  # keys/*.pub fingerprints when a repo is given, else every local secret key.
  local repo="$1" cap
  if [[ -z $repo ]]; then
    for cap in s e; do usage_subkeys "$cap" ""; done
    return 0
  fi
  local f fpr
  for f in "$repo"/keys/*.pub; do
    [[ -f $f ]] || continue
    fpr="$("$GPG_BIN" --with-colons --show-keys "$f" 2>/dev/null | awk -F: '
      $1 == "pub" { want = 1; next }
      $1 == "fpr" && want { print $10; exit }
    ')"
    [[ -n $fpr ]] || continue
    for cap in s e; do usage_subkeys "$cap" "$fpr"; done
  done
}

# _usage_label <cap-field> — maps gpg's raw capability string to the
# ADR-0003 bracket notation used throughout this repo's docs.
_usage_label() {
  case "$1" in
    *s*) printf '[S]' ;;
    *e*) printf '[E]' ;;
    *) printf '[%s]' "$1" ;;
  esac
}

cmd_status() {
  local repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        repo="$2"
        shift 2
        ;;
      *)
        printf 'gpg-subkey status: 不明な引数 %s\n' "$1" >&2
        return 2
        ;;
    esac
  done
  local now rows pfpr puid keyid _sfpr created expires revoked cap_field days found=0
  now="$(now_epoch)"
  rows="$(_status_rows "$repo")"
  [[ -n $rows ]] || {
    printf 'gpg-subkey status: [S]/[E] subkey が見つかりません\n'
    return 0
  }
  while IFS=$'\t' read -r pfpr puid keyid _sfpr created expires revoked cap_field; do
    [[ -n $keyid ]] || continue
    found=1
    days="$(days_until "$expires" "$now")"
    local label
    label="$(_usage_label "$cap_field")"
    if [[ $revoked == 1 ]]; then
      printf '%s (%s) sub=%s %s: revoked\n' "$puid" "$pfpr" "$keyid" "$label"
    elif [[ $days == inf ]]; then
      printf '%s (%s) sub=%s %s: 無期限\n' "$puid" "$pfpr" "$keyid" "$label"
    else
      printf '%s (%s) sub=%s %s: 残り %s 日\n' "$puid" "$pfpr" "$keyid" "$label" "$days"
    fi
  done <<<"$rows"
  [[ $found == 1 ]] || printf 'gpg-subkey status: [S]/[E] subkey が見つかりません\n'
}

cmd_remind() {
  local threshold="$DEFAULT_THRESHOLD" notify=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --threshold)
        threshold="$2"
        shift 2
        ;;
      --notify)
        notify=true
        shift
        ;;
      *)
        printf 'gpg-subkey remind: 不明な引数 %s\n' "$1" >&2
        return 2
        ;;
    esac
  done
  local now rows pfpr puid keyid _sfpr created expires revoked cap_field days
  local -a due=()
  now="$(now_epoch)"
  rows="$(usage_subkeys s ""; usage_subkeys e "")"
  while IFS=$'\t' read -r pfpr puid keyid _sfpr created expires revoked cap_field; do
    [[ -n $keyid ]] || continue
    [[ $revoked == 0 ]] || continue
    days="$(days_until "$expires" "$now")"
    [[ $days == inf ]] && continue
    if ((days <= threshold)); then
      due+=("${puid} sub=${keyid} $(_usage_label "$cap_field") 残り${days}日で失効")
    fi
  done <<<"$rows"
  [[ ${#due[@]} -gt 0 ]] || {
    printf 'gpg-subkey remind: %s 日以内に失効する [S]/[E] subkey はありません\n' "$threshold"
    return 0
  }
  local line
  for line in "${due[@]}"; do
    printf 'gpg-subkey remind: %s\n' "$line" >&2
  done
  if [[ $notify == true ]]; then
    local body
    body="$(printf '%s\n' "${due[@]}")"
    "$HERDR_BIN" notification show "GPG [S]/[E] subkey の失効が近づいています" --body "${body:0:230}" --sound request >/dev/null 2>&1 || true
  fi
  return 1
}

# --- selftest ----------------------------------------------------------------
# Exercises real GnuPG operations (generate/rotate/status/remind/export)
# against a throwaway, empty-passphrase primary key in an isolated GNUPGHOME —
# not stubbed, since the addkey/revkey command-file mechanics are exactly
# what needs validating (same "real operations in a fixture dir" precedent
# as scripts/git-audit-worktrees' --selftest uses real git repos). The one
# exception is the on-disk/card-backed filter regression test (#252,
# R1-B-1): a real smartcard can't be faked in a fixture, so that check feeds
# synthetic `--with-colons` text through a stub gpg binary instead — the
# same technique config/claude/hooks/sign-prewarm.sh's --selftest already
# uses for its own card/stub/on-disk field-15 coverage.
selftest() {
  local dir fail=0
  dir="$(mktemp -d)"
  # Double-quoted so $dir is substituted into the trap command *now*: an EXIT
  # trap fires at actual process exit, long after this function's `local dir`
  # has gone out of scope, so a single-quoted 'rm -rf "$dir"' would resolve
  # $dir against nothing and trip `set -u` (the same class of bug fixed above
  # for _generate_on/_revoke_subkey's now-removed RETURN traps).
  # shellcheck disable=SC2064
  trap "rm -rf '$dir'" EXIT
  export GNUPGHOME="$dir/gnupg"
  mkdir -m 700 "$dir/gnupg"
  printf 'allow-loopback-pinentry\n' >"$dir/gnupg/gpg-agent.conf"
  # Loopback + an empty passphrase unlocks the fixture key non-interactively;
  # see edit_key_extra_args' header comment for why this never leaks into
  # the production generate/rotate path.
  export GPG_SUBKEY_PINENTRY_MODE=loopback
  export GPG_SUBKEY_PASSPHRASE=''
  "$GPG_BIN" --batch --passphrase '' --pinentry-mode loopback \
    --quick-generate-key 'Selftest <selftest@example.invalid>' ed25519 cert never >/dev/null 2>&1
  local fpr
  fpr="$("$GPG_BIN" --list-secret-keys --with-colons --with-fingerprint | awk -F: '
    $1 == "sec" { pending = 1; next }
    $1 == "fpr" && pending { print $10; exit }
  ')"

  check() { # check <name> <expected> <actual>
    if [[ "$2" == "$3" ]]; then
      printf 'ok   %s\n' "$1"
    else
      printf 'FAIL %s (expected [%s], got [%s])\n' "$1" "$2" "$3" >&2
      fail=1
    fi
  }
  # generate/rotate call gpg --edit-key non-interactively; pinentry loopback
  # with an empty passphrase needs no GPG_TTY, but --pinentry-mode ask is
  # never used by this script's own gpg calls (only by the real production
  # path via the operator's configured agent), so nothing here depends on a
  # terminal.

  # Regression check for the production path specifically: with neither
  # GPG_SUBKEY_PINENTRY_MODE nor GPG_SUBKEY_PASSPHRASE set,
  # edit_key_extra_args must emit nothing at all — this is the exact branch
  # every other check below never exercises (both are exported above for the
  # fixture key), and the one that broke real usage in production.
  local -a prod_extra=()
  (
    unset GPG_SUBKEY_PINENTRY_MODE GPG_SUBKEY_PASSPHRASE
    edit_key_extra_args
  ) >"$dir/prod-extra.out" 2>&1
  mapfile -t prod_extra <"$dir/prod-extra.out"
  check "edit_key_extra_args: 本番(env未設定)では空配列" 0 "${#prod_extra[@]}"

  local first_keyid
  first_keyid="$(_generate_on "$fpr" 1d s 10 2>"$dir/generate.err")" || {
    printf 'FAIL generate: %s\n' "$(cat "$dir/generate.err")" >&2
    exit 1
  }
  check "generate: 新しい keyid を出力する" 1 "$([[ -n $first_keyid ]] && echo 1 || echo 0)"

  local rows count
  rows="$(usage_subkeys s "$fpr")"
  count="$(wc -l <<<"$rows" | tr -d ' ')"
  check "generate 後: [S] subkey が 1 本" 1 "$count"

  local status_out
  status_out="$(cmd_status)"
  check "status: 生成した subkey を含む" 1 "$(grep -qF "$first_keyid" <<<"$status_out" && echo 1 || echo 0)"
  check "status: [S] ラベルを付ける" 1 "$(grep -qF "sub=$first_keyid [S]:" <<<"$status_out" && echo 1 || echo 0)"

  local remind_rc=0
  cmd_remind --threshold 2 >/dev/null 2>"$dir/remind.err" || remind_rc=$?
  check "remind: 閾値内なら exit 1" 1 "$remind_rc"
  cmd_remind --threshold 0 >/dev/null 2>&1
  check "remind: 閾値外(0日)なら exit 0" 0 $?

  # export: seed keys/selftest.pub with the pre-rotation state (what a
  # committed dotfiles checkout would still have), so the export step below
  # has a genuine diff to report against the post-rotation keyring.
  mkdir -p "$dir/repo/keys"
  "$GPG_BIN" --armor --export "$fpr" >"$dir/repo/keys/selftest.pub"

  local second_keyid rotate_out
  rotate_out="$(cmd_rotate --key "$fpr" --validity 1d --revoke-old 2>"$dir/rotate.err")" || {
    printf 'FAIL rotate: %s\n' "$(cat "$dir/rotate.err")" >&2
    exit 1
  }
  second_keyid="$(head -1 <<<"$rotate_out")"
  check "rotate: 新しい keyid は generate と異なる" 1 "$([[ $second_keyid != "$first_keyid" ]] && echo 1 || echo 0)"

  rows="$(usage_subkeys s "$fpr")"
  local old_revoked
  old_revoked="$(awk -F'\t' -v k="$first_keyid" '$3 == k { print $7 }' <<<"$rows")"
  check "rotate --revoke-old: 旧 [S] subkey が revoked=1" 1 "$old_revoked"

  local export_out
  export_out="$(cmd_export --repo "$dir/repo" --identity selftest)"
  check "export: 更新を報告する" 1 "$(grep -qF '更新しました' <<<"$export_out" && echo 1 || echo 0)"
  check "export: 新 subkey の次手順を印刷する" 1 "$(grep -qF "$second_keyid" <<<"$export_out" && echo 1 || echo 0)"

  export_out="$(cmd_export --repo "$dir/repo" --identity selftest)"
  check "export: 変更なしなら再実行で no-op" 1 "$(grep -qF '変更はありません' <<<"$export_out" && echo 1 || echo 0)"

  # --- [E] カバレッジ(#252) --------------------------------------------
  echo "[E] usage カバレッジ:"

  local e_first_keyid
  e_first_keyid="$(cmd_generate --key "$fpr" --usage encrypt --validity 1d 2>"$dir/generate-e.err")" || {
    printf 'FAIL generate --usage encrypt: %s\n' "$(cat "$dir/generate-e.err")" >&2
    exit 1
  }
  check "generate --usage encrypt: 新しい keyid を出力する" 1 "$([[ -n $e_first_keyid ]] && echo 1 || echo 0)"
  check "generate --usage encrypt: 次手順(再暗号化)を案内する" 1 \
    "$(grep -qF "$e_first_keyid" "$dir/generate-e.err" && echo 1 || echo 0)"

  rows="$(usage_subkeys e "$fpr")"
  count="$(wc -l <<<"$rows" | tr -d ' ')"
  check "generate --usage encrypt 後: [E] subkey が 1 本" 1 "$count"

  status_out="$(cmd_status)"
  check "status: [E] subkey も報告する" 1 "$(grep -qF "sub=$e_first_keyid [E]:" <<<"$status_out" && echo 1 || echo 0)"

  local e_second_keyid rotate_e_out
  rotate_e_out="$(cmd_rotate --key "$fpr" --usage encrypt --validity 1d --revoke-old 2>"$dir/rotate-e.err")" || {
    printf 'FAIL rotate --usage encrypt: %s\n' "$(cat "$dir/rotate-e.err")" >&2
    exit 1
  }
  e_second_keyid="$(head -1 <<<"$rotate_e_out")"
  check "rotate --usage encrypt: 新しい keyid は generate と異なる" 1 \
    "$([[ $e_second_keyid != "$e_first_keyid" ]] && echo 1 || echo 0)"

  rows="$(usage_subkeys e "$fpr")"
  old_revoked="$(awk -F'\t' -v k="$e_first_keyid" '$3 == k { print $7 }' <<<"$rows")"
  check "rotate --usage encrypt --revoke-old: 旧 on-disk [E] subkey が revoked=1" 1 "$old_revoked"

  local s_after_e
  s_after_e="$(extract_latest_usage_keyid s "$fpr")"
  check "encrypt の rotate は [S] の現行 subkey に影響しない" "$second_keyid" "$s_after_e"

  # --- on-disk フィルタの回帰(#252, R1-B-1) ------------------------------
  # 実カードは fixture 内で偽装できないため、合成した --with-colons 出力を
  # スタブ gpg 経由で usage_subkeys/extract_latest_usage_keyid に直接通し、
  # card-backed な subkey が「現行」判定にも revoke 候補にも入らないことを
  # 検証する(sign-prewarm.sh --selftest の card/stub 合成入力と同じ手法)。
  echo "on-disk フィルタ(合成 card-backed 入力、R1-B-1):"

  cat >"$dir/list-mixed-e.txt" <<'EOF'
sec:u:255:22:AAAAAAAAAAAAAAAA:1753115795:::u:::scESCA:::D2760001240100000006246379980000::ed25519:::0:
fpr:::::::::92E7B05978F0FE4E5500F6F76CFC837175BE257E:
ssb:u:255:18:CARDEEEEEEEEEEEE:1753115911:1784651911:::::e:::D2760001240100000006246379980000::cv25519::
fpr:::::::::CARDCARDCARDCARDCARDCARDCARDCARDCARDEEEE:
ssb:u:255:18:DISKEEEEEEEEEEEE:1783930808:1815466808:::::e:::+::cv25519::
fpr:::::::::57B25182FB450B06570860488608A3F925E329CC:
EOF
  mkdir -p "$dir/bin"
  cat >"$dir/bin/gpg-list-stub" <<'STUB'
#!/usr/bin/env bash
case "$*" in
  *--list-secret-keys*) cat "$GPG_SUBKEY_TEST_LIST_FILE" ;;
  *) exit 1 ;;
esac
STUB
  chmod +x "$dir/bin/gpg-list-stub"

  local mixed_all mixed_ondisk
  mixed_all="$(GPG_BIN="$dir/bin/gpg-list-stub" GPG_SUBKEY_TEST_LIST_FILE="$dir/list-mixed-e.txt" usage_subkeys e "")"
  check "on-disk フィルタなし: card/disk 両方の [E] を含む(2行)" 2 "$(grep -c . <<<"$mixed_all")"

  mixed_ondisk="$(GPG_BIN="$dir/bin/gpg-list-stub" GPG_SUBKEY_TEST_LIST_FILE="$dir/list-mixed-e.txt" usage_subkeys e "" on-disk)"
  check "on-disk フィルタあり: card-backed [E] を除外する(1行)" 1 "$(grep -c . <<<"$mixed_ondisk")"
  check "on-disk フィルタあり: 残る行は on-disk keyid" 1 "$(grep -qF 'DISKEEEEEEEEEEEE' <<<"$mixed_ondisk" && echo 1 || echo 0)"
  check "on-disk フィルタあり: card keyid は含まれない" 0 "$(grep -qF 'CARDEEEEEEEEEEEE' <<<"$mixed_ondisk" && echo 1 || echo 0)"

  local mixed_active
  mixed_active="$(GPG_BIN="$dir/bin/gpg-list-stub" GPG_SUBKEY_TEST_LIST_FILE="$dir/list-mixed-e.txt" extract_latest_usage_keyid e "")"
  check "extract_latest_usage_keyid: card-backed を「現行」として解決しない" "DISKEEEEEEEEEEEE" "$mixed_active"

  # --- revoke (standalone) ------------------------------------------------
  echo "revoke (standalone):"

  local third_keyid
  third_keyid="$(cmd_generate --key "$fpr" --validity 1d 2>"$dir/generate-3.err")" || {
    printf 'FAIL generate(revoke 用): %s\n' "$(cat "$dir/generate-3.err")" >&2
    exit 1
  }

  local revoke_out revoke_rc=0
  revoke_out="$(cmd_revoke --key "$fpr" --subkey "$third_keyid" 2>&1)" || revoke_rc=$?
  check "revoke: 単独実行は exit 0" 0 "$revoke_rc"
  check "revoke: revoke した keyid を報告する" 1 "$(grep -qF "$third_keyid" <<<"$revoke_out" && echo 1 || echo 0)"

  rows="$(usage_subkeys s "$fpr")"
  check "revoke: 対象 subkey が revoked=1 になる" 1 \
    "$(awk -F'\t' -v k="$third_keyid" '$3 == k { print $7 }' <<<"$rows")"
  check "revoke: 現行 [S] subkey ($second_keyid) には影響しない" 0 \
    "$(awk -F'\t' -v k="$second_keyid" '$3 == k { print $7 }' <<<"$rows")"

  local revoke_again_rc=0
  cmd_revoke --key "$fpr" --subkey "$third_keyid" >/dev/null 2>"$dir/revoke-again.err" || revoke_again_rc=$?
  check "revoke: 既に revoked な subkey は失敗する" 1 "$revoke_again_rc"
  check "revoke: 既に revoked のエラーメッセージ" 1 \
    "$(grep -qF '既に revoked' "$dir/revoke-again.err" && echo 1 || echo 0)"

  local revoke_missing_rc=0
  cmd_revoke --key "$fpr" --subkey "NOSUCHKEYID0000" >/dev/null 2>"$dir/revoke-missing.err" || revoke_missing_rc=$?
  check "revoke: 存在しない keyid は失敗する" 1 "$revoke_missing_rc"

  local revoke_card_rc=0
  GPG_BIN="$dir/bin/gpg-list-stub" GPG_SUBKEY_TEST_LIST_FILE="$dir/list-mixed-e.txt" \
    cmd_revoke --key "92E7B05978F0FE4E5500F6F76CFC837175BE257E" --subkey "CARDEEEEEEEEEEEE" \
    >/dev/null 2>"$dir/revoke-card.err" || revoke_card_rc=$?
  check "revoke: card-backed subkey は拒否する" 1 "$revoke_card_rc"
  check "revoke: card-backed 拒否のメッセージ" 1 \
    "$(grep -qF 'card-backed' "$dir/revoke-card.err" && echo 1 || echo 0)"

  # sync: `gh` and `curl` are stubbed — this must never touch a real GitHub
  # account or the real keys.openpgp.org, even by accident. keys/selftest.pub
  # is stale in two independent ways at this point: (a) [S] rotated after
  # the last export (github/keyserver-relevant), (b) the [E] subkeys didn't
  # exist yet at the last export at all (export/keyserver-relevant). GitHub
  # registration below deliberately references the OLD [S] key
  # ($first_keyid, already revoked) so github drift detection stays covered
  # exactly as it was before [E] support was added.
  mkdir -p "$dir/bin"
  local primary_short="${fpr: -16}"
  jq -n --arg k "$primary_short" --arg old "$first_keyid" \
    '[{id: 999, key_id: $k, subkeys: [{key_id: $old, can_sign: true, revoked: false}]}]' \
    >"$dir/gh-list.json"
  cat >"$dir/bin/gh" <<STUB
#!/usr/bin/env bash
all="\$*"
case "\$all" in
  *"-X DELETE"*) printf 'delete\n' >>"$dir/gh-calls.txt"; exit 0 ;;
  *"-X POST"*) printf 'post\n' >>"$dir/gh-calls.txt"; exit 0 ;;
  *"user/gpg_keys"*) cat "$dir/gh-list.json"; exit 0 ;;
esac
exit 1
STUB
  chmod +x "$dir/bin/gh"
  cat >"$dir/bin/curl" <<STUB
#!/usr/bin/env bash
out=""
prev=""
for a in "\$@"; do
  [[ "\$prev" == "-o" ]] && out="\$a"
  prev="\$a"
done
if [[ -n "\${GPG_SUBKEY_TEST_CURL_RESPONSE:-}" && -f "\${GPG_SUBKEY_TEST_CURL_RESPONSE:-}" ]]; then
  cp "\$GPG_SUBKEY_TEST_CURL_RESPONSE" "\$out"
  exit 0
fi
exit 22
STUB
  chmod +x "$dir/bin/curl"

  local sync_out sync_rc=0
  sync_out="$(PATH="$dir/bin:$PATH" cmd_sync --repo "$dir/repo" --identity selftest 2>&1)" || sync_rc=$?
  check "sync: drift があれば exit 1" 1 "$sync_rc"
  check "sync: github drift を報告する(旧 [S] key を stub 登録している)" 1 "$(grep -qF 'GitHub' <<<"$sync_out" && echo 1 || echo 0)"
  check "sync: keyserver drift で [S] を報告する" 1 \
    "$(grep -qF "現行 [S] subkey $second_keyid" <<<"$sync_out" && echo 1 || echo 0)"
  check "sync: keyserver drift で [E] も報告する(on-disk [E] が存在するため)" 1 \
    "$(grep -qF "現行 [E] subkey $e_second_keyid" <<<"$sync_out" && echo 1 || echo 0)"
  check "sync: export drift も報告する([E] 生成後の再 export が未反映)" 1 "$(grep -c 'keys/selftest.pub' <<<"$sync_out")"

  # --fix: neutralize keyserver drift via the curl stub (serve the current
  # export as the keyserver's "already published" response — covers both
  # [S] and [E] at once since a primary-key export always includes every
  # subkey) so only the stubbed github + export paths are exercised — this
  # run must never invoke the real `gpg --send-keys` against the real
  # network.
  "$GPG_BIN" --export "$fpr" >"$dir/keyserver-current.bin"
  rm -f "$dir/gh-calls.txt"
  local fix_rc=0
  GPG_SUBKEY_TEST_CURL_RESPONSE="$dir/keyserver-current.bin" \
    PATH="$dir/bin:$PATH" cmd_sync --repo "$dir/repo" --identity selftest --fix --yes \
    >"$dir/sync-fix.out" 2>&1 || fix_rc=$?
  check "sync --fix --yes: exit 0" 0 "$fix_rc"
  check "sync --fix: export を更新する" 1 "$(grep -qF 'keys/selftest.pub を更新しました' "$dir/sync-fix.out" && echo 1 || echo 0)"
  check "sync --fix: GitHub の delete を呼ぶ" 1 "$(grep -qF 'delete' "$dir/gh-calls.txt" 2>/dev/null && echo 1 || echo 0)"
  check "sync --fix: GitHub の post を呼ぶ" 1 "$(grep -qF 'post' "$dir/gh-calls.txt" 2>/dev/null && echo 1 || echo 0)"

  [[ $fail == 0 ]] && printf 'selftest: all passed\n'
  return "$fail"
}

main() {
  local mode="${1:-}"
  case "$mode" in
    generate)
      shift
      cmd_generate "$@"
      ;;
    rotate)
      shift
      cmd_rotate "$@"
      ;;
    revoke)
      shift
      cmd_revoke "$@"
      ;;
    export)
      shift
      cmd_export "$@"
      ;;
    sync)
      shift
      cmd_sync "$@"
      ;;
    status)
      shift
      cmd_status "$@"
      ;;
    remind)
      shift
      cmd_remind "$@"
      ;;
    --selftest) selftest ;;
    -h | --help | '')
      usage
      [[ $mode == -h || $mode == --help ]]
      ;;
    *)
      printf 'gpg-subkey: 不明なコマンド %s\n' "$mode" >&2
      usage >&2
      return 2
      ;;
  esac
}

main "$@"

# Local environment specific directory
# This directory stores local-specific settings and backups
# that should not be carried over to other environments
local/

# Editor temporary files
# Exclude temporary files and backup files created by various editors
*.swp
*.swo
*~
.*.swp
\#*\#
.\#*

# Zsh compiled files
# Auto-generated by zsh for performance optimization
*.zwc

# Nix build artifacts
# `nix build` result symlinks should not be tracked
result
result-*

# Files that may contain sensitive information
# Safety measure to prevent accidental commits
*.pem
*.key
*.secret
credentials
secrets/
*.cert
*.crt
*.pfx
*.p12
*password*
*token*
*api_key*
*apikey*
*private*
.env
.env.*
local/**/*key*
local/**/*secret*
local/**/*password*
local/**/*token*
local/**/*credential*

# Temporary log files
# Temporary output from script execution
*.log
*.tmp
packages/generation.log

# Company-provided proprietary installers
*.deb

# Generated package lists
# These files are automatically generated by scripts and should not be tracked
packages/generated/
packages/*.txt
# But allow declarative files to be tracked (they define what SHOULD be installed)
!packages/declarative/

# Python virtual environment (potential future use)
venv/
.venv/
__pycache__/

# Backup files and directories
# Backups created by various tools should NOT be stored in git repository
# Use external database management systems for backup storage
*.bak
*.backup
*.old
backup/
backup_*/
*backup/
*backup_*
snapshots/
rollback-*.sh

# Local experimental files
# Used for testing and prototyping
test/
scratch/
tmp/
*.backup-*
config/zsh/.zsh_history

# zsh completion cache
# Auto-generated completion cache files that vary between environments
.zcompdump*

# Work memo files and temporary documentation
# These should not be committed to the repository
*進捗*.md
*要約*.md
*memo*.md
*作業*.md
mailFilters.txt
*gmail*

# Machine-local Git configuration
# Generated by machine subkey system, contains machine-specific signing keys
config/git/config.local

# SSH host configurations
# Actual SSH host configurations should not be committed (may contain sensitive info)
config/auth/ssh/config.d/*.conf
local/auth/ssh/hosts/

# SOPS encrypted secrets
# SOPS configuration and encrypted secrets should remain local
# The encryption is tied to personal GPG keys
.sops.yaml
*.sops.yaml
secrets.yaml
secrets*.yaml
*.secrets.yaml

# Coding-agent local state
# Tool-local settings/caches (Devin, Claude Code) are machine-specific and must
# never be committed — they are not part of the declarative environment.
.devin/
.claude/

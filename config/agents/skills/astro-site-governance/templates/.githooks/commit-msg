#!/usr/bin/env sh
# .githooks/commit-msg — Enforce Conventional Commits via cocogitto (cog verify).
# Installed by: git config --local core.hooksPath .githooks
set -eu

if ! command -v cog >/dev/null 2>&1; then
  echo "──────────────────────────────────────────────────"
  echo "  ERROR: 'cog' (cocogitto) not found on PATH."
  echo "  Install with: mise install"
  echo "  Or: cargo install cocogitto"
  echo "──────────────────────────────────────────────────"
  exit 1
fi

if ! cog verify "$1" >/dev/null 2>&1; then
  cog verify "$1" 2>&1 || true
  echo ""
  echo "──────────────────────────────────────────────────"
  echo "  COMMIT REJECTED — message does not follow"
  echo "  Conventional Commits format."
  echo ""
  echo "  Examples:"
  echo "    feat(topics): add 1-1 analog modulation"
  echo "    fix(topics): correct Friis formula in 6-1"
  echo "    feat(components): add Smith chart component"
  echo "    ci: pin Node.js to 22 in deploy workflow"
  echo "    chore(deps): update astro to v5.1.0"
  echo "──────────────────────────────────────────────────"
  exit 1
fi

#!/usr/bin/env bash
# pipeline-node: git-pre-commit
set -euo pipefail

# Protected-branch guard: block a direct commit onto main/master. herdr
# provisions a fresh worktree per task, so a commit landing on main/master
# usually means the wrong pane/cwd was used — the commit is real and easy to
# miss until it is already ahead of origin. Detached HEAD (symbolic-ref
# fails) is not a branch commit, so it is let through untouched.
#
# --no-verify is deliberately NOT the escape hatch here: it would also skip
# the chained repo-local pre-commit below (ruff/mypy/etc. in other repos).
# Use GIT_ALLOW_MAIN_COMMIT=1 to bypass only this guard and still run the
# chain.
branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
case "$branch" in
    main | master)
        if [[ "${GIT_ALLOW_MAIN_COMMIT:-0}" != 1 ]]; then
            echo "error: Direct commit blocked on branch '${branch}'" >&2
            echo "" >&2
            echo "  main/master is meant to move by merge (PR), not by direct commit." >&2
            echo "  If this is intentional (e.g. main is a solo scratch repo)," >&2
            echo "  set GIT_ALLOW_MAIN_COMMIT=1 for this commit:" >&2
            echo "" >&2
            echo "    GIT_ALLOW_MAIN_COMMIT=1 git commit ..." >&2
            echo "" >&2
            echo "  (--no-verify also works but skips every other pre-commit check" >&2
            echo "   this repo has chained, not just this guard.)" >&2
            exit 1
        fi
        ;;
esac

# bleep scan of the staged added lines (#947, #949): stop a private repository
# name at commit time, before the editor opens. The worker is the commit-msg
# hook in this same directory (`commit-msg --staged`; it also scans the message
# when git runs it as commit-msg). No worker next to this hook, or no bleep, is
# skipped silently (ADR-0005). The chained repo-local pre-commit below still
# runs when this passes.
bleep_worker="$(dirname "$0")/commit-msg"
if [[ -x "$bleep_worker" ]]; then
    "$bleep_worker" --staged || exit 1
fi

# core.hooksPath makes git ignore .git/hooks/ entirely, including in linked
# worktrees (where the working tree's own .git is a file, not a directory).
# Chain to the repo-local pre-commit hook if one is installed, resolving it
# via --git-common-dir so this works from any linked worktree, not just the
# main checkout. Mirrors the existing pre-push chain in this same directory.
common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)

local_hook="${common_dir}/hooks/pre-commit"
if [[ -x "$local_hook" ]]; then
    exec "$local_hook" "$@"
fi

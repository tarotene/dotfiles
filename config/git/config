# Global Git Configuration

[core]
    hooksPath = ~/.config/git/hooks

[init]
    defaultBranch = main

[commit]
	gpgsign = true

[tag] 
    gpgsign = true

[sequence]
    editor = interactive-rebase-tool

[alias]
    prune-branches = "!f() { git fetch -p && git for-each-ref --merged=main --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\" {print $1}' | while IFS= read -r branch; do git branch -d -- \"$branch\"; done; }; f"

# GitHub Authentication
[credential "https://github.com"]
    helper = 
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper = 
    helper = !gh auth git-credential

# User configuration - Set in ~/.config/git/config.local
# Example content for config.local:
# [user]
#     name = Your Name
#     email = your.email@example.com
#     signingkey = YOUR_GPG_KEY_ID

# Machine-local configuration
[include]
    path = ~/.config/git/config.local

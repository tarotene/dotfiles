{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(chore)",
    ":timezone(Asia/Tokyo)"
  ],
  "constraints": {
    "rust": "__MSRV_FULL__"
  },
  "schedule": ["before 6am on monday"],
  "commitMessagePrefix": "chore(deps):",
  "rangeStrategy": "auto",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "cargo": {
    "enabled": true,
    "managerFilePatterns": [
      "/Cargo\\.toml$/",
      "/tools/__CLI_CRATE__/Cargo\\.toml$/"
    ]
  },
  "github-actions": {
    "enabled": true,
    "pinDigests": true,
    "managerFilePatterns": ["/\\.github/workflows/[^/]+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "probe-rs: pinned to 0.31.x; surface minor/major bumps on Dependency Dashboard for manual re-evaluation",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["probe-rs"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "probe-rs: allow patch updates synced across all manifests",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["probe-rs"],
      "matchUpdateTypes": ["patch"],
      "groupName": "probe-rs (synchronized)"
    },
    {
      "description": "Embedded HAL: separate minor from patch for careful review; firmware smoke test required. ADJUST: update package list to match your embedded dependencies.",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "embassy-executor",
        "embassy-nrf",
        "embassy-time",
        "embassy-sync",
        "embassy-futures",
        "embassy-hal-internal",
        "nrf-pac",
        "cortex-m",
        "cortex-m-rt",
        "rtt-target",
        "panic-halt"
      ],
      "separateMinorPatch": true,
      "groupName": "embedded HAL",
      "labels": ["dependencies", "firmware", "needs-smoke-test"]
    },
    {
      "description": "Wire protocol / serialization deps. ADJUST: update package list to match your core protocol dependencies.",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "serde",
        "postcard",
        "postcard-schema",
        "heapless",
        "linkme",
        "cobs"
      ],
      "groupName": "wire protocol deps"
    },
    {
      "description": "Proc-macro toolchain",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["syn", "quote", "proc-macro2"],
      "groupName": "proc-macro toolchain"
    },
    {
      "description": "Host CLI deps: separate minor from patch. ADJUST: update package list to match your CLI crate's dependencies.",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "clap",
        "rustyline",
        "tokio",
        "tracing",
        "tracing-subscriber",
        "rmcp",
        "serde_json",
        "thiserror",
        "anyhow",
        "nix"
      ],
      "separateMinorPatch": true
    },
    {
      "description": "GitHub Actions: group all action upgrades into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "labels": ["dependencies", "ci"]
    },
    {
      "description": "Do not let Renovate auto-bump constraints.rust — it is the MSRV pin and must change only via a deliberate feat(toolchain)! MSRV bump. Renovate resolves it via the docker datasource ('rust' image) which is unrelated to this repo's build.",
      "matchManagers": ["renovate-config"],
      "matchDepNames": ["rust"],
      "enabled": false
    }
  ]
}

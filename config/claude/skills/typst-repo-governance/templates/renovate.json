{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 3,
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Group all GitHub Actions updates into one PR per week",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "schedule": ["before 9am on monday"],
      "automerge": false
    },
    {
      "description": "Group Typst compiler and setup-typst action together",
      "matchPackageNames": ["typst/typst", "typst-community/setup-typst"],
      "groupName": "Typst toolchain",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "description": "Track the Typst version pinned via setup-typst's typst-version input. Annotate the line with '# renovate: datasource=github-releases depName=typst/typst' to enable tracking.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+typst-version:\\s*['\"]?(?<currentValue>[\\w.+-]+)['\"]?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "typst/typst",
      "versioningTemplate": "semver"
    }
  ]
}

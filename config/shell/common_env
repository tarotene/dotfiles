#!/bin/sh
# POSIX-compliant common environment variable settings
# Basic configuration loaded by all shells

# XDG Base Directory specification compliance
[ -z "$XDG_CONFIG_HOME" ] && export XDG_CONFIG_HOME="$HOME/.config"
[ -z "$XDG_DATA_HOME" ] && export XDG_DATA_HOME="$HOME/.local/share"
[ -z "$XDG_STATE_HOME" ] && export XDG_STATE_HOME="$HOME/.local/state"
[ -z "$XDG_CACHE_HOME" ] && export XDG_CACHE_HOME="$HOME/.cache"

# Ad-hoc installer paths (ADR-0029).
#
# These are appended, never prepended.  home-manager is the source of truth
# for the user environment (ADR-0001), and PATH order is what actually
# enforces that: ~/.nix-profile/bin enters PATH at /etc/profile.d/nix.sh time,
# so *any* user-level prepend lands in front of it and silently wins.  That is
# how a cargo-installed alacritty 0.15.1 shadowed the declared 0.17.0-nixgl,
# and a deno installed by its own installer still shadows the declared one.
#
# Appending is free here: none of these three directories has a single name in
# common with /usr/bin, /usr/local/bin or /bin, so nothing system-level can
# shadow them in turn.  They keep working; they just stop outranking nix.
#
# Cargo path (Rust uses default location; also ADR-0025's registry of
# self-authored pre-release CLIs, which have no nixpkgs counterpart at all).
if [ -d "$HOME/.cargo/bin" ]; then
    case ":$PATH:" in
        *":$HOME/.cargo/bin:"*) ;;
        *) export PATH="$PATH:$HOME/.cargo/bin" ;;
    esac
fi

# Deno path
if [ -d "$HOME/.deno/bin" ]; then
    case ":$PATH:" in
        *":$HOME/.deno/bin:"*) ;;
        *) export PATH="$PATH:$HOME/.deno/bin" ;;
    esac
fi

# Bun path
if [ -d "$HOME/.bun/bin" ]; then
    case ":$PATH:" in
        *":$HOME/.bun/bin:"*) ;;
        *) export PATH="$PATH:$HOME/.bun/bin" ;;
    esac
fi

# Locale settings: default LANG only when unset. Never export LC_ALL — it
# force-overrides every LC_* category (including the session-level LC_CTYPE
# from environment.d) and cannot be selectively undone downstream.
if [ -z "$LANG" ]; then
    if locale -a 2>/dev/null | grep -qE '^en_US\.(UTF-8|utf8)$'; then
        # Use system's preferred UTF-8 variant
        _locale=$(locale -a 2>/dev/null | grep -E '^en_US\.(UTF-8|utf8)$' | head -1)
        export LANG="$_locale"
        unset _locale
    else
        # Fallback to C.UTF-8/C.utf8, then plain POSIX C
        _locale=$(locale -a 2>/dev/null | grep -E '^C\.(UTF-8|utf8)$' | head -1)
        export LANG="${_locale:-C}"
        unset _locale
    fi
fi

# Java and Go are consolidated into mise (#215 / ADR-0002); SDKMAN! and goup
# were retired. mise manages their versions and shims via its shell hook.

# Colors for script output
export COLOR_RED='\033[0;31m'
export COLOR_GREEN='\033[0;32m'
export COLOR_YELLOW='\033[1;33m'
export COLOR_BLUE='\033[0;34m'
export COLOR_CYAN='\033[0;36m'
export COLOR_MAGENTA='\033[0;35m'
export COLOR_NC='\033[0m' # No Color

# Default editor
[ -z "$EDITOR" ] && export EDITOR="vim"
[ -z "$VISUAL" ] && export VISUAL="$EDITOR"

# Non-blocking opener (scripts/detach-open.sh, deployed as ~/.local/bin/open).
# gh browse etc. wait for $BROWSER to exit; the system xdg-open blocks in the
# foreground on COSMIC. Linux-only shim (home/modules/packages.nix guards its
# deployment the same way) — macOS's own /usr/bin/open already returns
# immediately, so darwin uses it directly instead of a nonexistent shim path.
if [ -z "$BROWSER" ]; then
    if [ "$(uname -s)" = "Darwin" ]; then
        export BROWSER="/usr/bin/open"
    else
        export BROWSER="$HOME/.local/bin/open"
    fi
fi
